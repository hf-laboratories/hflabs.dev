{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline Composer Pipeline",
  "description": "Interoperability schema for the WebUI PipelineComposer (pipeline -> stages with depends[]). Used as interchange format between WebUI and AMLApp3.",
  "type": "object",
  "required": ["id", "name", "stages"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "tags": { "type": ["array", "null"], "items": { "type": "string" } },
    "created": { "type": ["string", "null"], "format": "date-time" },
    "modified": { "type": ["string", "null"], "format": "date-time" },
    "version": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": ["string", "null"], "description": "Optional stage kind (tool/type name)." },
          "depends": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "options": { "type": ["object", "null"], "additionalProperties": true },
          "position": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "required": ["x", "y"]
          }
        }
      }
    }
  }
}
