{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Object Store Contracts",
  "description": "Schema for WebUI object store endpoints (buckets, objects, metadata, presigned URLs)",
  "type": "object",
  "properties": {
    "Bucket": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "ObjectItem": {
      "type": "object",
      "required": ["key", "size"],
      "properties": {
        "key": { "type": "string" },
        "size": { "type": "integer" },
        "lastModified": { "type": ["string", "null"], "format": "date-time" },
        "storageClass": { "type": ["string", "null"] }
      }
    },
    "ObjectMetadata": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "eTag": { "type": ["string", "null"] },
        "size": { "type": "integer" },
        "contentType": { "type": ["string", "null"] },
        "lastModified": { "type": ["string", "null"], "format": "date-time" },
        "extra": { "type": ["object", "null"], "additionalProperties": { "type": "string" } }
      }
    },
    "PresignGetResponse": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string", "format": "uri" } }
    }
  }
}
