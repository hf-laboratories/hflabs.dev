{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/swarm_benchmark_manifest_schema.1.0.0.json",
  "title": "Swarm Benchmark Coverage Manifest",
  "type": "object",
  "required": ["version", "generatedAt", "schema", "algorithms", "features"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "schema": { "type": "string" },
    "algorithms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "methodDepth", "actorDepth"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "methodDepth": { "type": "integer", "minimum": 0 },
          "actorDepth": { "type": "integer", "minimum": 0 },
          "benchmarksCovered": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "classes": { "type": "array", "items": { "type": "string" } },
          "modalityGroups": { "type": "array", "items": { "type": "string" } },
          "compatibility": { "type": "array", "items": { "type": "string" } },
          "coverageStatus": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
