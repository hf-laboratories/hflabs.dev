{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Lifecycle Workflows (Catalog Wrapper)",
  "description": "DEPRECATED: Prefer model_lifecycle_workflow_schema.json for a single workflow definition. This file describes a catalog of named workflows and global settings.",
  "type": "object",
  "properties": {
    "deprecated": { "type": "boolean", "const": true, "default": true },
    "workflows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/workflow_entry" }
    },
    "global_settings": {
      "type": "object",
      "properties": {
        "default_timeouts": {
          "type": "object",
          "properties": {
            "approval_timeout": { "type": "string" },
            "automatic_step_timeout": { "type": "string" },
            "manual_step_timeout": { "type": "string" }
          }
        },
        "notification_settings": {
          "type": "object",
          "properties": {
            "email_enabled": { "type": "boolean" },
            "slack_enabled": { "type": "boolean" },
            "sms_enabled": { "type": "boolean" },
            "notification_channels": { "type": "array", "items": { "type": "string" } }
          }
        },
        "audit_settings": {
          "type": "object",
          "properties": {
            "log_all_workflow_steps": { "type": "boolean" },
            "retain_audit_logs_days": { "type": "integer" },
            "enable_workflow_metrics": { "type": "boolean" }
          }
        },
        "retry_policies": {
          "type": "object",
          "properties": {
            "max_retries": { "type": "integer" },
            "retry_delay": { "type": "string" },
            "exponential_backoff": { "type": "boolean" }
          }
        }
      }
    }
  },
  "definitions": {
    "workflow_entry": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "enabled": { "type": "boolean" },
        "trigger": {
          "type": "object",
          "properties": {
            "event": { "type": "string" },
            "conditions": { "type": "array", "items": { "type": ["string", "object"] } }
          }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflow_step" }
        },
        "completion_criteria": { "type": "array", "items": { "type": "string" } },
        "rollback_strategy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "steps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "parallel_execution": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "parallel_steps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "escalation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "rules": { "type": "array", "items": { "type": "object" } }
          }
        },
        "approval_gates": { "type": "array", "items": { "type": "object" } }
      }
    },
    "workflow_step": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "timeout": { "type": "string" },
        "actions": { "type": "array", "items": { "type": ["string", "object"] } },
        "success_criteria": { "type": "array", "items": { "type": ["string", "object"] } },
        "failure_action": { "type": "string" },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "required_approvals": { "type": "integer" },
        "conditions": { "type": "array", "items": { "type": "object" } },
        "monitoring": { "type": "object" },
        "schedule": { "type": "object" },
        "assignees": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
