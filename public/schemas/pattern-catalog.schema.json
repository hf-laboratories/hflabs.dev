{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pattern Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "detectorVersion", "patterns", "issues"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the detector produced this catalog"
    },
    "detectorVersion": {
      "type": "string",
      "description": "Semantic version of the detector or script"
    },
    "patterns": {
      "type": "array",
      "description": "Detected pattern entries",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patternId",
          "area",
          "description",
          "files",
          "detectors",
          "confidence",
          "lastSeen",
          "owner",
          "exchangeStatus"
        ],
        "properties": {
          "patternId": {
            "type": "string",
            "pattern": "^PAT-[A-Z]+-[0-9]{3}$"
          },
          "area": {
            "type": "string",
            "enum": [
              "CoreServices",
              "PowerShell",
              "Native",
              "Web",
              "Docs"
            ]
          },
          "description": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Relative path to evidence file"
            }
          },
          "detectors": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Detector or rule identifier"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "type": "string"
          },
          "exchangeStatus": {
            "type": "string",
            "enum": ["candidate", "active", "deprecated", "retired"]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "Finder alerts when drift or missing coverage occurs",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "files"],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "summary": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "patternsImpacted": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^PAT-[A-Z]+-[0-9]{3}$"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional detector-specific metadata",
      "additionalProperties": true
    }
  }
}
