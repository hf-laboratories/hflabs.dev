{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ipuservices.io/schemas/cluster-orchestration-plan.schema.json",
  "title": "IPUServices Cluster Orchestration Plan",
  "description": "A high-granularity plan describing desired placements, data movements, prefetching, and scheduling constraints across CPU/GPU/IPU/RDMA/NVMe/PTP domains.",
  "type": "object",
  "required": ["$schema", "planId", "topologyRef", "epochs"],
  "properties": {
    "$schema": { "type": "string" },
    "planId": { "type": "string" },
    "topologyRef": {
      "type": "object",
      "required": ["schema", "hash"],
      "properties": {
        "schema": { "type": "string", "enum": ["cluster-orchestration-topology.schema.json"] },
        "hash": { "type": "string", "description": "Caller-supplied hash/fingerprint of the topology document used to build the plan." }
      }
    },
    "createdUtc": { "type": "string", "format": "date-time" },
    "epochs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/epoch" }
    }
  },
  "definitions": {
    "epoch": {
      "type": "object",
      "description": "One scheduling epoch: a set of actions intended to be applied with minimal downtime, possibly concurrently where safe.",
      "required": ["id", "actions"],
      "properties": {
        "id": { "type": "string" },
        "deadlineMs": { "type": "integer", "minimum": 0 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "reserve",
            "pin-cpu",
            "allocate-memory",
            "stage-from-nvme",
            "rdma-transfer",
            "pcie-transfer",
            "warmup-kernels",
            "switch-routing",
            "start-work",
            "stop-work",
            "ptp-check",
            "barrier"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Action ids that must complete successfully before this action starts."
        },
        "timeoutMs": { "type": "integer", "minimum": 0 },
        "target": { "$ref": "#/definitions/target" },
        "parameters": { "type": "object", "additionalProperties": true }
      }
    },
    "target": {
      "type": "object",
      "description": "Refers to a node, and optionally a domain and specific device/port.",
      "required": ["nodeId"],
      "properties": {
        "nodeId": { "type": "string" },
        "domainId": { "type": "string" },
        "device": { "type": "string" },
        "port": { "type": "string" }
      }
    }
  }
}
