{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Schemas/swarm_hypercache_self_test_catalog_manifest_schema.1.0.0.json",
  "title": "HyperCache Self-Test Catalog Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "generatedAtUtc",
    "generator",
    "modeId",
    "schemas",
    "sourceRoots",
    "documents",
    "dataFiles",
    "counts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "datasetId": {
      "type": "string",
      "enum": ["hyperswarm-self-test", "hyperswarm-document-catalog"]
    },
    "datasetVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "modeId": {
      "type": "string",
      "enum": ["mode:2", "mode:3"]
    },
    "schemas": {
      "type": "object",
      "required": ["manifest", "entity", "relation", "observation"],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "sourceRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentDescriptor"
      }
    },
    "dataFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataFileDescriptor"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactDescriptor"
      }
    },
    "counts": {
      "type": "object",
      "required": ["entities", "relations", "observations"],
      "properties": {
        "entities": {
          "type": "integer",
          "minimum": 0
        },
        "relations": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "documentDescriptor": {
      "type": "object",
      "required": ["id", "path", "entityKind", "primaryKey", "title", "sortOrder"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "entityKind": {
          "type": "string",
          "minLength": 1
        },
        "primaryKey": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "dataFileDescriptor": {
      "type": "object",
      "required": ["id", "path", "documentType", "format", "schema", "primaryKey", "rowCount", "sortOrder"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "primaryKey": {
          "type": "string",
          "minLength": 1
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "artifactDescriptor": {
      "type": "object",
      "required": ["id", "path", "format", "sortOrder"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer"
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "edgeCount": {
          "type": "integer",
          "minimum": 0
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}