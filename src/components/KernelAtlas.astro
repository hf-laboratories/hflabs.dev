---
// src/components/KernelAtlas.astro
import { KERNEL_ATLAS, KERNEL_CATEGORIES } from '../data/kernelAtlas';
---

<section class="kernel-atlas-section" id="kernel-atlas">
  <div class="atlas-container">
    <!-- Header Bar matching screenshot -->
    <div class="atlas-header">
      <div class="atlas-title-block">
        <div class="atlas-badge-row">
          <span class="atlas-status-badge">HW-Accelerated SPIR-V</span>
          <span class="atlas-status-badge">Intel Level Zero Driver</span>
        </div>
        <h2 class="atlas-main-heading">LEVEL ZERO KERNEL ATLAS</h2>
        <p class="atlas-sub-heading">
          <strong>38 verified compute kernels</strong> &mdash; LevelZero.NET / LevelZero.Kernels (HFLabs)
        </p>
      </div>

      <!-- Controls & Search -->
      <div class="atlas-controls">
        <div class="atlas-search-box">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="atlasSearchInput" 
            placeholder="Search 38 kernels, signatures, or operations..." 
            aria-label="Filter kernel atlas"
          />
          <button id="clearAtlasSearch" class="clear-search-btn" title="Clear search" style="display:none;">&times;</button>
        </div>
      </div>
    </div>

    <!-- Category Legend / Filter Pills matching screenshot colors -->
    <div class="atlas-legend-bar">
      <button class="legend-pill active" data-filter="all">
        <span class="pill-dot all-dot"></span>
        <span class="pill-text">ALL KERNELS</span>
        <span class="pill-count">38</span>
      </button>

      <button class="legend-pill" data-filter="swarm">
        <span class="pill-dot" style="background:#10b981; box-shadow:0 0 8px #10b981;"></span>
        <span class="pill-text">SWARM / OPTIMIZATION</span>
        <span class="pill-count">15</span>
      </button>

      <button class="legend-pill" data-filter="llm">
        <span class="pill-dot" style="background:#38bdf8; box-shadow:0 0 8px #38bdf8;"></span>
        <span class="pill-text">LLM INFERENCE</span>
        <span class="pill-count">15</span>
      </button>

      <button class="legend-pill" data-filter="snn">
        <span class="pill-dot" style="background:#f43f5e; box-shadow:0 0 8px #f43f5e;"></span>
        <span class="pill-text">SPIKING / SNN</span>
        <span class="pill-count">3</span>
      </button>

      <button class="legend-pill" data-filter="ranker">
        <span class="pill-dot" style="background:#f59e0b; box-shadow:0 0 8px #f59e0b;"></span>
        <span class="pill-text">RANKER / RAG / CHAINBOOST</span>
        <span class="pill-count">5</span>
      </button>
    </div>

    <!-- Tiles Grid Canvas -->
    <div class="atlas-tiles-grid" id="atlasTilesGrid">
      {KERNEL_ATLAS.map((tile, index) => (
        <div 
          class={`atlas-tile-card tile-category-${tile.categoryKey}`}
          data-category={tile.categoryKey}
          data-kernel-id={tile.id}
          data-search={`${tile.name} ${tile.category} ${tile.sourceFile} ${tile.kernelName} ${tile.signature} ${tile.description}`.toLowerCase()}
          style={`--tile-color:${tile.color}; --tile-glow:${tile.glowColor};`}
        >
          <!-- Outer Bracket Accents -->
          <div class="tile-bracket tl"></div>
          <div class="tile-bracket tr"></div>
          <div class="tile-bracket bl"></div>
          <div class="tile-bracket br"></div>

          <!-- Header Tag -->
          <div class="tile-tag-header">
            <span class="tile-tag-text">{tile.category}</span>
            <span class="tile-idx">#{String(index + 1).padStart(2, '0')}</span>
          </div>

          <!-- Central Visual Display Screen -->
          <div class="tile-visual-screen">
            <svg class="tile-screen-svg" viewBox="0 0 160 120" preserveAspectRatio="xMidYMid meet">
              <!-- Background Fine Coordinate Grid -->
              <defs>
                <pattern id={`grid-${tile.id}`} width="16" height="16" patternUnits="userSpaceOnUse">
                  <path d="M 16 0 L 0 0 0 16" fill="none" stroke={tile.color} stroke-opacity="0.1" stroke-width="0.75"/>
                </pattern>
                <radialGradient id={`glow-${tile.id}`} cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color={tile.color} stop-opacity="0.25" />
                  <stop offset="100%" stop-color={tile.color} stop-opacity="0" />
                </radialGradient>
              </defs>

              <rect width="160" height="120" fill={`url(#grid-${tile.id})`} />
              <rect width="160" height="120" fill={`url(#glow-${tile.id})`} />

              <!-- Visualization Switch by Domain -->
              {tile.visualType === "radar" && (
                <g class="visual-radar-group">
                  <!-- Concentric polar radar circles -->
                  <circle cx="80" cy="60" r="46" fill="none" stroke={tile.color} stroke-opacity="0.18" stroke-dasharray="3,3" />
                  <circle cx="80" cy="60" r="32" fill="none" stroke={tile.color} stroke-opacity="0.3" />
                  <circle cx="80" cy="60" r="16" fill="none" stroke={tile.color} stroke-opacity="0.4" />
                  <!-- Crosshairs -->
                  <line x1="80" y1="12" x2="80" y2="108" stroke={tile.color} stroke-opacity="0.2" stroke-width="0.8" />
                  <line x1="32" y1="60" x2="128" y2="60" stroke={tile.color} stroke-opacity="0.2" stroke-width="0.8" />
                  
                  <!-- Dynamic Constellation Nodes & Edges -->
                  <polygon 
                    points="80,32 108,48 98,82 62,82 52,48" 
                    fill={tile.color} 
                    fill-opacity="0.08" 
                    stroke={tile.color} 
                    stroke-opacity="0.6" 
                    stroke-width="1.2" 
                  />
                  <line x1="80" y1="60" x2="80" y2="32" stroke={tile.color} stroke-opacity="0.7" stroke-width="1" />
                  <line x1="80" y1="60" x2="108" y2="48" stroke={tile.color} stroke-opacity="0.7" stroke-width="1" />
                  <line x1="80" y1="60" x2="98" y2="82" stroke={tile.color} stroke-opacity="0.7" stroke-width="1" />
                  <line x1="80" y1="60" x2="62" y2="82" stroke={tile.color} stroke-opacity="0.7" stroke-width="1" />
                  <line x1="80" y1="60" x2="52" y2="48" stroke={tile.color} stroke-opacity="0.7" stroke-width="1" />

                  <!-- Central Anchor & Orbit Nodes -->
                  <circle cx="80" cy="60" r="3.5" fill="#fff" stroke={tile.color} stroke-width="1.5" />
                  <circle cx="80" cy="32" r="2.5" fill={tile.color} />
                  <circle cx="108" cy="48" r="2.5" fill={tile.color} />
                  <circle cx="98" cy="82" r="2.5" fill={tile.color} />
                  <circle cx="62" cy="82" r="2.5" fill={tile.color} />
                  <circle cx="52" cy="48" r="2.5" fill={tile.color} />
                </g>
              )}

              {tile.visualType === "matrix" && (
                <g class="visual-matrix-group">
                  <!-- Tensor memory grid wireframe -->
                  <rect x="36" y="24" width="88" height="72" fill="none" stroke={tile.color} stroke-opacity="0.5" stroke-width="1.2" rx="2" />
                  <!-- Grid lines -->
                  <line x1="58" y1="24" x2="58" y2="96" stroke={tile.color} stroke-opacity="0.25" stroke-width="0.8" />
                  <line x1="80" y1="24" x2="80" y2="96" stroke={tile.color} stroke-opacity="0.4" stroke-width="1" />
                  <line x1="102" y1="24" x2="102" y2="96" stroke={tile.color} stroke-opacity="0.25" stroke-width="0.8" />
                  <line x1="36" y1="48" x2="124" y2="48" stroke={tile.color} stroke-opacity="0.25" stroke-width="0.8" />
                  <line x1="36" y1="72" x2="124" y2="72" stroke={tile.color} stroke-opacity="0.25" stroke-width="0.8" />

                  <!-- Active Attention / Tile Block Highlights -->
                  <rect x="58" y="48" width="22" height="24" fill={tile.color} fill-opacity="0.35" stroke={tile.color} stroke-width="1.2" />
                  <rect x="80" y="24" width="22" height="24" fill={tile.color} fill-opacity="0.18" />
                  <rect x="36" y="72" width="22" height="24" fill={tile.color} fill-opacity="0.15" />
                  <rect x="102" y="48" width="22" height="24" fill={tile.color} fill-opacity="0.2" />

                  <!-- Axis tick markings -->
                  <circle cx="58" cy="48" r="1.5" fill="#fff" />
                  <circle cx="80" cy="72" r="1.5" fill="#fff" />
                  <line x1="30" y1="60" x2="33" y2="60" stroke={tile.color} stroke-width="1.5" />
                  <line x1="80" y1="18" x2="80" y2="21" stroke={tile.color} stroke-width="1.5" />
                </g>
              )}

              {tile.visualType === "spikes" && (
                <g class="visual-spikes-group">
                  <!-- 5 Spike train channels -->
                  <line x1="28" y1="30" x2="132" y2="30" stroke={tile.color} stroke-opacity="0.2" stroke-width="1" />
                  <line x1="28" y1="45" x2="132" y2="45" stroke={tile.color} stroke-opacity="0.2" stroke-width="1" />
                  <line x1="28" y1="60" x2="132" y2="60" stroke={tile.color} stroke-opacity="0.35" stroke-width="1" />
                  <line x1="28" y1="75" x2="132" y2="75" stroke={tile.color} stroke-opacity="0.2" stroke-width="1" />
                  <line x1="28" y1="90" x2="132" y2="90" stroke={tile.color} stroke-opacity="0.2" stroke-width="1" />

                  <!-- Vertical Neural Spike Ticks -->
                  <!-- Ch 0 -->
                  <line x1="42" y1="24" x2="42" y2="36" stroke={tile.color} stroke-width="1.8" />
                  <line x1="68" y1="24" x2="68" y2="36" stroke={tile.color} stroke-width="1.8" />
                  <line x1="104" y1="24" x2="104" y2="36" stroke={tile.color} stroke-width="1.8" />
                  <!-- Ch 1 -->
                  <line x1="52" y1="39" x2="52" y2="51" stroke={tile.color} stroke-width="1.8" />
                  <line x1="86" y1="39" x2="86" y2="51" stroke={tile.color} stroke-width="1.8" />
                  <line x1="118" y1="39" x2="118" y2="51" stroke={tile.color} stroke-width="1.8" />
                  <!-- Ch 2 (Synchronized) -->
                  <line x1="42" y1="54" x2="42" y2="66" stroke="#fff" stroke-width="2" />
                  <line x1="76" y1="54" x2="76" y2="66" stroke={tile.color} stroke-width="1.8" />
                  <line x1="104" y1="54" x2="104" y2="66" stroke="#fff" stroke-width="2" />
                  <!-- Ch 3 -->
                  <line x1="60" y1="69" x2="60" y2="81" stroke={tile.color} stroke-width="1.8" />
                  <line x1="94" y1="69" x2="94" y2="81" stroke={tile.color} stroke-width="1.8" />
                  <!-- Ch 4 -->
                  <line x1="42" y1="84" x2="42" y2="96" stroke={tile.color} stroke-width="1.8" />
                  <line x1="82" y1="84" x2="82" y2="96" stroke={tile.color} stroke-width="1.8" />
                  <line x1="112" y1="84" x2="112" y2="96" stroke={tile.color} stroke-width="1.8" />

                  <!-- Temporal Synchrony Indicator -->
                  <line x1="42" y1="20" x2="42" y2="100" stroke={tile.color} stroke-opacity="0.35" stroke-dasharray="2,2" stroke-width="1" />
                  <line x1="104" y1="20" x2="104" y2="100" stroke={tile.color} stroke-opacity="0.35" stroke-dasharray="2,2" stroke-width="1" />
                </g>
              )}

              {tile.visualType === "hypergraph" && (
                <g class="visual-hypergraph-group">
                  <!-- Outer bounding hyperedge convex hull -->
                  <polygon 
                    points="80,24 126,48 116,92 44,92 34,48" 
                    fill={tile.color} 
                    fill-opacity="0.07" 
                    stroke={tile.color} 
                    stroke-opacity="0.4" 
                    stroke-width="1" 
                    stroke-dasharray="4,3"
                  />
                  <!-- Central query/hub entity -->
                  <circle cx="80" cy="58" r="4.5" fill="#fff" stroke={tile.color} stroke-width="2" />

                  <!-- Radiant edges to candidate nodes -->
                  <line x1="80" y1="58" x2="80" y2="28" stroke={tile.color} stroke-opacity="0.75" stroke-width="1.5" />
                  <line x1="80" y1="58" x2="120" y2="44" stroke={tile.color} stroke-opacity="0.75" stroke-width="1.5" />
                  <line x1="80" y1="58" x2="112" y2="86" stroke={tile.color} stroke-opacity="0.75" stroke-width="1.5" />
                  <line x1="80" y1="58" x2="48" y2="86" stroke={tile.color} stroke-opacity="0.75" stroke-width="1.5" />
                  <line x1="80" y1="58" x2="40" y2="44" stroke={tile.color} stroke-opacity="0.75" stroke-width="1.5" />

                  <!-- Secondary cross edges -->
                  <line x1="80" y1="28" x2="120" y2="44" stroke={tile.color} stroke-opacity="0.3" stroke-width="1" />
                  <line x1="120" y1="44" x2="112" y2="86" stroke={tile.color} stroke-opacity="0.3" stroke-width="1" />
                  <line x1="48" y1="86" x2="40" y2="44" stroke={tile.color} stroke-opacity="0.3" stroke-width="1" />

                  <!-- Candidate Nodes -->
                  <circle cx="80" cy="28" r="3" fill={tile.color} />
                  <circle cx="120" cy="44" r="3" fill={tile.color} />
                  <circle cx="112" cy="86" r="3" fill={tile.color} />
                  <circle cx="48" cy="86" r="3" fill={tile.color} />
                  <circle cx="40" cy="44" r="3" fill={tile.color} />
                </g>
              )}
            </svg>
          </div>

          <!-- Bottom Title & Micro Code Snippet -->
          <div class="tile-bottom-panel">
            <h3 class="tile-kernel-title">{tile.name}</h3>
            <div class="tile-micro-snippet">
              <span class="snippet-source">SOURCE: {tile.sourceFile}</span>
              <span class="snippet-sep">&bull;</span>
              <span class="snippet-kernel">KERNEL: {tile.kernelName}</span>
            </div>
          </div>

          <!-- Click to inspect badge overlay -->
          <div class="tile-hover-action">
            <span>Inspect Kernel Spec &rarr;</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty search state -->
    <div id="atlasEmptyState" class="atlas-empty-state" style="display:none;">
      <div class="empty-icon">🔍</div>
      <h3>No compute kernels match your filter</h3>
      <p>Try searching for terms like <code>gemm</code>, <code>sdpa</code>, <code>fitness</code>, <code>stdp</code>, or <code>graphrag</code>.</p>
      <button id="resetAtlasFilters" class="btn-secondary" style="margin-top:12px; font-size:13px;">Reset Filter</button>
    </div>

    <!-- Bottom Compositor Footer Caption matching screenshot -->
    <div class="atlas-footer-caption">
      <div class="compositor-line"></div>
      <p class="compositor-text">
        <span>HFLabs Compute Substrate</span> &mdash; 
        <span>Level Zero Kernel Atlas, rendered with the HypertensorGraphRAG tile compositor engine (September 2026)</span>
      </p>
    </div>
  </div>

  <!-- Interactive Kernel Inspector Modal -->
  <div id="kernelInspectorModal" class="kernel-modal-overlay" style="display:none;">
    <div class="kernel-modal-container">
      <div class="kernel-modal-head">
        <div class="modal-badge-row">
          <span id="modalCategoryBadge" class="modal-badge">CATEGORY</span>
          <span id="modalTargetCount" class="modal-badge sub">11 SILICON TARGETS</span>
        </div>
        <h2 id="modalKernelTitle" class="modal-title">KERNEL TITLE</h2>
        <button id="closeKernelModal" class="modal-close-btn" aria-label="Close modal">&times;</button>
      </div>

      <div class="kernel-modal-body">
        <p id="modalKernelDesc" class="modal-desc">Kernel description text goes here.</p>

        <!-- OpenCL C Signature -->
        <div class="modal-section-block">
          <div class="modal-section-title">
            <span>OpenCL C / SPIR-V Kernel Signature</span>
            <span id="modalSourceFile" class="mono-file">source.cl</span>
          </div>
          <pre class="modal-code-pre"><code id="modalKernelSignature" class="language-c"></code></pre>
        </div>

        <!-- Managed C# Driver Invocation -->
        <div class="modal-section-block">
          <div class="modal-section-title">
            <span>LevelZero.NET Managed C# Wrapper</span>
            <span class="mono-file">LevelZero.Kernels.dll</span>
          </div>
          <pre class="modal-code-pre"><code id="modalCsharpWrapper" class="language-csharp"></code></pre>
        </div>

        <!-- Target Compatibility Chips -->
        <div class="modal-targets-block">
          <span class="modal-section-title">Verified Precompiled Targets:</span>
          <div class="target-chips-row">
            <span class="hw-chip">tgllp (Gen12)</span>
            <span class="hw-chip">dg1 (Iris Max)</span>
            <span class="hw-chip">acm-g10 (Arc A770)</span>
            <span class="hw-chip">acm-g11 (Arc A380)</span>
            <span class="hw-chip">acm-g12 (Arc Pro)</span>
            <span class="hw-chip">pvc (Max 1550)</span>
            <span class="hw-chip">mtl (Core Ultra 1)</span>
            <span class="hw-chip">arl-h (Core Ultra 2)</span>
            <span class="hw-chip">bmg-g21 (Battlemage)</span>
            <span class="hw-chip">lnl-m (Lunar Lake)</span>
            <span class="hw-chip">ptl-h (Panther Lake)</span>
          </div>
        </div>
      </div>

      <div class="kernel-modal-footer">
        <a href="https://github.com/hf-laboratories" target="_blank" rel="noopener noreferrer" class="btn-primary" style="font-size:13px; padding:8px 16px;">
          View Kernel Source on GitHub
        </a>
        <button id="copySignatureBtn" class="btn-secondary" style="font-size:13px; padding:8px 16px;">
          Copy C# Invocation
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Atlas Client Interactivity Script -->
<script define:vars={{ KERNEL_ATLAS }}>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.legend-pill');
    const searchInput = document.getElementById('atlasSearchInput');
    const clearBtn = document.getElementById('clearAtlasSearch');
    const tiles = document.querySelectorAll('.atlas-tile-card');
    const emptyState = document.getElementById('atlasEmptyState');
    const resetBtn = document.getElementById('resetAtlasFilters');

    // Modal elements
    const modal = document.getElementById('kernelInspectorModal');
    const modalCategory = document.getElementById('modalCategoryBadge');
    const modalTitle = document.getElementById('modalKernelTitle');
    const modalDesc = document.getElementById('modalKernelDesc');
    const modalSignature = document.getElementById('modalKernelSignature');
    const modalSource = document.getElementById('modalSourceFile');
    const modalCsharp = document.getElementById('modalCsharpWrapper');
    const closeModalBtn = document.getElementById('closeKernelModal');
    const copySigBtn = document.getElementById('copySignatureBtn');

    let activeFilter = 'all';
    let searchQuery = '';

    function filterAtlas() {
      let visibleCount = 0;
      tiles.forEach(tile => {
        const cat = tile.getAttribute('data-category');
        const searchContent = tile.getAttribute('data-search') || '';
        
        const matchesCategory = (activeFilter === 'all' || cat === activeFilter);
        const matchesSearch = !searchQuery || searchContent.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          tile.style.display = 'flex';
          visibleCount++;
        } else {
          tile.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Filter pills click
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeFilter = pill.getAttribute('data-filter') || 'all';
        filterAtlas();
      });
    });

    // Search filter input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        if (clearBtn) {
          clearBtn.style.display = searchQuery.length > 0 ? 'block' : 'none';
        }
        filterAtlas();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        clearBtn.style.display = 'none';
        filterAtlas();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        if (clearBtn) clearBtn.style.display = 'none';
        pills.forEach(p => p.classList.remove('active'));
        document.querySelector('.legend-pill[data-filter="all"]')?.classList.add('active');
        activeFilter = 'all';
        filterAtlas();
      });
    }

    // Open Modal on Tile Click
    tiles.forEach(tile => {
      tile.addEventListener('click', () => {
        const kernelId = tile.getAttribute('data-kernel-id');
        const kernelData = KERNEL_ATLAS.find(k => k.id === kernelId);
        if (!kernelData || !modal) return;

        modalCategory.textContent = kernelData.category;
        modalCategory.style.borderColor = kernelData.color;
        modalCategory.style.color = kernelData.color;
        modalTitle.textContent = kernelData.name;
        modalDesc.textContent = kernelData.description;
        modalSource.textContent = `SOURCE: ${kernelData.sourceFile}`;
        modalSignature.textContent = kernelData.signature;
        modalCsharp.textContent = kernelData.csharpWrapper;

        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
        closeModal();
      }
    });

    if (copySigBtn) {
      copySigBtn.addEventListener('click', () => {
        if (modalCsharp) {
          navigator.clipboard.writeText(modalCsharp.textContent || '');
          const prevText = copySigBtn.textContent;
          copySigBtn.textContent = 'Copied!';
          setTimeout(() => {
            copySigBtn.textContent = prevText;
          }, 2000);
        }
      });
    }
  });
</script>

<style>
  .kernel-atlas-section {
    padding: 70px 0 50px;
    background: radial-gradient(circle at 50% 0%, rgba(6, 182, 212, 0.06), transparent 60%),
                radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.04), transparent 50%),
                #030712;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .atlas-container {
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .atlas-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .atlas-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }

  .atlas-status-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    font-size: 10px;
