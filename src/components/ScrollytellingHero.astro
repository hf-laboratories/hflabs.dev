---
// ScrollytellingHero.astro
---

<section class="scrollytelling-section">
  <div class="container">
    <div class="hero-intro">
      <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:16px;">
        HFLabs Monorepo Architecture
      </div>
      <h1 class="hero-title">
        High-Assurance Systems, <span class="text-gradient">SIMD Vector Cognition</span> &amp; Swarm Metaheuristics.
      </h1>
      <p class="hero-subtitle">
        Explore the primary engineering divisions of HFLabs: in-memory GraphRAG &amp; swarm optimization, heterogeneous ML &amp; query acceleration, and bare-metal Intel Level Zero / Poplar native substrates.
      </p>
      <div style="display:flex; gap:12px; margin-top:24px; flex-wrap:wrap; justify-content:center;">
        <a href="#divisions" class="btn-primary">Explore 3 Divisions &rarr;</a>
        <a href="/wiki" class="btn-secondary">Open Polyglot Matrix</a>
      </div>
    </div>

    <!-- Scrollytelling Viewport -->
    <div class="scrolly-container">
      <!-- Left: Division Narrative Cards -->
      <div class="scrolly-narrative">
        <!-- Division 01 -->
        <div class="narrative-card active" data-division="1">
          <div class="div-header-row">
            <span class="div-tag">DIVISION 01</span>
            <span class="div-sub-badge">Vector &amp; Swarm Engines</span>
          </div>
          <h3>Cognition &amp; Swarm Intelligence</h3>
          <p>
            In-memory graph retrieval, SIMD vector search, and multi-algorithm swarm optimization. Keeps the entire graph resident in RAM to eliminate disk-bound lookups, powering agent reasoning through FastMCP and desktop visualization HUDs.
          </p>
          <div class="proj-pill-list">
            <span class="proj-pill">Hypertensor GraphRAG</span>
            <span class="proj-pill">HyperSwarm Suite</span>
            <span class="proj-pill">SwarmDev</span>
          </div>
          <ul class="step-metrics">
            <li>
              <span>2-Hop Traversal</span>
              <strong>0.15–1.95 ms</strong>
            </li>
            <li>
              <span>SIMD Vectors</span>
              <strong>128-d Default</strong>
            </li>
            <li>
              <span>MCP Connectivity</span>
              <strong>65+ FastMCP Tools</strong>
            </li>
          </ul>
        </div>

        <!-- Division 02 -->
        <div class="narrative-card" data-division="2">
          <div class="div-header-row">
            <span class="div-tag" style="color:var(--accent-cyan);">DIVISION 02</span>
            <span class="div-sub-badge" style="color:var(--accent-cyan); border-color:rgba(6,182,212,0.3);">ML &amp; Query Engines</span>
          </div>
          <h3>Machine Learning &amp; Acceleration</h3>
          <p>
            Spiking and graph-based ML, heterogeneous accelerator orchestration, and IPU-offloaded SQL. A unified gRPC service coordinates execution envelopes across IPU (Poplar), CUDA, OpenCL, Level Zero, FPGA, and DMA/RDMA backends.
          </p>
          <div class="proj-pill-list">
            <span class="proj-pill">HFLabs ML Suite</span>
            <span class="proj-pill">Accelerator Layer</span>
            <span class="proj-pill">IPU SQL Accel (MVP)</span>
          </div>
          <ul class="step-metrics">
            <li>
              <span>ML Substrates</span>
              <strong>SNN &amp; KGE</strong>
            </li>
            <li>
              <span>Accelerator Fabric</span>
              <strong>Unified gRPC</strong>
            </li>
            <li>
              <span>Query Engine</span>
              <strong>IPU SQL Offload</strong>
            </li>
          </ul>
        </div>

        <!-- Division 03 -->
        <div class="narrative-card" data-division="3">
          <div class="div-header-row">
            <span class="div-tag" style="color:var(--accent-rose);">DIVISION 03</span>
            <span class="div-sub-badge" style="color:var(--accent-rose); border-color:rgba(244,63,94,0.3);">Bare Metal &amp; Interop</span>
          </div>
          <h3>Hardware &amp; Native Substrates</h3>
          <p>
            Intel Level Zero interop, precompiled kernels, Graphcore Poplar bindings, and header-to-binding generation. Direct C ABI shims, zero-overhead C# P/Invoke, and 26 OpenCL C kernels precompiled into native zebins across 11 Intel targets.
          </p>
          <div class="proj-pill-list">
            <span class="proj-pill">LevelZero.NET</span>
            <span class="proj-pill">L0 Kernel Catalog</span>
            <span class="proj-pill">Poplar.NET</span>
            <span class="proj-pill">Abigen</span>
          </div>
          <ul class="step-metrics">
            <li>
              <span>L0 Domain Wrappers</span>
              <strong>16 Handlers</strong>
            </li>
            <li>
              <span>Kernel Catalog</span>
              <strong>26 Zebin/SPIR-V</strong>
            </li>
            <li>
              <span>Hardware Targets</span>
              <strong>11 Intel Targets</strong>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right: Sticky Live Visualizer Display -->
      <div class="scrolly-sticky">
        <div class="visualizer-card">
          <div class="visualizer-header">
            <span class="status-dot"></span>
            <span id="visualizerModeLabel" class="visualizer-title">Cognition &amp; Swarm Intelligence</span>
            <span id="visualizerDivisionBadge" class="visualizer-badge">DIVISION 01</span>
          </div>

          <!-- Dynamic Visualizer Topology Diagram -->
          <div id="visualizerDisplay" class="visualizer-content">
            <!-- Dynamic Diagram Nodes Container -->
            <div id="diagramContainer" class="diagram-mesh div-mode-1">
              <div class="diagram-grid">
                <div class="diagram-node node-primary" id="node1">
                  <span class="node-icon">🧠</span>
                  <div class="node-text">
                    <span class="node-title">Hypertensor GraphRAG</span>
                    <span class="node-sub">In-Memory Typed Store</span>
                  </div>
                </div>
                <div class="diagram-link link-h" id="link1">
                  <span class="link-pulse"></span>
                </div>
                <div class="diagram-node node-secondary" id="node2">
                  <span class="node-icon">⚡</span>
                  <div class="node-text">
                    <span class="node-title">SIMD TensorPrimitives</span>
                    <span class="node-sub">128-d Vector Cosine</span>
                  </div>
                </div>
                <div class="diagram-node node-secondary" id="node3">
                  <span class="node-icon">🐝</span>
                  <div class="node-text">
                    <span class="node-title">HyperSwarm Suite</span>
                    <span class="node-sub">Director Authority</span>
                  </div>
                </div>
                <div class="diagram-link link-h" id="link2">
                  <span class="link-pulse"></span>
                </div>
                <div class="diagram-node node-primary" id="node4">
                  <span class="node-icon">🔌</span>
                  <div class="node-text">
                    <span class="node-title">FastMCP Server</span>
                    <span class="node-sub">65+ Agent Tools</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="terminal-preview">
              <code id="terminalText">[Cognition &amp; Swarm] Hypertensor GraphRAG: 2-hop traversal in 0.15 ms | SIMD 128d | FastMCP 65+ tools active</code>
            </div>
          </div>

          <div class="visualizer-footer">
            <div class="footer-stat">
              <span id="statLbl1" class="stat-lbl">Graph Residency</span>
              <span id="statVal1" class="stat-val">In-Memory RAM</span>
            </div>
            <div class="footer-stat">
              <span id="statLbl2" class="stat-lbl">Vector Engine</span>
              <span id="statVal2" class="stat-val">SIMD TensorPrimitives</span>
            </div>
            <div class="footer-stat">
              <span id="statLbl3" class="stat-lbl">Agent Protocol</span>
              <span id="statVal3" class="stat-val">FastMCP (65+ Tools)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollytelling-section {
    padding: 80px 0 100px;
    position: relative;
  }

  .hero-intro {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 60px;
  }

  .hero-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .text-gradient {
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .scrolly-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    position: relative;
  }

  .scrolly-narrative {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 20px 0;
  }

  .narrative-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: all 0.3s ease;
    opacity: 0.55;
    cursor: pointer;
  }

  .narrative-card:hover {
    opacity: 0.85;
    border-color: rgba(56, 189, 248, 0.4);
  }

  .narrative-card.active {
    opacity: 1;
    border-color: var(--accent-blue);
    box-shadow: 0 10px 30px rgba(56, 189, 248, 0.15);
    transform: translateX(6px);
  }

  .div-header-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .div-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    color: var(--accent-blue);
    letter-spacing: 0.05em;
  }

  .div-sub-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .narrative-card h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 10px;
    color: var(--text-primary);
  }

  .narrative-card p {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .proj-pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .proj-pill {
    font-size: 11px;
    font-family: var(--font-mono);
    background: rgba(56, 189, 248, 0.08);
    color: #bae6fd;
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .step-metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    background: rgba(11, 15, 25, 0.6);
    border-radius: var(--radius-sm);
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .step-metrics li {
    font-size: 10px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .step-metrics strong {
    font-size: 13.5px;
    color: var(--accent-emerald);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .scrolly-sticky {
    position: sticky;
    top: 90px;
    height: fit-content;
  }

  .visualizer-card {
    background: #090e1a;
    border: 1px solid var(--border-highlight);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .visualizer-header {
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid var(--border-color);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    flex-shrink: 0;
  }

  .visualizer-title {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-primary);
    flex-grow: 1;
  }

  .visualizer-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-blue);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .visualizer-content {
    min-height: 310px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    background: radial-gradient(circle at center, rgba(30, 41, 59, 0.35) 0%, rgba(9, 14, 26, 0.95) 100%);
  }

  .diagram-mesh {
    width: 100%;
  }

  .diagram-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto;
    gap: 12px;
    align-items: center;
  }

  .diagram-node {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .diagram-node.node-primary {
    border-color: rgba(56, 189, 248, 0.5);
    background: rgba(15, 23, 42, 0.95);
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.08);
  }

  .node-icon {
    font-size: 16px;
    flex-shrink: 0;
  }

  .node-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .node-title {
    font-size: 12px;
    font-weight: 700;
    color: #f8fafc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .node-sub {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .diagram-link {
    height: 2px;
    background: rgba(56, 189, 248, 0.3);
    position: relative;
    overflow: hidden;
  }

  .link-h {
    width: 32px;
  }

  .link-pulse {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 12px;
    background: var(--accent-blue);
    box-shadow: 0 0 6px var(--accent-blue);
    animation: linkPulseAnim 1.6s infinite linear;
  }

  @keyframes linkPulseAnim {
    0% { left: -10px; }
    100% { left: 40px; }
  }

  .terminal-preview {
    background: #04060c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 11px;
    color: #93c5fd;
    font-family: var(--font-mono);
    overflow-x: auto;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .visualizer-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.9);
    padding: 12px 18px;
  }

  .footer-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-lbl {
    font-size: 9.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .stat-val {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 960px) {
    .scrolly-container {
      grid-template-columns: 1fr;
    }
    .scrolly-sticky {
      position: relative;
      top: 0;
    }
    .hero-title {
      font-size: 32px;
    }
    .diagram-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .diagram-link {
      display: none;
    }
  }
</style>

<script>
  // Division configuration dictionary
  const divisionConfigs = {
    1: {
      title: 'Cognition & Swarm Intelligence',
      badge: 'DIVISION 01',
      badgeColor: '#38bdf8',
      nodes: [
        { icon: '🧠', title: 'Hypertensor GraphRAG', sub: 'In-Memory Typed Store' },
        { icon: '⚡', title: 'SIMD TensorPrimitives', sub: '128-d Vector Cosine' },
        { icon: '🐝', title: 'HyperSwarm Suite', sub: 'Director Authority' },
        { icon: '🔌', title: 'FastMCP Server', sub: '65+ Agent Tools' }
      ],
      terminal: '[Cognition & Swarm] Hypertensor GraphRAG: 2-hop traversal in 0.15 ms | SIMD 128d | FastMCP 65+ tools active',
      stats: [
        { lbl: 'Graph Residency', val: 'In-Memory RAM' },
        { lbl: 'Vector Engine', val: 'SIMD TensorPrimitives' },
        { lbl: 'Agent Protocol', val: 'FastMCP (65+ Tools)' }
      ]
    },
    2: {
      title: 'Machine Learning & Acceleration',
      badge: 'DIVISION 02',
      badgeColor: '#06b6d4',
      nodes: [
        { icon: '🧬', title: 'HFLabs ML Suite', sub: 'Spiking NN & KGE' },
        { icon: '⚡', title: 'Accelerator gRPC', sub: 'Plan Envelope Fabric' },
        { icon: '🎛️', title: 'Heterogeneous Backends', sub: 'IPU / L0 / CUDA / FPGA' },
        { icon: '🗄️', title: 'IPU SQL Acceleration', sub: 'Postgres & CLR Offload' }
      ],
      terminal: '[ML & Acceleration] gRPC plan envelope dispatched across IPU (Poplar) & Level Zero | SQL aggregate offloaded',
      stats: [
        { lbl: 'ML Architecture', val: 'Spiking & Graph ML' },
        { lbl: 'Acceleration Fabric', val: 'Unified gRPC Plan' },
        { lbl: 'Query Offload', val: 'IPU SQL Bridge (MVP)' }
      ]
    },
    3: {
      title: 'Hardware & Native Substrates',
      badge: 'DIVISION 03',
      badgeColor: '#f43f5e',
      nodes: [
        { icon: '⚙️', title: 'Abigen Clang Engine', sub: 'C ABI Shim Generator' },
        { icon: '📦', title: 'Native C ABI Shim', sub: 'Zero-Overhead P/Invoke' },
        { icon: '🖥️', title: 'LevelZero.NET', sub: '16 Domain Wrappers' },
        { icon: '⚡', title: 'L0 Kernel Catalog', sub: '26 Precompiled Zebins' }
      ],
      terminal: '[Hardware Substrate] LevelZero.NET initialized | 26 kernels precompiled across 11 Intel targets (Iris Xe to Panther Lake)',
      stats: [
        { lbl: 'Native Interop', val: 'Managed C# P/Invoke' },
        { lbl: 'GPU Kernels', val: '26 Zebin & SPIR-V' },
        { lbl: 'Intel Targets', val: '11 Hardware Targets' }
      ]
    }
  };

  const cards = document.querySelectorAll('.narrative-card');
  const titleEl = document.getElementById('visualizerModeLabel');
  const badgeEl = document.getElementById('visualizerDivisionBadge');
  const terminalEl = document.getElementById('terminalText');
  const statLbl1 = document.getElementById('statLbl1');
  const statVal1 = document.getElementById('statVal1');
  const statLbl2 = document.getElementById('statLbl2');
  const statVal2 = document.getElementById('statVal2');
  const statLbl3 = document.getElementById('statLbl3');
  const statVal3 = document.getElementById('statVal3');

  function updateDivisionDisplay(divId) {
    const cfg = divisionConfigs[divId];
    if (!cfg) return;

    if (titleEl) titleEl.textContent = cfg.title;
    if (badgeEl) {
      badgeEl.textContent = cfg.badge;
      badgeEl.style.color = cfg.badgeColor;
      badgeEl.style.borderColor = `${cfg.badgeColor}4D`;
      badgeEl.style.background = `${cfg.badgeColor}1A`;
    }

    if (terminalEl) terminalEl.textContent = cfg.terminal;

    // Update diagram nodes
    const node1 = document.getElementById('node1');
    const node2 = document.getElementById('node2');
    const node3 = document.getElementById('node3');
    const node4 = document.getElementById('node4');

    const nodeEls = [node1, node2, node3, node4];
    cfg.nodes.forEach((n, idx) => {
      const el = nodeEls[idx];
      if (el) {
        const icon = el.querySelector('.node-icon');
        const title = el.querySelector('.node-title');
        const sub = el.querySelector('.node-sub');
        if (icon) icon.textContent = n.icon;
        if (title) title.textContent = n.title;
        if (sub) sub.textContent = n.sub;
      }
    });

    // Update stats
    if (statLbl1 && statVal1 && cfg.stats[0]) {
      statLbl1.textContent = cfg.stats[0].lbl;
      statVal1.textContent = cfg.stats[0].val;
    }
    if (statLbl2 && statVal2 && cfg.stats[1]) {
      statLbl2.textContent = cfg.stats[1].lbl;
      statVal2.textContent = cfg.stats[1].val;
    }
    if (statLbl3 && statVal3 && cfg.stats[2]) {
      statLbl3.textContent = cfg.stats[2].lbl;
      statVal3.textContent = cfg.stats[2].val;
    }
  }

  // Click handler
  cards.forEach(card => {
    card.addEventListener('click', () => {
      cards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      const divId = card.getAttribute('data-division');
      updateDivisionDisplay(divId);
    });
  });

  // Scroll observer
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        cards.forEach(c => c.classList.remove('active'));
        entry.target.classList.add('active');
        const divId = entry.target.getAttribute('data-division');
        updateDivisionDisplay(divId);
      }
    });
  }, {
    threshold: 0.55
  });

  cards.forEach(card => observer.observe(card));
</script>
