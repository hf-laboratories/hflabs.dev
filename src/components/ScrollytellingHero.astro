---
// ScrollytellingHero.astro
---

<section class="scrollytelling-section">
  <div class="container">
    <div class="hero-intro">
      <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:16px;">
        Next-Generation Systems Architecture
      </div>
      <h1 class="hero-title">
        High-Assurance Systems, <span class="text-gradient">SIMD Vector Cognition</span> &amp; Swarm Metaheuristics.
      </h1>
      <p class="hero-subtitle">
        Explore the unified HFLabs technology stack: from sub-millisecond in-memory GraphRAG and autonomous swarm optimization to bare-metal Intel Level Zero GPU compute.
      </p>
      <div style="display:flex; gap:12px; margin-top:24px; flex-wrap:wrap;">
        <a href="#divisions" class="btn-primary">Explore 6 Divisions &rarr;</a>
        <a href="/wiki" class="btn-secondary">Open Polyglot Matrix</a>
      </div>
    </div>

    <!-- Scrollytelling Viewport -->
    <div class="scrolly-container">
      <!-- Left: Scrolling Narrative Steps -->
      <div class="scrolly-narrative">
        <div class="narrative-card active" data-step="1">
          <div class="step-num">01 / GRAPH COGNITION</div>
          <h3>In-Memory GraphRAG &amp; SIMD Vectors</h3>
          <p>
            Traditional RAG flattens codebase context into disconnected text chunks. HFLabs In-Memory GraphRAG indexes entire workspace topologies into high-dimensional SIMD vector spaces with typed semantic relation edges.
          </p>
          <ul class="step-metrics">
            <li><strong>&lt; 0.8 ms</strong> 2-hop traversal latency</li>
            <li><strong>128-dim</strong> SIMD AVX-512 vector index</li>
            <li><strong>Zero-copy</strong> in-process memory residency</li>
          </ul>
        </div>

        <div class="narrative-card" data-step="2">
          <div class="step-num">02 / METAHEURISTIC SWARM</div>
          <h3>HyperSwarm Director Authority</h3>
          <p>
            Complex optimization spaces require multi-algorithm cooperation. The HyperSwarm Director monitors population entropy and dynamically switches authority between PSO, Ant Colony, Firefly, and CMA-ES optimizers.
          </p>
          <ul class="step-metrics">
            <li><strong>270-case</strong> sweep matrix validation</li>
            <li><strong>100%</strong> feasibility on CEC constrained benchmarks</li>
            <li><strong>Director</strong> autonomous threshold tuning</li>
          </ul>
        </div>

        <div class="narrative-card" data-step="3">
          <div class="step-num">03 / HARDWARE SUBSTRATE</div>
          <h3>Direct Level Zero GPU Compute</h3>
          <p>
            No heavy vendor wrappers. LevelZero.NET communicates directly with the Intel Level Zero native C ABI, loading precompiled zebin compute kernels onto Iris Xe and Arc GPUs for swarm acceleration.
          </p>
          <ul class="step-metrics">
            <li><strong>18+</strong> native GPU zebin kernels</li>
            <li><strong>tgllp</strong> Iris Xe GT2 hardware validation</li>
            <li><strong>Direct ABI</strong> zero-overhead C# P/Invoke</li>
          </ul>
        </div>

        <div class="narrative-card" data-step="4">
          <div class="step-num">04 / HIGH-ASSURANCE GOVERNANCE</div>
          <h3>Capability Sandbox &amp; Tri-Beam Verification</h3>
          <p>
            Autonomous agent workflows operate under strict formal constraints. High-Assurance Shield enforces multi-level security (MLS) clearance tokens, metamorphic test oracles, and air-gapped cryptographic signatures.
          </p>
          <ul class="step-metrics">
            <li><strong>HMAC-SHA256</strong> cryptographic validation</li>
            <li><strong>MLS</strong> multi-level clearance tiers</li>
            <li><strong>BESS</strong> evolutionary invariant prover</li>
          </ul>
        </div>
      </div>

      <!-- Right: Sticky Live Visualizer Display -->
      <div class="scrolly-sticky">
        <div class="visualizer-card">
          <div class="visualizer-header">
            <span class="status-dot"></span>
            <span id="visualizerModeLabel" class="visualizer-title">GraphRAG SIMD Vector Substrate</span>
            <span id="visualizerStepBadge" class="visualizer-badge">STAGE 01</span>
          </div>

          <!-- Dynamic Visualizer Canvas / Graphic -->
          <div id="visualizerDisplay" class="visualizer-content">
            <div class="diagram-box mode-1">
              <div class="topo-diagram">
                <div class="node n-core">HFLabs Core</div>
                <div class="edge e1"></div>
                <div class="node n-simd">128d SIMD Index</div>
                <div class="edge e2"></div>
                <div class="node n-rag">GraphRAG Node</div>
                <div class="edge e3"></div>
                <div class="node n-mcp">FastMCP Bridge</div>
              </div>
              <div class="terminal-preview">
                <code>[GraphRAG SIMD] Traversal complete: 2 hops in 0.74 ms (128d AVX-512)</code>
              </div>
            </div>
          </div>

          <div class="visualizer-footer">
            <div class="footer-stat">
              <span class="stat-lbl">Memory Regime</span>
              <span id="statRegime" class="stat-val">SIMD AVX-512</span>
            </div>
            <div class="footer-stat">
              <span class="stat-lbl">Throughput</span>
              <span id="statThroughput" class="stat-val">12,400 qps</span>
            </div>
            <div class="footer-stat">
              <span class="stat-lbl">Assurance</span>
              <span id="statAssurance" class="stat-val">Deterministic</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollytelling-section {
    padding: 80px 0 100px;
    position: relative;
  }

  .hero-intro {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 60px;
  }

  .hero-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .text-gradient {
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .scrolly-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    position: relative;
  }

  .scrolly-narrative {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 40px 0;
  }

  .narrative-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: all 0.3s ease;
    opacity: 0.45;
  }

  .narrative-card.active {
    opacity: 1;
    border-color: var(--accent-blue);
    box-shadow: 0 10px 30px rgba(56, 189, 248, 0.15);
    transform: translateX(8px);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-blue);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .narrative-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .narrative-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .step-metrics {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    background: rgba(11, 15, 25, 0.6);
    border-radius: var(--radius-sm);
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .step-metrics li {
    font-size: 11px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .step-metrics strong {
    font-size: 15px;
    color: var(--accent-emerald);
    font-family: var(--font-mono);
  }

  .scrolly-sticky {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .visualizer-card {
    background: #090e1a;
    border: 1px solid var(--border-highlight);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .visualizer-header {
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid var(--border-color);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .visualizer-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    flex-grow: 1;
  }

  .visualizer-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-blue);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .visualizer-content {
    min-height: 280px;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, rgba(30, 41, 59, 0.4) 0%, rgba(9, 14, 26, 0.9) 100%);
  }

  .topo-diagram {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    justify-content: center;
  }

  .topo-diagram .node {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(56, 189, 248, 0.4);
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    font-family: var(--font-mono);
    color: #f8fafc;
  }

  .topo-diagram .edge {
    width: 24px;
    height: 2px;
    background: #38bdf8;
    position: relative;
  }

  .terminal-preview {
    background: #04060c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 11px;
    color: #a5b4fc;
    font-family: var(--font-mono);
  }

  .visualizer-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.8);
    padding: 12px 18px;
  }

  .footer-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-lbl {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .stat-val {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  @media (max-width: 960px) {
    .scrolly-container {
      grid-template-columns: 1fr;
    }
    .scrolly-sticky {
      position: relative;
      top: 0;
    }
    .hero-title {
      font-size: 32px;
    }
  }
</style>

<script>
  // Interactive Scrollytelling step observer
  const steps = document.querySelectorAll('.narrative-card');
  const titleEl = document.getElementById('visualizerModeLabel');
  const badgeEl = document.getElementById('visualizerStepBadge');
  const statRegime = document.getElementById('statRegime');
  const statThroughput = document.getElementById('statThroughput');
  const statAssurance = document.getElementById('statAssurance');

  const configs = {
    1: {
      title: 'GraphRAG SIMD Vector Substrate',
      badge: 'STAGE 01',
      regime: 'SIMD AVX-512',
      throughput: '12,400 qps',
      assurance: 'Deterministic',
      terminal: '[GraphRAG SIMD] Traversal complete: 2 hops in 0.74 ms (128d AVX-512)'
    },
    2: {
      title: 'HyperSwarm Director Authority',
      badge: 'STAGE 02',
      regime: 'Multi-Algorithm',
      throughput: '270 cases / min',
      assurance: '100% Feasibility',
      terminal: '[Director Matrix] Swarm Coherence: 0.942 | Authority: Adaptive PSO-Firefly'
    },
    3: {
      title: 'Level Zero Hardware Kernel Dispatch',
      badge: 'STAGE 03',
      regime: 'Intel Iris Xe GT2',
      throughput: '18 Zebin Kernels',
      assurance: 'Hardware ABI Clean',
      terminal: '[LevelZero.NET] Executed fitness_kernel on tgllp in 0.042 ms'
    },
    4: {
      title: 'High-Assurance Shield Governance',
      badge: 'STAGE 04',
      regime: 'MLS Tiered Air-Gap',
      throughput: 'Cryptographic',
      assurance: 'HMAC-SHA256 Signed',
      terminal: '[Security Shield] Capability token verified. Clearance: HIGH_ASSURANCE'
    }
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        steps.forEach(s => s.classList.remove('active'));
        entry.target.classList.add('active');

        const stepId = entry.target.getAttribute('data-step');
        const cfg = configs[stepId];
        if (cfg && titleEl && badgeEl && statRegime && statThroughput && statAssurance) {
          titleEl.textContent = cfg.title;
          badgeEl.textContent = cfg.badge;
          statRegime.textContent = cfg.regime;
          statThroughput.textContent = cfg.throughput;
          statAssurance.textContent = cfg.assurance;

          const term = document.querySelector('.terminal-preview code');
          if (term) term.textContent = cfg.terminal;
        }
      }
    });
  }, {
    threshold: 0.6
  });

  steps.forEach(s => observer.observe(s));
</script>
