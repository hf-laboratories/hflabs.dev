---
// src/components/DivisionBackgroundOverlay.astro
interface Props {
  id?: string;
  initialDivision?: number; // 0, 1, 2
  opacity?: number;
}

const { id = "division-bg-overlay", initialDivision = 0, opacity = 0.85 } = Astro.props;
---

<div id={id} class="division-bg-overlay-wrapper" data-active-division={initialDivision} style={`--overlay-opacity: ${opacity};`}>
  <!-- Ambient Atmospheric Radiant Mesh -->
  <div class="ambient-glow glow-cognition"></div>
  <div class="ambient-glow glow-acceleration"></div>
  <div class="ambient-glow glow-hardware"></div>

  <!-- Dynamic High-Performance Particle & Topology Canvas -->
  <canvas class="division-canvas"></canvas>

  <!-- Cybernetic Grid Overlay -->
  <div class="grid-sub-layer"></div>

  <!-- Scanline & Vignette Effect -->
  <div class="vignette-layer"></div>
</div>

<style>
  .division-bg-overlay-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
    opacity: var(--overlay-opacity, 0.85);
    transition: opacity 0.5s ease;
  }

  /* Ambient Glow Layers */
  .ambient-glow {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s ease;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .glow-cognition {
    background: radial-gradient(circle at 35% 45%, rgba(56, 189, 248, 0.16) 0%, rgba(99, 102, 241, 0.08) 40%, transparent 70%);
  }

  .glow-acceleration {
    background: radial-gradient(circle at 60% 40%, rgba(6, 182, 212, 0.16) 0%, rgba(168, 85, 247, 0.1) 45%, transparent 70%);
  }

  .glow-hardware {
    background: radial-gradient(circle at 45% 55%, rgba(244, 63, 94, 0.16) 0%, rgba(251, 191, 36, 0.08) 45%, transparent 70%);
  }

  [data-active-division="0"] .glow-cognition {
    opacity: 1;
    transform: scale(1.02);
  }

  [data-active-division="1"] .glow-acceleration {
    opacity: 1;
    transform: scale(1.02);
  }

  [data-active-division="2"] .glow-hardware {
    opacity: 1;
    transform: scale(1.02);
  }

  .division-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .grid-sub-layer {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.5;
    mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 90%);
  }

  .vignette-layer {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 40%, rgba(7, 10, 19, 0.75) 100%);
    pointer-events: none;
  }
</style>

<script>
  // Dynamic Canvas Generator for Division Background Overlay
  class DivisionOverlayRenderer {
    container: HTMLElement;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    width = 0;
    height = 0;
    currentDivision = 0; // 0 = Cognition, 1 = Acceleration, 2 = Hardware
    targetDivision = 0;
    divisionTransition = 1.0;
    animFrameId: number | null = null;
    isVisible = false;
    particles: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      alpha: number;
      phase: number;
      speed: number;
      color: string;
      divId: number;
    }> = [];

    // Hardware trace segments for Division 2
    circuits: Array<{
      x: number;
      y: number;
      len: number;
      dir: 'h' | 'v';
      pulsePos: number;
      speed: number;
    }> = [];

    // Tensor matrix lines for Division 1
    tensorNodes: Array<{
      col: number;
      row: number;
      x: number;
      y: number;
      activity: number;
    }> = [];

    constructor(container: HTMLElement) {
      this.container = container;
      this.canvas = container.querySelector('.division-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d', { alpha: true }) as CanvasRenderingContext2D;
      this.currentDivision = parseInt(container.getAttribute('data-active-division') || '0', 10);
      this.targetDivision = this.currentDivision;

      this.initParticles();
      this.initCircuits();
      this.initTensorNodes();

      this.resize = this.resize.bind(this);
      this.render = this.render.bind(this);

      window.addEventListener('resize', this.resize);
      this.resize();

      // Intersection Observer for viewport visibility
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (!this.animFrameId) {
              this.render();
            }
          } else {
            if (this.animFrameId) {
              cancelAnimationFrame(this.animFrameId);
              this.animFrameId = null;
            }
          }
        });
      }, { threshold: 0.05 });

      observer.observe(this.container);

      // Listen for custom division-change events
      window.addEventListener('division-change', (e: Event) => {
        const customEvent = e as CustomEvent;
        if (customEvent.detail && typeof customEvent.detail.divisionIndex === 'number') {
          // If this overlay is designated or global, update
          const targetOverlayId = customEvent.detail.targetOverlayId;
          if (!targetOverlayId || targetOverlayId === this.container.id) {
            this.setDivision(customEvent.detail.divisionIndex);
          }
        }
      });
    }

    setDivision(index: number) {
      if (this.targetDivision !== index) {
        this.targetDivision = index;
        this.currentDivision = index;
        this.container.setAttribute('data-active-division', index.toString());
      }
    }

    resize() {
      const rect = this.container.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.width = rect.width || window.innerWidth;
      this.height = rect.height || window.innerHeight;
      this.canvas.width = this.width * dpr;
      this.canvas.height = this.height * dpr;
      this.ctx.resetTransform();
      this.ctx.scale(dpr, dpr);
    }

    initParticles() {
      this.particles = [];
      const count = 55;
      for (let i = 0; i < count; i++) {
        this.particles.push({
          x: Math.random() * 1200,
          y: Math.random() * 800,
          vx: (Math.random() - 0.5) * 0.45,
          vy: (Math.random() - 0.5) * 0.45,
          size: Math.random() * 2.5 + 1.2,
          alpha: Math.random() * 0.7 + 0.3,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.015 + 0.008,
          color: '#38bdf8',
          divId: 0
        });
      }
    }

    initCircuits() {
      this.circuits = [];
      for (let i = 0; i < 24; i++) {
        this.circuits.push({
          x: Math.random() * 1200,
          y: Math.random() * 800,
          len: Math.random() * 140 + 60,
          dir: Math.random() > 0.5 ? 'h' : 'v',
          pulsePos: Math.random(),
          speed: Math.random() * 0.008 + 0.004
        });
      }
    }

    initTensorNodes() {
      this.tensorNodes = [];
      const cols = 8;
      const rows = 5;
      for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows; r++) {
          this.tensorNodes.push({
            col: c,
            row: r,
            x: 0,
            y: 0,
            activity: Math.random()
          });
        }
      }
    }

    render() {
      if (!this.isVisible) {
        this.animFrameId = null;
        return;
      }

      this.ctx.clearRect(0, 0, this.width, this.height);

      const t = performance.now() * 0.001;

      if (this.currentDivision === 0) {
        // DIVISION 01: COGNITION & SWARM (GraphRAG Constellation + Swarm Flocking)
        this.renderCognitionSwarm(t);
      } else if (this.currentDivision === 1) {
        // DIVISION 02: MACHINE LEARNING & ACCELERATION (Heterogeneous Tensor Flow & gRPC Nodes)
        this.renderAccelerationTensor(t);
      } else {
        // DIVISION 03: HARDWARE & NATIVE SUBSTRATES (Silicon Traces & Level Zero Register Bursts)
        this.renderHardwareSubstrates(t);
      }

      this.animFrameId = requestAnimationFrame(this.render);
    }

    renderCognitionSwarm(t: number) {
      const ctx = this.ctx;
      const pts = this.particles;

      // Update and draw swarm particles
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        p.x += p.vx + Math.sin(t * 0.5 + p.phase) * 0.2;
        p.y += p.vy + Math.cos(t * 0.5 + p.phase) * 0.2;

        if (p.x < -20) p.x = this.width + 20;
        if (p.x > this.width + 20) p.x = -20;
        if (p.y < -20) p.y = this.height + 20;
        if (p.y > this.height + 20) p.y = -20;

        const pulse = 0.5 + 0.5 * Math.sin(t * 2 + p.phase);
        const radius = p.size * (0.8 + 0.4 * pulse);

        // Node Glow
        ctx.beginPath();
        ctx.arc(p.x, p.y, radius * 2.2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(56, 189, 248, ${0.08 * p.alpha})`;
        ctx.fill();

        // Node Core
        ctx.beginPath();
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(186, 230, 253, ${0.65 * p.alpha})`;
        ctx.fill();

        // Connect nearest neighbors (In-memory GraphRAG Edges)
        for (let j = i + 1; j < pts.length; j++) {
          const p2 = pts[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 110) {
            const edgeAlpha = (1 - dist / 110) * 0.22 * p.alpha * p2.alpha;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(56, 189, 248, ${edgeAlpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();

            // Edge data packet pulse
            const packetPos = (t * 0.6 + (i + j) * 0.1) % 1;
            const px = p.x + (p2.x - p.x) * packetPos;
            const py = p.y + (p2.y - p.y) * packetPos;
            ctx.beginPath();
            ctx.arc(px, py, 1.2, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(224, 242, 254, ${edgeAlpha * 2})`;
            ctx.fill();
          }
        }
      }

      // Swarm Center Ring
      const cx = this.width * 0.5;
      const cy = this.height * 0.5;
      ctx.beginPath();
      ctx.arc(cx, cy, 140 + Math.sin(t) * 10, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(56, 189, 248, 0.05)`;
      ctx.setLineDash([6, 12]);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    renderAccelerationTensor(t: number) {
      const ctx = this.ctx;
      const cols = 7;
      const rows = 5;
      const marginX = this.width * 0.12;
      const marginY = this.height * 0.15;
      const stepX = (this.width - marginX * 2) / (cols - 1);
      const stepY = (this.height - marginY * 2) / (rows - 1);

      // Horizontal and Vertical Conduits (Unified gRPC Fabric)
      for (let r = 0; r < rows; r++) {
        const y = marginY + r * stepY;
        const wave = Math.sin(t * 1.5 + r * 0.8) * 0.5 + 0.5;
        ctx.beginPath();
        ctx.moveTo(marginX, y);
        ctx.lineTo(this.width - marginX, y);
        ctx.strokeStyle = `rgba(6, 182, 212, ${0.04 + wave * 0.06})`;
        ctx.lineWidth = 1;
        ctx.stroke();

        // Traveling gRPC pulse along row
        const pulseX = marginX + ((t * 220 + r * 140) % (this.width - marginX * 2));
        ctx.beginPath();
        ctx.arc(pulseX, y, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(168, 85, 247, 0.65)`;
        ctx.fill();
      }

      for (let c = 0; c < cols; c++) {
        const x = marginX + c * stepX;
        ctx.beginPath();
        ctx.moveTo(x, marginY);
        ctx.lineTo(x, this.height - marginY);
        ctx.strokeStyle = `rgba(168, 85, 247, 0.05)`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // Grid Intersection Tensor Nodes
      for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows; r++) {
          const x = marginX + c * stepX;
          const y = marginY + r * stepY;
          const act = Math.sin(t * 2 + c * 0.7 + r * 0.9) * 0.5 + 0.5;

          ctx.beginPath();
          ctx.rect(x - 3, y - 3, 6, 6);
          ctx.fillStyle = act > 0.6 ? `rgba(6, 182, 212, 0.5)` : `rgba(148, 163, 184, 0.15)`;
          ctx.fill();

          if (act > 0.85) {
            ctx.beginPath();
            ctx.arc(x, y, 12, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(6, 182, 212, 0.25)`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }
    }

    renderHardwareSubstrates(t: number) {
      const ctx = this.ctx;

      // Render Silicon Circuit Traces (Level Zero / Poplar Bus)
      this.circuits.forEach(c => {
        c.pulsePos += c.speed;
        if (c.pulsePos > 1) c.pulsePos = 0;

        ctx.beginPath();
        if (c.dir === 'h') {
          ctx.moveTo(c.x, c.y);
          ctx.lineTo(c.x + c.len, c.y);
          ctx.strokeStyle = 'rgba(244, 63, 94, 0.08)';
          ctx.lineWidth = 1.2;
          ctx.stroke();

          // Silicon clock electron pulse
          const px = c.x + c.len * c.pulsePos;
          ctx.beginPath();
          ctx.arc(px, c.y, 2, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(251, 191, 36, 0.8)';
          ctx.fill();
        } else {
          ctx.moveTo(c.x, c.y);
          ctx.lineTo(c.x, c.y + c.len);
          ctx.strokeStyle = 'rgba(244, 63, 94, 0.08)';
          ctx.lineWidth = 1.2;
          ctx.stroke();

          const py = c.y + c.len * c.pulsePos;
          ctx.beginPath();
          ctx.arc(c.x, py, 2, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(244, 63, 94, 0.8)';
          ctx.fill();
        }
      });

      // Register Block Matrix Clusters
      const cx = this.width * 0.7;
      const cy = this.height * 0.45;
      for (let i = 0; i < 4; i++) {
        for (let j = 0; j < 4; j++) {
          const bx = cx + i * 22;
          const by = cy + j * 22;
          const active = ((Math.floor(t * 4) + i * 2 + j) % 5 === 0);

          ctx.beginPath();
          ctx.rect(bx, by, 16, 16);
          ctx.fillStyle = active ? 'rgba(244, 63, 94, 0.25)' : 'rgba(255, 255, 255, 0.02)';
          ctx.strokeStyle = active ? 'rgba(251, 191, 36, 0.5)' : 'rgba(244, 63, 94, 0.12)';
          ctx.lineWidth = 1;
          ctx.fill();
          ctx.stroke();
        }
      }
    }
  }

  // Initialize all instances
  document.querySelectorAll('.division-bg-overlay-wrapper').forEach(el => {
    new DivisionOverlayRenderer(el as HTMLElement);
  });
</script>
