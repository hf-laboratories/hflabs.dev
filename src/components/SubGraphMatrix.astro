---
// SubGraphMatrix.astro
import subgraphsData from '../data/subgraphs.json';

const { summary, tiers } = subgraphsData;
---

<section id="subgraphs" class="subgraphs-section">
  <div class="container-wide">
    <!-- Header Banner -->
    <div class="matrix-header">
      <div class="matrix-badge-row">
        <span class="spatial-badge">SPATIAL SUBGRAPH MAP</span>
        <span class="count-badge">51 ARCHITECTURAL TILES</span>
      </div>
      <h2 class="matrix-title">{summary.title}</h2>
      <p class="matrix-subtitle">
        <span class="sub-highlight">{summary.subtitle}</span>
      </p>
      <div class="matrix-meta-bar">
        <span class="pass-info">{summary.meta}</span>
        <div class="tier-nav-buttons">
          <button class="filter-btn active" data-tier-filter="all">All 51 Sub-Graphs</button>
          <button class="filter-btn" data-tier-filter="free">Free (10)</button>
          <button class="filter-btn" data-tier-filter="pro">Pro (14)</button>
          <button class="filter-btn" data-tier-filter="high-assurance">High Assurance (27)</button>
        </div>
      </div>
    </div>

    <!-- Tiers Container -->
    <div class="tiers-wrapper">
      {tiers.map((tier) => (
        <div class="tier-group" id={`tier-group-${tier.id}`} data-tier={tier.id}>
          <div class="tier-section-bar" style={`--tier-col: ${tier.color}; --tier-accent: ${tier.accentColor}`}>
            <span class="tier-pipe" style={`background: ${tier.color}; box-shadow: 0 0 10px ${tier.color};`}></span>
            <h3 class="tier-header-title">{tier.name} <span class="tier-count-dash">—</span> <span class="tier-badge-pill" style={`color: ${tier.color}; border-color: ${tier.color}4D; background: ${tier.color}15;`}>{tier.badge}</span></h3>
          </div>

          <div class="tiles-grid">
            {tier.subgraphs.map((g) => (
              <div class={`subgraph-tile type-${g.type} theme-${g.theme || g.diagramType}`} data-subgraph-id={g.id} style={`--accent-glow: ${tier.color};`}>
                <div class="tile-inner">
                  <!-- Visual canvas / diagram display -->
                  <div class="tile-visual">
                    {g.id === 'agent-memory' && (
                      <div class="vis-canvas vis-agent-memory">
                        <div class="memory-orb">
                          <div class="orb-core"></div>
                          <div class="orb-ring ring-1"></div>
                          <div class="orb-ring ring-2"></div>
                          <div class="radial-spokes"></div>
                        </div>
                        <span class="vis-watermark">AGENT MEMORY</span>
                      </div>
                    )}

                    {g.id === 'codebase-topology' && (
                      <div class="vis-canvas vis-codebase-topology">
                        <div class="wireframe-terrain">
                          <svg viewBox="0 0 160 90" class="terrain-svg">
                            <path d="M 10,75 L 35,55 L 60,65 L 85,35 L 110,50 L 135,25 L 150,45" fill="none" stroke="#38bdf8" stroke-width="1.5" />
                            <path d="M 10,75 L 35,45 L 70,30 L 95,20 L 125,40 L 150,30" fill="none" stroke="#818cf8" stroke-width="1" stroke-dasharray="2,2" />
                            <path d="M 10,85 L 45,70 L 80,60 L 115,55 L 150,65" fill="none" stroke="#06b6d4" stroke-width="1" />
                            <line x1="85" y1="35" x2="85" y2="85" stroke="rgba(56,189,248,0.4)" stroke-width="1" stroke-dasharray="1,2" />
                            <circle cx="85" cy="35" r="3" fill="#38bdf8" />
                            <circle cx="135" cy="25" r="3" fill="#f59e0b" />
                          </svg>
                        </div>
                        <span class="vis-watermark">CODEBASE TOPOLOGY</span>
                      </div>
                    )}

                    {g.id === 'github-provenance' && (
                      <div class="vis-canvas vis-github-provenance">
                        <div class="shield-badge-ui">
                          <div class="cyber-shield">
                            <span class="shield-icon">🛡️</span>
                          </div>
                          <div class="pipeline-links">
                            <span class="pipe-node active"></span>
                            <span class="pipe-line"></span>
                            <span class="pipe-node"></span>
                          </div>
                        </div>
                        <span class="vis-watermark">GITHUB PROVENANCE</span>
                      </div>
                    )}

                    {g.id === 'continuous-tasks' && (
                      <div class="vis-canvas vis-continuous-tasks">
                        <div class="dag-pipeline-vis">
                          <div class="dag-column">
                            <span class="dag-node completed"></span>
                            <span class="dag-node active-pulse"></span>
                          </div>
                          <div class="dag-line-group">
                            <svg viewBox="0 0 80 40">
                              <path d="M 10,12 L 40,20 L 70,28" stroke="#10b981" stroke-width="1.5" fill="none" />
                              <path d="M 10,28 L 40,20 L 70,12" stroke="#38bdf8" stroke-width="1.5" fill="none" />
                            </svg>
                          </div>
                          <div class="dag-column">
                            <span class="dag-node pending"></span>
                            <span class="dag-node pending"></span>
                          </div>
                        </div>
                        <span class="vis-watermark">CONTINUOUS TASKS</span>
                      </div>
                    )}

                    {g.id === 'agent-blender' && (
                      <div class="vis-canvas vis-agent-blender">
                        <div class="cyber-avatar">
                          <div class="avatar-wireframe">
                            <div class="head-poly"></div>
                            <div class="torso-mesh"></div>
                            <div class="blend-rings"></div>
                          </div>
                        </div>
                        <span class="vis-watermark">AGENT BLENDER</span>
                      </div>
                    )}

                    {g.id === 'code-semantics' && (
                      <div class="vis-canvas vis-code-semantics">
                        <div class="ast-core-blast">
                          <div class="ast-sun"></div>
                          <div class="blast-radius-ring"></div>
                          <div class="ast-sparks"></div>
                        </div>
                        <span class="vis-watermark">CODE SEMANTICS</span>
                      </div>
                    )}

                    {g.id === 'directive-sync' && (
                      <div class="vis-canvas vis-directive-sync">
                        <div class="dual-agent-bridge">
                          <div class="agent-box a">AGENT A</div>
                          <div class="sync-stream">
                            <span class="sync-dot d1"></span>
                            <span class="sync-dot d2"></span>
                          </div>
                          <div class="agent-box b">AGENT B</div>
                        </div>
                        <span class="vis-watermark">DIRECTIVE SYNC</span>
                      </div>
                    )}

                    {g.id === 'skill-blender' && (
                      <div class="vis-canvas vis-skill-blender">
                        <div class="fusion-reactor">
                          <div class="fusion-plasma"></div>
                          <div class="skill-orbits"></div>
                          <span class="skill-label-gold">SKILL</span>
                        </div>
                        <span class="vis-watermark">SKILL BLENDER</span>
                      </div>
                    )}

                    {g.id === 'hardware-topology' && (
                      <div class="vis-canvas vis-hw-topology">
                        <div class="hw-pcb-grid">
                          <div class="numa-socket s1">NUMA 0</div>
                          <div class="pcie-bus">PCIe Gen5</div>
                          <div class="numa-socket s2">NUMA 1</div>
                        </div>
                        <span class="vis-watermark">HARDWARE TOPOLOGY</span>
                      </div>
                    )}

                    {g.id === 'level-0-acceleration' && (
                      <div class="vis-canvas vis-level-zero">
                        <div class="l0-execution-core">
                          <div class="l0-chip">LEVEL 0</div>
                          <div class="l0-glow-rays"></div>
                        </div>
                        <span class="vis-watermark">LEVEL 0 ACCELERATION</span>
                      </div>
                    )}

                    {g.id === 'multi-domain-ontology' && (
                      <div class="vis-canvas vis-ontology">
                        <div class="pyramid-structure">
                          <div class="pyr-level top"></div>
                          <div class="pyr-level mid"></div>
                          <div class="pyr-level base"></div>
                        </div>
                        <span class="vis-watermark">MULTI-DOMAIN ONTOLOGY</span>
                      </div>
                    )}

                    {g.id === 'bess-sharding' && (
                      <div class="vis-canvas vis-bess">
                        <div class="bess-neon-core">
                          <div class="bess-hexagon"></div>
                          <div class="bess-pulse-nodes"></div>
                        </div>
                        <span class="vis-watermark">BESS SHARDING</span>
                      </div>
                    )}

                    {g.id === 'formal-invariants' && (
                      <div class="vis-canvas vis-formal-invariants">
                        <div class="proof-card">
                          <code>PROOF CONTRACT<br/>∀x ∈ G: Inv(x) ⇒ □Valid</code>
                        </div>
                        <span class="vis-watermark">FORMAL INVARIANTS</span>
                      </div>
                    )}

                    {g.id === 'pixie-swarm-mesh' && (
                      <div class="vis-canvas vis-pixie-swarm">
                        <div class="pixie-organic-mesh">
                          <div class="biolum-cap"></div>
                          <div class="mesh-filaments"></div>
                        </div>
                        <span class="vis-watermark">PIXIE SWARM MESH</span>
                      </div>
                    )}

                    {g.id === 'dynamic-world-model' && (
                      <div class="vis-canvas vis-world-model">
                        <div class="world-orbit-system">
                          <div class="world-planet"></div>
                          <div class="orbit-path">
                            <span class="satellite-node"></span>
                          </div>
                        </div>
                        <span class="vis-watermark">DYNAMIC WORLD MODEL</span>
                      </div>
                    )}

                    {g.id === 'sovereign-air-gap' && (
                      <div class="vis-canvas vis-air-gap">
                        <div class="mls-clearance-box">
                          <span class="mls-tag unclass">UNCLASSIFIED</span>
                          <span class="mls-tag secret">SECRET</span>
                          <span class="mls-tag topsecret">TOP SECRET</span>
                        </div>
                        <span class="vis-watermark">SOVEREIGN AIR-GAP</span>
                      </div>
                    )}

                    {g.id === 'sbom-provenance' && (
                      <div class="vis-canvas vis-sbom">
                        <div class="sbom-ledger-ui">
                          <div class="spdx-row"><span class="sig-valid">✓</span> SPDX-2.3</div>
                          <div class="spdx-row"><span class="sig-valid">✓</span> CYCLONEDX</div>
                          <div class="spdx-row"><span class="sig-valid">✓</span> SHA256 ROOT</div>
                        </div>
                        <span class="vis-watermark">SBOM PROVENANCE</span>
                      </div>
                    )}

                    {g.id === 'capability-sandbox' && (
                      <div class="vis-canvas vis-sandbox">
                        <div class="sandbox-barrier">
                          <div class="sandbox-inner-core">SECCOMP</div>
                          <div class="isolation-wall"></div>
                        </div>
                        <span class="vis-watermark">CAPABILITY SANDBOX</span>
                      </div>
                    )}

                    {g.id === 'threat-surface' && (
                      <div class="vis-canvas vis-threat">
                        <div class="threat-radar-scope">
                          <div class="radar-sweep"></div>
                          <span class="threat-blip b1"></span>
                          <span class="threat-blip b2"></span>
                        </div>
                        <span class="vis-watermark">THREAT SURFACE</span>
                      </div>
                    )}

                    {g.id === 'compiler-mlir' && (
                      <div class="vis-canvas vis-mlir">
                        <div class="mlir-pipeline">
                          <span class="mlir-pill">AST</span>
                          <span class="mlir-arrow">→</span>
                          <span class="mlir-pill highlight">MLIR</span>
                          <span class="mlir-arrow">→</span>
                          <span class="mlir-pill">LLVM</span>
                        </div>
                        <span class="vis-watermark">COMPILER &amp; MLIR</span>
                      </div>
                    )}

                    {g.id === 'cognitive-bias' && (
                      <div class="vis-canvas vis-bias">
                        <div class="bias-gauge">
                          <div class="gauge-arc"></div>
                          <div class="gauge-needle"></div>
                          <span class="gauge-label">DRIFT: 0.002%</span>
                        </div>
                        <span class="vis-watermark">COGNITIVE BIAS</span>
                      </div>
                    )}

                    {g.id === 'formulaic-reasoning' && (
                      <div class="vis-canvas vis-formula">
                        <div class="math-proof-box">
                          <code>lim<sub>t→∞</sub> V(x) = 0<br/>||x - x*|| &lt; ε</code>
                        </div>
                        <span class="vis-watermark">FORMULAIC REASONING</span>
                      </div>
                    )}

                    {g.id === 'cost-carbon' && (
                      <div class="vis-canvas vis-carbon">
                        <div class="grid-carbon-map">
                          <div class="world-dots"></div>
                          <span class="carbon-metric">12 gCO2/kWh</span>
                        </div>
                        <span class="vis-watermark">COST &amp; CARBON</span>
                      </div>
                    )}

                    {g.id === 'regulatory-compliance' && (
                      <div class="vis-canvas vis-compliance">
                        <div class="compliance-badges-grid">
                          <span class="reg-chip">ISO 26262</span>
                          <span class="reg-chip">DO-178C</span>
                          <span class="reg-chip">EU AI ACT</span>
                          <span class="reg-chip">NIST 800-53</span>
                        </div>
                        <span class="vis-watermark">REGULATORY COMPLIANCE</span>
                      </div>
                    )}

                    {/* Generic Schematic Diagram Renderers for all structural Sub-Graphs */}
                    {g.type === 'diagram' && (
                      <div class="vis-canvas vis-diagram">
                        <svg viewBox="0 0 160 100" class="schematic-svg">
                          {g.diagramType === 'tree' && (
                            <g stroke="#38bdf8" stroke-width="1.5" fill="none">
                              <circle cx="80" cy="20" r="5" fill="#38bdf8" />
                              <circle cx="45" cy="55" r="4" fill="#06b6d4" />
                              <circle cx="115" cy="55" r="4" fill="#06b6d4" />
                              <circle cx="30" cy="85" r="3" fill="#10b981" />
                              <circle cx="60" cy="85" r="3" fill="#10b981" />
                              <circle cx="100" cy="85" r="3" fill="#10b981" />
                              <circle cx="130" cy="85" r="3" fill="#10b981" />
                              <line x1="80" y1="25" x2="45" y2="51" />
                              <line x1="80" y1="25" x2="115" y2="51" />
                              <line x1="45" y1="59" x2="30" y2="82" />
                              <line x1="45" y1="59" x2="60" y2="82" />
                              <line x1="115" y1="59" x2="100" y2="82" />
                              <line x1="115" y1="59" x2="130" y2="82" />
                            </g>
                          )}

                          {g.diagramType === 'cards' && (
                            <g stroke="#38bdf8" stroke-width="1.2" fill="rgba(15,23,42,0.8)">
                              <rect x="25" y="15" width="45" height="30" rx="3" />
                              <rect x="85" y="15" width="50" height="30" rx="3" />
                              <rect x="40" y="55" width="80" height="35" rx="3" stroke="#818cf8" />
                              <line x1="47" y1="45" x2="65" y2="55" stroke="rgba(56,189,248,0.5)" />
                              <line x1="110" y1="45" x2="95" y2="55" stroke="rgba(56,189,248,0.5)" />
                            </g>
                          )}

                          {g.diagramType === 'schema' && (
                            <g stroke="#38bdf8" stroke-width="1.2" fill="rgba(15,23,42,0.8)">
                              <rect x="20" y="15" width="50" height="28" rx="2" />
                              <rect x="90" y="15" width="50" height="28" rx="2" />
                              <rect x="55" y="60" width="50" height="28" rx="2" stroke="#10b981" />
                              <path d="M 45,43 L 45,50 L 70,50 L 70,60" stroke="#10b981" fill="none" />
                              <path d="M 115,43 L 115,50 L 90,50 L 90,60" stroke="#10b981" fill="none" />
                            </g>
                          )}

                          {g.diagramType === 'cluster' && (
                            <g fill="none">
                              <circle cx="80" cy="50" r="35" stroke="rgba(56,189,248,0.3)" stroke-dasharray="2,3" />
                              <circle cx="80" cy="50" r="6" fill="#38bdf8" />
                              <circle cx="55" cy="35" r="3.5" fill="#10b981" />
                              <circle cx="105" cy="35" r="3.5" fill="#10b981" />
                              <circle cx="60" cy="68" r="3.5" fill="#10b981" />
                              <circle cx="100" cy="68" r="3.5" fill="#10b981" />
                              <circle cx="120" cy="50" r="2.5" fill="#818cf8" />
                              <circle cx="40" cy="50" r="2.5" fill="#818cf8" />
                            </g>
                          )}

                          {g.diagramType === 'frame' && (
                            <g stroke="#38bdf8" stroke-width="1.2" fill="none">
                              <rect x="30" y="20" width="100" height="60" rx="3" stroke="rgba(56,189,248,0.6)" stroke-dasharray="3,3" />
                              <circle cx="55" cy="40" r="4" fill="#38bdf8" />
                              <circle cx="105" cy="40" r="4" fill="#38bdf8" />
                              <circle cx="80" cy="65" r="5" fill="#10b981" />
                              <line x1="55" y1="40" x2="80" y2="65" stroke="rgba(56,189,248,0.4)" />
                              <line x1="105" y1="40" x2="80" y2="65" stroke="rgba(56,189,248,0.4)" />
                            </g>
                          )}

                          {g.diagramType === 'crossed' && (
                            <g stroke="#38bdf8" stroke-width="1.5" fill="none">
                              <circle cx="50" cy="30" r="4" fill="#38bdf8" />
                              <circle cx="110" cy="30" r="4" fill="#38bdf8" />
                              <circle cx="50" cy="70" r="4" fill="#06b6d4" />
                              <circle cx="110" cy="70" r="4" fill="#06b6d4" />
                              <line x1="50" y1="30" x2="110" y2="70" stroke="#f43f5e" stroke-width="1.5" />
                              <line x1="50" y1="70" x2="110" y2="30" stroke="#10b981" stroke-width="1.5" stroke-dasharray="2,2" />
                            </g>
                          )}

                          {g.diagramType === 'tri-cluster' && (
                            <g fill="none">
                              <circle cx="50" cy="40" r="18" stroke="#818cf8" stroke-width="1" />
                              <circle cx="110" cy="40" r="18" stroke="#38bdf8" stroke-width="1" />
                              <circle cx="80" cy="75" r="18" stroke="#f43f5e" stroke-width="1" />
                              <circle cx="48" cy="38" r="2.5" fill="#818cf8" />
                              <circle cx="55" cy="44" r="2.5" fill="#818cf8" />
                              <circle cx="108" cy="38" r="2.5" fill="#38bdf8" />
                              <circle cx="115" cy="44" r="2.5" fill="#38bdf8" />
                              <circle cx="78" cy="73" r="2.5" fill="#f43f5e" />
                              <circle cx="84" cy="78" r="2.5" fill="#f43f5e" />
                            </g>
                          )}

                          {g.diagramType === 'nested-box' && (
                            <g stroke="#38bdf8" stroke-width="1.2" fill="rgba(15,23,42,0.6)">
                              <rect x="25" y="15" width="50" height="70" rx="3" stroke="#38bdf8" />
                              <rect x="85" y="15" width="50" height="70" rx="3" stroke="#818cf8" />
                              <circle cx="45" cy="35" r="2" fill="#38bdf8" />
                              <circle cx="55" cy="55" r="2" fill="#38bdf8" />
                              <circle cx="105" cy="35" r="2" fill="#818cf8" />
                              <circle cx="115" cy="55" r="2" fill="#818cf8" />
                            </g>
                          )}

                          {g.diagramType === 'bdi-flow' && (
                            <g stroke="#38bdf8" stroke-width="1" fill="rgba(15,23,42,0.8)">
                              <rect x="35" y="12" width="90" height="18" rx="2" stroke="#38bdf8" />
                              <rect x="35" y="40" width="90" height="18" rx="2" stroke="#f59e0b" />
                              <rect x="35" y="68" width="90" height="18" rx="2" stroke="#10b981" />
                              <text x="80" y="24" fill="#38bdf8" font-size="8" text-anchor="middle" font-family="monospace">BELIEF</text>
                              <text x="80" y="52" fill="#f59e0b" font-size="8" text-anchor="middle" font-family="monospace">DESIRE</text>
                              <text x="80" y="80" fill="#10b981" font-size="8" text-anchor="middle" font-family="monospace">INTENTION</text>
                            </g>
                          )}

                          {g.diagramType?.startsWith('plane-') && (
                            <g stroke="#38bdf8" stroke-width="1.2" fill="none">
                              {/* Isometric Layer Stack */}
                              <polygon points="80,15 140,32 80,48 20,32" stroke="rgba(56,189,248,0.3)" />
                              <polygon points="80,32 140,48 80,64 20,48" stroke="rgba(56,189,248,0.5)" />
                              <polygon points="80,50 140,66 80,82 20,66" stroke="#38bdf8" fill="rgba(56,189,248,0.1)" />
                              <circle cx="80" cy="66" r="3" fill="#38bdf8" />
                              <circle cx="60" cy="60" r="2.5" fill="#818cf8" />
                              <circle cx="100" cy="72" r="2.5" fill="#818cf8" />
                            </g>
                          )}

                          {g.diagramType === 'pattern-grid' && (
                            <g stroke="#38bdf8" stroke-width="1.2" fill="none">
                              <rect x="30" y="20" width="40" height="40" rx="3" stroke="#38bdf8" />
                              <rect x="90" y="40" width="40" height="40" rx="3" stroke="#f59e0b" />
                              <circle cx="50" cy="40" r="4" fill="#38bdf8" />
                              <circle cx="110" cy="60" r="4" fill="#f59e0b" />
                              <line x1="50" y1="40" x2="110" y2="60" stroke="#818cf8" stroke-dasharray="2,2" />
                            </g>
                          )}

                          {g.diagramType === 'matrix-heatmap' && (
                            <g>
                              <rect x="35" y="15" width="22" height="22" fill="#38bdf8" opacity="0.8" />
                              <rect x="60" y="15" width="22" height="22" fill="#38bdf8" opacity="0.3" />
                              <rect x="85" y="15" width="22" height="22" fill="#38bdf8" opacity="0.9" />
                              <rect x="35" y="40" width="22" height="22" fill="#38bdf8" opacity="0.2" />
                              <rect x="60" y="40" width="22" height="22" fill="#38bdf8" opacity="0.85" />
                              <rect x="85" y="40" width="22" height="22" fill="#38bdf8" opacity="0.4" />
                              <rect x="35" y="65" width="22" height="22" fill="#38bdf8" opacity="0.95" />
                              <rect x="60" y="65" width="22" height="22" fill="#38bdf8" opacity="0.5" />
                              <rect x="85" y="65" width="22" height="22" fill="#38bdf8" opacity="0.8" />
                            </g>
                          )}

                          {g.diagramType === 'kge-nodes' && (
                            <g stroke="#f59e0b" stroke-width="1.5" fill="none">
                              <circle cx="45" cy="45" r="5" fill="#f59e0b" />
                              <circle cx="115" cy="45" r="5" fill="#38bdf8" />
                              <line x1="50" y1="45" x2="110" y2="45" stroke="#f59e0b" stroke-dasharray="2,2" />
                              <polygon points="105,42 110,45 105,48" fill="#f59e0b" />
                              <text x="80" y="38" fill="#f59e0b" font-size="7" text-anchor="middle" font-family="monospace">r = t - h</text>
