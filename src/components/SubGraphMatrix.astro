<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const tierGroups = document.querySelectorAll('.tier-group');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedTier = btn.getAttribute('data-tier-filter');

      tierGroups.forEach((group) => {
        const groupTier = group.getAttribute('data-tier');
        if (selectedTier === 'all' || groupTier === selectedTier) {
          (group as HTMLElement).style.display = 'flex';
        } else {
          (group as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
