<script>
  import { SWARM_ATLAS } from '../data/swarmAtlas';

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('swarmSearchInput') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clearSwarmSearch') as HTMLButtonElement | null;
    const legendPills = document.querySelectorAll<HTMLButtonElement>('.atlas-legend-bar .legend-pill');
    const tileCards = document.querySelectorAll<HTMLDivElement>('.swarm-tile-card');
    
    // Modal elements
    const modalBackdrop = document.getElementById('swarmModalBackdrop');
    const closeBtn = document.getElementById('closeSwarmModal');
    const modalCategoryBadge = document.getElementById('modalCategoryBadge');
    const modalKernelCode = document.getElementById('modalKernelCode');
    const modalAlgoTitle = document.getElementById('modalAlgoTitle');
    const modalAlgoSub = document.getElementById('modalAlgoSub');
    const modalAlgoDesc = document.getElementById('modalAlgoDesc');
    const modalFormula = document.getElementById('modalFormula');
    const modalParamsList = document.getElementById('modalParamsList');
    const modalGpuKernel = document.getElementById('modalGpuKernel');
    const modalCsharp = document.getElementById('modalCsharp');
    const copyKernelBtn = document.getElementById('copyKernelBtn');
    const copyCsharpBtn = document.getElementById('copyCsharpBtn');

    let currentFilter = 'all';
    let currentSearch = '';

    function updateVisibility() {
      tileCards.forEach(card => {
        const category = card.getAttribute('data-category') || '';
        const searchPayload = card.getAttribute('data-search') || '';

        const matchesFilter = (currentFilter === 'all') || (category === currentFilter);
        const matchesSearch = (!currentSearch) || (searchPayload.includes(currentSearch));

        if (matchesFilter && matchesSearch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Filter pills click
    legendPills.forEach(pill => {
      pill.addEventListener('click', () => {
        legendPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.getAttribute('data-filter') || 'all';
        updateVisibility();
      });
    });

    // Search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
        if (clearBtn) {
          clearBtn.style.display = currentSearch ? 'block' : 'none';
        }
        updateVisibility();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentSearch = '';
        clearBtn.style.display = 'none';
        updateVisibility();
        searchInput.focus();
      });
    }

    // Open Modal on tile click
    tileCards.forEach(card => {
      card.addEventListener('click', () => {
        const algoId = card.getAttribute('data-algo-id');
        const data = SWARM_ATLAS.find(t => t.id === algoId);
        if (!data || !modalBackdrop) return;

        if (modalCategoryBadge) {
          modalCategoryBadge.textContent = data.category;
          modalCategoryBadge.style.color = data.color;
          modalCategoryBadge.style.borderColor = `${data.color}40`;
          modalCategoryBadge.style.background = `${data.color}15`;
        }
        if (modalKernelCode) modalKernelCode.textContent = data.code;
        if (modalAlgoTitle) modalAlgoTitle.textContent = data.name;
        if (modalAlgoSub) modalAlgoSub.textContent = data.subTitle;
        if (modalAlgoDesc) modalAlgoDesc.textContent = data.description;
        if (modalFormula) modalFormula.textContent = data.formula;
        if (modalGpuKernel) modalGpuKernel.textContent = data.gpuKernel;
        if (modalCsharp) modalCsharp.textContent = data.csharpSignature;

        if (modalParamsList) {
          modalParamsList.innerHTML = data.parameters.map(p => `
            <div class="param-row">
              <span class="param-name"><code>${p.name}</code></span>
              <span class="param-def">${p.default}</span>
              <span class="param-desc">${p.desc}</span>
            </div>
          `).join('');
        }

        modalBackdrop.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });

    // Close Modal
    function closeModal() {
      if (modalBackdrop) {
        modalBackdrop.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalBackdrop?.style.display === 'flex') {
        closeModal();
      }
    });

    // Copy buttons
    if (copyKernelBtn && modalGpuKernel) {
      copyKernelBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(modalGpuKernel.textContent || '');
        copyKernelBtn.textContent = 'Copied!';
        setTimeout(() => copyKernelBtn.textContent = 'Copy', 2000);
      });
    }

    if (copyCsharpBtn && modalCsharp) {
      copyCsharpBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(modalCsharp.textContent || '');
        copyCsharpBtn.textContent = 'Copied!';
        setTimeout(() => copyCsharpBtn.textContent = 'Copy', 2000);
      });
    }
  });
</script>

