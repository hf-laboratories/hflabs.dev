---
// src/components/SwarmTilesGallery.astro
// Visual 35 Swarm Optimizer Tile Matrix matching the official HFLabs blueprint infographic.
import { SWARM_ATLAS, SWARM_CATEGORIES } from '../data/swarmAtlas';
---

<div class="swarm-blueprint-container" id="swarm-atlas">
  <!-- Blueprint Header -->
  <div class="blueprint-main-header">
    <div class="header-left">
      <div class="atlas-badge-row">
        <span class="atlas-status-badge">HYPERSWARM 35-OPTIMIZER ENGINE</span>
        <span class="atlas-status-badge">LEVEL ZERO SPIR-V OFFLOAD</span>
      </div>
      <h2 class="bp-title">SWARM &amp; METAHEURISTIC ATLAS</h2>
      <p class="bp-subtitle">
        <strong>35 verified optimizers</strong> &bull; 11 Core Swarms &bull; 14 Hybrids &bull; 7 Advanced Metaheuristics &bull; 3 Multi-Objective
      </p>
      <span class="bp-caption">Exact mathematical models in <code>HyperSwarm.Optimizers</code> &mdash; Click any tile to inspect parameters and GPU kernels</span>
    </div>

    <!-- Live Search Box -->
    <div class="atlas-search-box">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="swarmSearchInput" 
        placeholder="Filter 35 optimizers, formulas, or kernels..." 
        aria-label="Filter swarm algorithms"
      />
      <button id="clearSwarmSearch" class="clear-search-btn" title="Clear search" style="display:none;">&times;</button>
    </div>
  </div>

  <!-- Category Legend / Filter Pills -->
  <div class="atlas-legend-bar">
    <button class="legend-pill active" data-filter="all">
      <span class="pill-dot all-dot"></span>
      <span class="pill-text">ALL OPTIMIZERS</span>
      <span class="pill-count">35</span>
    </button>

    <button class="legend-pill" data-filter="core">
      <span class="pill-dot" style="background:#00e5ff; box-shadow:0 0 8px #00e5ff;"></span>
      <span class="pill-text">CORE SWARM</span>
      <span class="pill-count">11</span>
    </button>

    <button class="legend-pill" data-filter="hybrid">
      <span class="pill-dot" style="background:#a855f7; box-shadow:0 0 8px #a855f7;"></span>
      <span class="pill-text">HYBRIDS</span>
      <span class="pill-count">14</span>
    </button>

    <button class="legend-pill" data-filter="advanced">
      <span class="pill-dot" style="background:#f43f5e; box-shadow:0 0 8px #f43f5e;"></span>
      <span class="pill-text">ADVANCED</span>
      <span class="pill-count">7</span>
    </button>

    <button class="legend-pill" data-filter="mo">
      <span class="pill-dot" style="background:#84cc16; box-shadow:0 0 8px #84cc16;"></span>
      <span class="pill-text">MULTI-OBJECTIVE</span>
      <span class="pill-count">3</span>
    </button>
  </div>

  <!-- Tiles Grid Canvas -->
  <div class="swarm-tiles-grid" id="swarmTilesGrid">
    {SWARM_ATLAS.map((tile, index) => (
      <div 
        class={`swarm-tile-card tile-category-${tile.categoryKey}`}
        data-category={tile.categoryKey}
        data-algo-id={tile.id}
        data-search={`${tile.name} ${tile.code} ${tile.category} ${tile.subTitle} ${tile.description} ${tile.gpuKernel}`.toLowerCase()}
        style={`--tile-color:${tile.color}; --tile-glow:${tile.glowColor};`}
        role="button"
        tabindex="0"
        aria-label={`Inspect ${tile.name}`}
      >
        <!-- Corner Reticles -->
        <div class="tile-bracket tl"></div>
        <div class="tile-bracket tr"></div>
        <div class="tile-bracket bl"></div>
        <div class="tile-bracket br"></div>

        <!-- Header Tag -->
        <div class="tile-tag-header">
          <span class="tile-tag-text">{tile.category}</span>
          <span class="tile-idx">#{String(index + 1).padStart(2, '0')}</span>
        </div>

        <!-- Central Vector Blueprint Canvas -->
        <div class="tile-visual-screen">
          <svg class="tile-screen-svg" viewBox="0 0 160 110" preserveAspectRatio="xMidYMid meet">
            <defs>
              <pattern id={`sgrid-${tile.id}`} width="16" height="16" patternUnits="userSpaceOnUse">
                <path d="M 16 0 L 0 0 0 16" fill="none" stroke={tile.color} stroke-opacity="0.08" stroke-width="0.75"/>
              </pattern>
              <radialGradient id={`sglow-${tile.id}`} cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color={tile.color} stop-opacity="0.22" />
                <stop offset="100%" stop-color={tile.color} stop-opacity="0" />
              </radialGradient>
            </defs>

            <rect width="160" height="110" fill={`url(#sgrid-${tile.id})`} />
            <rect width="160" height="110" fill={`url(#sglow-${tile.id})`} />

            <!-- 1: PSO Orbits -->
            {tile.visualType === "orbits" && (
              <g class="v-orbits">
                <ellipse cx="80" cy="55" rx="65" ry="38" fill="none" stroke="rgba(0, 229, 255, 0.2)" stroke-width="1" stroke-dasharray="2 3" />
                <ellipse cx="80" cy="55" rx="45" ry="25" fill="none" stroke="rgba(0, 229, 255, 0.35)" stroke-width="1" />
                <ellipse cx="80" cy="55" rx="25" ry="14" fill="none" stroke="rgba(0, 229, 255, 0.5)" stroke-width="1" />
                <line x1="80" y1="55" x2="135" y2="35" stroke="rgba(0,229,255,0.4)" stroke-width="0.75" />
                <line x1="80" y1="55" x2="30" y2="70" stroke="rgba(0,229,255,0.4)" stroke-width="0.75" />
                <line x1="80" y1="55" x2="110" y2="85" stroke="rgba(0,229,255,0.4)" stroke-width="0.75" />
                <line x1="80" y1="55" x2="45" y2="30" stroke="rgba(0,229,255,0.4)" stroke-width="0.75" />
                <circle cx="135" cy="35" r="2.5" fill="#00e5ff" />
                <circle cx="30" cy="70" r="2" fill="#00e5ff" />
                <circle cx="110" cy="85" r="2.5" fill="#00e5ff" />
                <circle cx="45" cy="30" r="2" fill="#00e5ff" />
                <polygon points="80,48 82,53 87,53 83,56 85,61 80,58 75,61 77,56 73,53 78,53" fill="#ffffff" filter="drop-shadow(0 0 4px #00e5ff)" />
              </g>
            )}

            <!-- 2: ACO Pheromones -->
            {tile.visualType === "pheromones" && (
              <g class="v-pheromones">
                <line x1="25" y1="55" x2="60" y2="25" stroke="rgba(0,229,255,0.2)" stroke-width="1" />
                <line x1="25" y1="55" x2="60" y2="85" stroke="rgba(0,229,255,0.2)" stroke-width="1" />
                <line x1="60" y1="25" x2="100" y2="25" stroke="rgba(0,229,255,0.25)" stroke-width="1" />
                <line x1="60" y1="85" x2="100" y2="85" stroke="rgba(0,229,255,0.25)" stroke-width="1" />
                <line x1="100" y1="25" x2="135" y2="55" stroke="rgba(0,229,255,0.2)" stroke-width="1" />
                <line x1="100" y1="85" x2="135" y2="55" stroke="rgba(0,229,255,0.2)" stroke-width="1" />
                <line x1="25" y1="55" x2="135" y2="55" stroke="#00e5ff" stroke-width="3" filter="drop-shadow(0 0 6px #00e5ff)" />
                <circle cx="25" cy="55" r="4" fill="#38bdf8" />
                <circle cx="60" cy="25" r="3" fill="rgba(0,229,255,0.6)" />
                <circle cx="60" cy="85" r="3" fill="rgba(0,229,255,0.6)" />
                <circle cx="100" cy="25" r="3" fill="rgba(0,229,255,0.6)" />
                <circle cx="100" cy="85" r="3" fill="rgba(0,229,255,0.6)" />
                <circle cx="135" cy="55" r="5" fill="#ffffff" filter="drop-shadow(0 0 6px #00e5ff)" />
              </g>
            )}

            <!-- 3: BCO Hexgrid -->
            {tile.visualType === "hexgrid" && (
              <g class="v-hexgrid" transform="translate(30, 20)">
                <polygon points="20,5 30,0 40,5 40,15 30,20 20,15" fill="rgba(0,229,255,0.2)" stroke="#00e5ff" stroke-width="1"/>
                <polygon points="40,5 50,0 60,5 60,15 50,20 40,15" fill="rgba(0,229,255,0.6)" stroke="#00e5ff" stroke-width="1.5" filter="drop-shadow(0 0 4px #00e5ff)"/>
                <polygon points="60,5 70,0 80,5 80,15 70,20 60,15" fill="rgba(0,229,255,0.25)" stroke="#00e5ff" stroke-width="1"/>
                <polygon points="10,20 20,15 30,20 30,30 20,35 10,30" fill="rgba(0,229,255,0.4)" stroke="#00e5ff" stroke-width="1"/>
                <polygon points="30,20 40,15 50,20 50,30 40,35 30,30" fill="rgba(0,229,255,0.8)" stroke="#00e5ff" stroke-width="1.5"/>
                <polygon points="50,20 60,15 70,20 70,30 60,35 50,30" fill="rgba(0,229,255,0.5)" stroke="#00e5ff" stroke-width="1"/>
                <path d="M75,35 L82,45 L78,55 L90,65" fill="none" stroke="#ffffff" stroke-width="2" />
              </g>
            )}

            <!-- 4: Bat Echolocation -->
            {tile.visualType === "echolocation" && (
              <g class="v-echolocation">
                <path d="M25,55 L35,45 L42,52 L48,55 L42,58 L35,65 Z" fill="#00e5ff" filter="drop-shadow(0 0 4px #00e5ff)" />
                <path d="M55,30 A40,40 0 0,1 55,80" fill="none" stroke="rgba(0,229,255,0.4)" stroke-width="1" />
                <path d="M75,20 A60,60 0 0,1 75,90" fill="none" stroke="rgba(0,229,255,0.5)" stroke-width="1.25" />
                <path d="M98,12 A85,85 0 0,1 98,98" fill="none" stroke="rgba(0,229,255,0.7)" stroke-width="1.5" />
                <path d="M122,5 A110,110 0 0,1 122,105" fill="none" stroke="rgba(0,229,255,0.9)" stroke-width="1.75" />
                <circle cx="85" cy="35" r="2" fill="#38bdf8" />
                <circle cx="110" cy="65" r="2.5" fill="#00e5ff" />
                <circle cx="130" cy="40" r="2" fill="#ffffff" />
              </g>
            )}

            <!-- 5: GWO Pack -->
            {tile.visualType === "pack" && (
              <g class="v-pack">
                <circle cx="80" cy="55" r="45" fill="none" stroke="rgba(0,229,255,0.2)" stroke-width="1" stroke-dasharray="3 3" />
                <circle cx="80" cy="55" r="30" fill="none" stroke="rgba(0,229,255,0.35)" stroke-width="1" />
                <circle cx="80" cy="55" r="4" fill="#ffffff" filter="drop-shadow(0 0 5px #00e5ff)" />
                <g transform="translate(80, 25)"><circle cx="0" cy="0" r="6" fill="#00e5ff"/><text x="0" y="3" font-size="8" font-family="monospace" font-weight="bold" fill="#060911" text-anchor="middle">α</text></g>
                <g transform="translate(115, 65)"><circle cx="0" cy="0" r="6" fill="#38bdf8"/><text x="0" y="3" font-size="8" font-family="monospace" font-weight="bold" fill="#060911" text-anchor="middle">β</text></g>
                <g transform="translate(45, 65)"><circle cx="0" cy="0" r="6" fill="#38bdf8"/><text x="0" y="3" font-size="8" font-family="monospace" font-weight="bold" fill="#060911" text-anchor="middle">δ</text></g>
              </g>
            )}

            <!-- 6: Fish School -->
            {tile.visualType === "school" && (
              <g class="v-school">
                <path d="M40,30 Q80,20 120,40 Q130,80 90,90 Q40,90 35,55" fill="none" stroke="rgba(0,229,255,0.15)" stroke-width="1" stroke-dasharray="2 2" />
                <g transform="translate(45, 35) rotate(-20)"><path d="M-6,0 L2,-4 L0,0 L2,4 Z" fill="#00e5ff"/></g>
                <g transform="translate(70, 25) rotate(10)"><path d="M-6,0 L2,-4 L0,0 L2,4 Z" fill="#00e5ff"/></g>
                <g transform="translate(95, 30) rotate(35)"><path d="M-6,0 L2,-4 L0,0 L2,4 Z" fill="#00e5ff"/></g>
                <g transform="translate(120, 50) rotate(75)"><path d="M-6,0 L2,-4 L0,0 L2,4 Z" fill="#38bdf8"/></g>
                <g transform="translate(85, 88) rotate(175)"><path d="M-6,0 L2,-4 L0,0 L2,4 Z" fill="#00e5ff"/></g>
                <g transform="translate(75, 55) rotate(20)"><path d="M-7,0 L3,-5 L1,0 L3,5 Z" fill="#ffffff" filter="drop-shadow(0 0 4px #00e5ff)"/></g>
              </g>
            )}

            <!-- 7: Firefly Luminescence -->
            {tile.visualType === "luminescence" && (
              <g class="v-luminescence">
                <line x1="40" y1="30" x2="80" y2="40" stroke="rgba(0,229,255,0.4)" stroke-width="1"/>
                <line x1="80" y1="40" x2="125" y2="30" stroke="rgba(0,229,255,0.3)" stroke-width="1"/>
                <line x1="80" y1="40" x2="110" y2="75" stroke="rgba(0,229,255,0.6)" stroke-width="1.5"/>
                <line x1="50" y1="80" x2="110" y2="75" stroke="rgba(0,229,255,0.5)" stroke-width="1.25"/>
                <circle cx="40" cy="30" r="3" fill="#00e5ff" filter="drop-shadow(0 0 3px #00e5ff)" />
                <circle cx="125" cy="30" r="2.5" fill="#38bdf8" />
                <circle cx="50" cy="80" r="3" fill="#00e5ff" />
                <circle cx="80" cy="40" r="4.5" fill="#ffffff" filter="drop-shadow(0 0 6px #00e5ff)" />
                <circle cx="110" cy="75" r="5" fill="#ffffff" filter="drop-shadow(0 0 8px #00e5ff)" />
              </g>
            )}

            <!-- 8: Glowworm Luciferin -->
            {tile.visualType === "luciferin" && (
              <g class="v-luciferin">
                <circle cx="50" cy="45" r="24" fill="rgba(0,229,255,0.06)" stroke="rgba(0,229,255,0.3)" stroke-dasharray="2 2"/>
                <circle cx="105" cy="40" r="28" fill="rgba(0,229,255,0.08)" stroke="rgba(0,229,255,0.4)" stroke-dasharray="2 2"/>
                <circle cx="80" cy="75" r="22" fill="rgba(0,229,255,0.05)" stroke="rgba(0,229,255,0.25)" stroke-dasharray="2 2"/>
                <circle cx="50" cy="45" r="3.5" fill="#00e5ff" filter="drop-shadow(0 0 5px #00e5ff)"/>
                <circle cx="105" cy="40" r="4.5" fill="#ffffff" filter="drop-shadow(0 0 8px #00e5ff)"/>
                <circle cx="80" cy="75" r="3" fill="#38bdf8" filter="drop-shadow(0 0 4px #00e5ff)"/>
              </g>
            )}

            <!-- 9: Cuckoo Search Lévy -->
            {tile.visualType === "levy" && (
              <g class="v-levy">
                <path d="M25,85 L40,80 L48,82 L55,75 L60,78 L95,35 L105,42 L135,25" fill="none" stroke="#00e5ff" stroke-width="1.5" stroke-dasharray="2 2" />
                <ellipse cx="25" cy="85" rx="5" ry="3" fill="none" stroke="rgba(0,229,255,0.5)" />
                <ellipse cx="60" cy="78" rx="5" ry="3" fill="none" stroke="rgba(0,229,255,0.5)" />
                <ellipse cx="95" cy="35" rx="5" ry="3" fill="none" stroke="rgba(0,229,255,0.5)" />
                <ellipse cx="135" cy="25" rx="6" ry="4" fill="rgba(0,229,255,0.2)" stroke="#00e5ff" />
                <polygon points="135,18 137,23 142,23 138,26 140,31 135,28 130,31 132,26 128,23 133,23" fill="#ffffff" filter="drop-shadow(0 0 6px #00e5ff)" />
              </g>
            )}

            <!-- 10: Krill Herd 3D Vectors -->
            {tile.visualType === "vectors3d" && (
              <g class="v-vectors3d">
                <line x1="80" y1="55" x2="135" y2="35" stroke="rgba(0,229,255,0.4)" stroke-width="1.2" />
                <line x1="80" y1="55" x2="30" y2="40" stroke="rgba(0,229,255,0.4)" stroke-width="1.2" />
                <line x1="80" y1="55" x2="80" y2="98" stroke="rgba(0,229,255,0.4)" stroke-width="1.2" />
                <line x1="80" y1="55" x2="110" y2="75" stroke="#00e5ff" stroke-width="1.5" />
                <line x1="80" y1="55" x2="50" y2="70" stroke="#00e5ff" stroke-width="1.5" />
                <line x1="80" y1="55" x2="95" y2="25" stroke="#00e5ff" stroke-width="1.5" />
                <polygon points="80,48 82,53 87,53 83,56 85,61 80,58 75,61 77,56 73,53 78,53" fill="#ffffff" filter="drop-shadow(0 0 6px #00e5ff)" />
              </g>
            )}

            <!-- 11: Synchronizing Firefly Oscillators -->
            {tile.visualType === "oscillators" && (
              <g class="v-oscillators">
                <circle cx="80" cy="35" r="22" fill="none" stroke="rgba(0,229,255,0.3)" stroke-dasharray="2 3" />
                <circle cx="80" cy="13" r="2.5" fill="#00e5ff" />
                <circle cx="102" cy="35" r="2.5" fill="#00e5ff" />
                <circle cx="80" cy="57" r="2.5" fill="#00e5ff" />
                <circle cx="58" cy="35" r="2.5" fill="#00e5ff" />
                <path d="M20,80 Q35,68 50,80 T80,80 T110,80 T140,80" fill="none" stroke="#00e5ff" stroke-width="1.5" filter="drop-shadow(0 0 3px #00e5ff)" />
                <path d="M20,88 Q35,76 50,88 T80,88 T110,88 T140,88" fill="none" stroke="rgba(0,229,255,0.4)" stroke-width="1" />
              </g>
            )}

            <!-- HYBRID TILES (14): Intersecting Manifolds & Cross-Disciplinary Glyphs -->
            {tile.categoryKey === "hybrid" && (
              <g class="v-hybrid">
                <circle cx="62" cy="55" r="34" fill="rgba(168, 85, 247, 0.12)" stroke="#a855f7" stroke-width="1.25" />
                <circle cx="98" cy="55" r="34" fill="rgba(56, 189, 248, 0.12)" stroke="#38bdf8" stroke-width="1.25" />
                <g transform="translate(80, 55)">
                  <circle cx="0" cy="-12" r="1.5" fill="#ffffff" filter="drop-shadow(0 0 2px #fff)" />
                  <circle cx="-3" cy="-4" r="1.5" fill="#c084fc" />
                  <circle cx="3" cy="2" r="1.5" fill="#38bdf8" />
                  <circle cx="-1" cy="8" r="1.5" fill="#ffffff" />
                  <circle cx="2" cy="14" r="1.5" fill="#c084fc" />
                </g>
                <text x="46" y="59" font-size="10" font-family="monospace" font-weight="bold" fill="#e9d5ff" text-anchor="middle">{tile.code.split('-')[0] || 'PSO'}</text>
                <text x="114" y="59" font-size="10" font-family="monospace" font-weight="bold" fill="#bae6fd" text-anchor="middle">{tile.code.split('-')[1] || 'DE'}</text>
              </g>
            )}

            <!-- ADVANCED: OF BATS AND BEACONS (Recolored to Advanced Crimson/Rose #f43f5e) -->
            {tile.visualType === "bats_beacons" && (
              <g class="v-bats-beacons">
                <!-- Gordon Beacon Spotlight Beam -->
                <polygon points="30,95 65,20 95,20 38,95" fill="rgba(244,63,94,0.14)" />
                <ellipse cx="80" cy="20" rx="18" ry="8" fill="rgba(244,63,94,0.28)" stroke="#f43f5e" stroke-width="1" />
                <path d="M74,21 Q77,18 80,21 Q83,18 86,21 Q84,23 80,22 Q76,23 74,21 Z" fill="#ffffff" filter="drop-shadow(0 0 4px #f43f5e)" />
                <!-- Gordon Base -->
                <circle cx="34" cy="95" r="3.5" fill="#f43f5e" />
                <text x="34" y="105" fill="#fb7185" font-size="6.5" font-family="monospace" text-anchor="middle">GORDON</text>
                <!-- Batman Central Tracker -->
                <circle cx="75" cy="50" r="4.5" fill="#ffffff" filter="drop-shadow(0 0 6px #f43f5e)" />
                <path d="M71,46 L75,41 L79,46 Z" fill="#f43f5e" />
                <line x1="75" y1="50" x2="80" y2="25" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 2" />
                <text x="89" y="53" fill="#ffffff" font-size="6.5" font-weight="bold" font-family="monospace">BATMAN</text>
                <!-- Robin Supporting Wingman -->
                <circle cx="56" cy="68" r="3" fill="#fb7185" />
                <line x1="56" y1="68" x2="72" y2="52" stroke="rgba(251,113,133,0.6)" stroke-width="1" />
                <text x="56" y="79" fill="#fb7185" font-size="6.5" font-family="monospace" text-anchor="middle">ROBIN</text>
                <!-- Joker Disrupter -->
                <circle cx="125" cy="62" r="3.5" fill="#c084fc" filter="drop-shadow(0 0 4px #c084fc)" />
                <path d="M125,62 Q105,75 90,60 T75,50" fill="none" stroke="rgba(192,132,252,0.6)" stroke-width="1" stroke-dasharray="2 2" />
                <text x="125" y="74" fill="#c084fc" font-size="6.5" font-family="monospace" text-anchor="middle">JOKER</text>
              </g>
            )}

            <!-- ADVANCED: ILS -->
            {tile.visualType === "ils" && (
              <g class="v-ils">
                <path d="M15,55 Q25,35 35,58 T60,65 T85,50 T110,80 T135,45 T145,55" fill="none" stroke="#f43f5e" stroke-width="1.75" />
                <path d="M60,65 Q80,25 110,80" fill="none" stroke="#fb7185" stroke-width="1" stroke-dasharray="2 2" />
                <polygon points="110,73 112,78 117,78 113,81 115,86 110,83 105,86 107,81 103,78 108,78" fill="#ffffff" filter="drop-shadow(0 0 5px #f43f5e)" />
              </g>
            )}

            <!-- ADVANCED: MAP-Elites -->
            {tile.visualType === "map_elites" && (
              <g class="v-map-elites" transform="translate(45, 18)">
                <rect x="0" y="0" width="14" height="14" fill="rgba(244,63,94,0.2)" stroke="#f43f5e" stroke-width="0.75"/>
                <rect x="14" y="0" width="14" height="14" fill="rgba(244,63,94,0.4)" stroke="#f43f5e" stroke-width="0.75"/>
                <rect x="28" y="0" width="14" height="14" fill="rgba(244,63,94,0.1)" stroke="#f43f5e" stroke-width="0.75"/>
                <rect x="42" y="0" width="14" height="14" fill="rgba(244,63,94,0.6)" stroke="#f43f5e" stroke-width="0.75"/>
                <rect x="56" y="0" width="14" height="14" fill="rgba(244,63,94,0.3)" stroke="#f43f5e" stroke-width="0.75"/>

                <rect x="0" y="14" width="14" height="14" fill="rgba(244,63,94,0.5)" stroke="#f43f5e" stroke-width="0.75"/>
