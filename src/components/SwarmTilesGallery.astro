  { left: "PSO", right: "FA", name: "PSO + FA", desc: "Particle swarm + firefly" },
  { left: "PSO", right: "SA", name: "PSO + SA", desc: "Particle swarm + simulated annealing" },
  { left: "PSO", right: "TS", name: "PSO + TS", desc: "Particle swarm + tabu search" },
  { left: "PSO", right: "CMA-ES", name: "PSO + CMA-ES", desc: "Particle swarm + CMA-ES" },
