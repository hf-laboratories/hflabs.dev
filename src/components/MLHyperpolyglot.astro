---
import sections from '../data/ml-hyperpolyglot.json';

// Preserve inline code from the source while letting Astro escape all text.
const inlineParts = (value: string) => value.split(/(`[^`]+`)/g).filter(Boolean).map(part => ({
  code: part.startsWith('`') && part.endsWith('`'),
  text: (part.startsWith('`') && part.endsWith('`') ? part.slice(1, -1) : part.replace(/\*\*/g, '')).replace(/\\\|/g, '|')
}));

const sectionLabels: Record<string, string> = {
  'ml-languages': 'Languages', 'ml-frameworks': 'Frameworks', 'ml-patterns': 'ML patterns',
  'ml-precision': 'Precision', 'ml-hardware': 'Hardware', 'ml-formats': 'Formats'
};
const clarifications: Record<string, string> = {
  'ml-languages': 'These are brief syntax illustrations. The PowerShell interface entry is not a native PowerShell interface declaration; performance and safety rankings are broad generalizations.',
  'ml-patterns': 'Examples are illustrative and some require adaptation. Setting model.trainable to false freezes weights; it does not itself select inference behavior. jax.jit compiles a function rather than selecting inference mode. TransformerBlock is not a standard tf.keras.layers API. Some PowerShell commands shown are placeholders, not built-in cmdlets.',
  'ml-precision': 'Storage for a Boolean is implementation-dependent, not universally one bit. C# System.Numerics.Complex uses double-precision components; the Complex Single row should not be read as a C# single-precision type.',
  'ml-hardware': 'Power figures, device and provider support vary by product, version and configuration; the source figures are illustrative rather than verified specifications.',
  'ml-formats': 'Format, conversion and hardware compatibility depend on the specific model and runtime; qualitative ratings are not guarantees.'
};
---

<section class="ml-reference" id="ml-reference" aria-labelledby="ml-reference-title">
  <div class="container">
    <div class="reference-intro">
      <p class="eyebrow">A SIDE-BY-SIDE QUICK REFERENCE</p>
      <h2 id="ml-reference-title">ML Hyperpolyglot tables</h2>
      <p>Compare concepts across languages, frameworks, data types, hardware and model formats. These tables retain the rows and columns of the ML HyperPolyglot document.</p>
      <div class="scope-note">
        <strong>Reading the tables</strong>
        <p>This is an ecosystem reference, not an inventory of HFLabs implementations or verified device support. Entries reflect the source document and can be incomplete, illustrative or out of date. Check current documentation and your configuration before relying on an API, compatibility claim or performance figure. ONNX export or an operator-compatibility check alone does not establish execution on an IPU.</p>
      </div>
      <nav class="reference-nav" aria-label="ML Hyperpolyglot tables">
        {sections.map(section => <a href={`#${section.id}`}>{sectionLabels[section.id] || section.title}</a>)}
      </nav>
    </div>

    {sections.map(section => (
      <section class="reference-block" id={section.id} aria-labelledby={`${section.id}-title`}>
        <div class="section-heading">
          <h3 id={`${section.id}-title`}>{section.title}</h3>
          <p class="section-scope">{inlineParts(section.scope).map(part => part.code ? <code>{part.text}</code> : part.text)}</p>
          {clarifications[section.id] && <p class="clarification"><strong>Reading note:</strong> {clarifications[section.id]}</p>}
        </div>
        {section.tables.map(table => (
          <div class="table-block" data-reference-table>
            {section.tables.length > 1 && <h4>{table.title}</h4>}
            <div class="table-tools">
              <label class="table-search">Search rows <input type="search" data-table-search aria-label={`Search rows in ${table.title}`} placeholder="Filter this table" /></label>
              <details class="column-menu">
                <summary>Choose columns</summary>
                <div class="column-options">
                  {table.headers.slice(1).map((header, index) => (
                    <label><input type="checkbox" data-column-toggle={index + 1} aria-label={inlineParts(header).map(part => part.text).join('')} checked /> <span>{inlineParts(header).map(part => part.code ? <code>{part.text}</code> : part.text)}</span></label>
                  ))}
                </div>
              </details>
              <span class="scroll-hint">Scroll horizontally to compare columns</span>
            </div>
            <div class="reference-scroll" tabindex="0" role="region" aria-label={`${table.title}: scroll horizontally to compare columns`}>
              <table>
                <thead><tr>{table.headers.map((header, index) => <th scope="col" data-column={index}>{inlineParts(header).map(part => part.code ? <code>{part.text}</code> : part.text)}</th>)}</tr></thead>
                <tbody>
                  {table.rows.map(row => <tr>{row.map((cell, index) => index === 0
                    ? <th scope="row" data-column={index}>{inlineParts(cell).map(part => part.code ? <code>{part.text}</code> : part.text)}</th>
                    : <td data-column={index}>{inlineParts(cell).map(part => part.code ? <code>{part.text}</code> : part.text)}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
            <p class="no-table-results" data-no-table-results hidden>No matching rows. Try a different search.</p>
          </div>
        ))}
      </section>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-reference-table]').forEach(block => {
    const search = block.querySelector<HTMLInputElement>('[data-table-search]');
    const rows = Array.from(block.querySelectorAll<HTMLTableRowElement>('tbody tr'));
    const noResults = block.querySelector<HTMLElement>('[data-no-table-results]');
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLocaleLowerCase();
      let visible = 0;
      rows.forEach(row => {
        const matches = (row.textContent || '').toLocaleLowerCase().includes(query);
        row.hidden = !matches;
        if (matches) visible++;
      });
      if (noResults) noResults.hidden = visible !== 0;
    });
    block.querySelectorAll<HTMLInputElement>('[data-column-toggle]').forEach(toggle => {
      toggle.addEventListener('change', () => {
        const index = toggle.dataset.columnToggle;
        block.querySelectorAll<HTMLElement>(`[data-column="${index}"]`).forEach(cell => { cell.hidden = !toggle.checked; });
      });
    });
  });
</script>

<style>
  .ml-reference { padding: 4.5rem 0; background: #080d19; border-top: 1px solid rgba(148, 163, 184, .18); }
  .reference-intro { max-width: 74rem; }
  .eyebrow { margin: 0 0 .7rem; color: #67e8f9; font: 700 .8rem/1.4 var(--font-mono); letter-spacing: .1em; }
  .reference-intro h2 { color: #f8fafc; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.12; letter-spacing: -.03em; margin: 0 0 1rem; }
  .reference-intro > p:not(.eyebrow), .section-scope { color: #c2cfdd; font-size: 1rem; line-height: 1.65; }
  .scope-note { margin: 1.7rem 0; padding: 1.2rem 1.4rem; background: rgba(56, 189, 248, .07); border: 1px solid rgba(56, 189, 248, .23); border-left: 3px solid #38bdf8; border-radius: .5rem; }
  .scope-note strong { color: #e0f2fe; }
  .scope-note p { color: #c3d3e3; margin: .4rem 0 0; line-height: 1.6; }
  .reference-nav { display: flex; flex-wrap: wrap; gap: .6rem; }
  .reference-nav a { color: #bceeff; text-decoration: none; border: 1px solid rgba(56, 189, 248, .25); border-radius: 99px; padding: .5rem .9rem; font-size: .9rem; }
  .reference-nav a:hover, .reference-nav a:focus-visible { background: rgba(56, 189, 248, .14); color: white; }
  .reference-block { padding-top: 4rem; scroll-margin-top: 6rem; }
  .section-heading { max-width: 75rem; }
  .section-heading h3 { color: #f8fafc; font-size: clamp(1.5rem, 2.7vw, 2rem); line-height: 1.2; margin: 0 0 .75rem; }
  .section-scope { margin: 0 0 .8rem; }
  .clarification { margin: 0 0 1rem; color: #c3d3e3; line-height: 1.6; border-left: 3px solid #fbbf24; padding: .65rem 1rem; background: rgba(251, 191, 36, .06); }
  .clarification strong { color: #fcd34d; }
  .table-block { margin-top: 1.6rem; }
  .table-block h4 { color: #f1f5f9; font-size: 1.2rem; margin: 2rem 0 .9rem; }
  .table-tools { display: flex; flex-wrap: wrap; align-items: end; gap: .8rem 1rem; margin-bottom: .8rem; }
  .table-search { display: grid; gap: .3rem; color: #c4d2e1; font-size: .875rem; font-weight: 600; }
  .table-search input { width: min(19rem, 75vw); border: 1px solid #45576d; border-radius: .4rem; background: #0e192a; color: #f8fafc; padding: .6rem .75rem; font: inherit; }
  .column-menu { position: relative; }
  .column-menu summary { cursor: pointer; color: #c5eaff; border: 1px solid #45576d; border-radius: .4rem; padding: .6rem .8rem; font-size: .875rem; }
  .column-options { position: absolute; z-index: 5; top: calc(100% + .3rem); left: 0; min-width: 15rem; max-height: 20rem; overflow: auto; padding: .5rem; background: #111e30; border: 1px solid #45576d; border-radius: .4rem; box-shadow: 0 12px 30px #0008; }
  .column-options label { display: flex; gap: .5rem; align-items: baseline; padding: .4rem; color: #e2e8f0; font-size: .9rem; }
  .column-options input { accent-color: #38bdf8; }
  .scroll-hint { color: #a9bdcf; font-size: .875rem; padding: .6rem 0; }
  .reference-scroll { border: 1px solid rgba(148, 163, 184, .24); border-radius: .5rem; overflow-x: auto; background: #0b1220; }
  .reference-scroll:focus-visible, input:focus-visible, summary:focus-visible { outline: 2px solid #67e8f9; outline-offset: 2px; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; font-size: .9rem; line-height: 1.5; }
  th, td { min-width: 12rem; max-width: 22rem; padding: .8rem .9rem; border-bottom: 1px solid rgba(148, 163, 184, .15); border-right: 1px solid rgba(148, 163, 184, .1); vertical-align: top; overflow-wrap: anywhere; }
  thead th { color: #e0f2fe; background: #132137; font-weight: 700; }
  tbody th { color: #f1f5f9; background: #111d2e; font-weight: 700; }
  tbody td { color: #cbd5e1; }
  tr > :first-child { position: sticky; left: 0; z-index: 1; min-width: 11rem; box-shadow: 4px 0 8px #0003; }
  thead tr > :first-child { z-index: 2; }
  tbody tr:hover td { background: rgba(56, 189, 248, .05); }
  th[hidden], td[hidden], tr[hidden], .no-table-results[hidden] { display: none; }
  code { color: #a5e4fa; font: .9em/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .no-table-results { color: #cbd5e1; margin: .8rem 0 0; }
  @media (max-width: 640px) { .ml-reference { padding: 3.5rem 0; } .reference-block { padding-top: 3rem; } th, td { min-width: 10rem; } tr > :first-child { min-width: 8.5rem; } }
</style>
