---
// Curated from docs/quickreference/ML_HyperPolyglot.md in IPUServices.
// These are ecosystem examples, not claims of repository or hardware support.
const languages = [
  { name: 'C', variable: 'int x = 5;', function: 'int add(int a, int b)', memory: 'Explicit allocation and release' },
  { name: 'C#', variable: 'int x = 5;', function: 'int Add(int a, int b)', memory: 'Garbage collection' },
  { name: 'C++', variable: 'int x = 5;', function: 'int add(int a, int b)', memory: 'RAII and explicit ownership' },
  { name: 'Python', variable: 'x = 5', function: 'def add(a, b):', memory: 'Managed objects' },
  { name: 'PowerShell', variable: '$x = 5', function: 'function Add { param($a, $b) }', memory: '.NET managed objects' },
  { name: 'JavaScript', variable: 'let x = 5;', function: 'function add(a, b) {}', memory: 'Garbage collection' },
  { name: 'TypeScript', variable: 'let x: number = 5;', function: 'function add(a: number, b: number): number', memory: 'JavaScript runtime' },
  { name: 'Rust', variable: 'let x: i32 = 5;', function: 'fn add(a: i32, b: i32) -> i32', memory: 'Ownership and borrowing' },
  { name: 'Go', variable: 'x := 5', function: 'func add(a, b int) int', memory: 'Garbage collection' },
  { name: 'Java', variable: 'int x = 5;', function: 'int add(int a, int b)', memory: 'Garbage collection' },
];

const ecosystem = [
  { name: 'PyTorch', kind: 'Framework', role: 'Build and train models with tensors and automatic differentiation.', example: 'Python, C++' },
  { name: 'TensorFlow / Keras', kind: 'Framework', role: 'Model development and training, including high-level neural-network APIs.', example: 'Python, C++' },
  { name: 'JAX / Flax', kind: 'Framework + library', role: 'Array computation, automatic differentiation and compilation; Flax adds neural-network building blocks.', example: 'Python' },
  { name: 'ML.NET', kind: 'Framework', role: 'Estimator and transformer pipelines for machine-learning workflows.', example: 'C# / .NET' },
  { name: 'ONNX Runtime', kind: 'Runtime', role: 'Runs compatible ONNX models using an available execution provider.', example: 'C#, C++, Python and others' },
  { name: 'PopART / PopXL', kind: 'Graph tooling', role: 'Graph construction and execution tooling for Graphcore IPUs.', example: 'C++, Python' },
  { name: 'OpenVINO', kind: 'Toolkit', role: 'Model conversion and inference optimization for supported devices.', example: 'C++, Python' },
  { name: 'TensorRT', kind: 'Inference runtime', role: 'Optimize and execute supported models on NVIDIA GPUs.', example: 'C++, Python' },
  { name: 'Core ML', kind: 'Framework', role: 'On-device model integration in the Apple ecosystem.', example: 'Swift, Objective-C' },
  { name: 'TVM / MLIR / XLA', kind: 'Compiler tooling', role: 'Represent, transform or compile computations for target execution.', example: 'Varies by project' },
  { name: 'Triton', kind: 'Kernel language', role: 'Express accelerator kernels; distinct from Triton Inference Server.', example: 'Python' },
  { name: 'Triton Inference Server', kind: 'Serving', role: 'Serve models through configured inference backends.', example: 'Server APIs' },
  { name: 'Hugging Face Transformers', kind: 'Model library', role: 'Model architectures, pretrained weights and tooling for transformer workflows.', example: 'Python' },
  { name: 'llama.cpp / vLLM', kind: 'Inference / serving', role: 'Tools for running or serving language models with their supported backends.', example: 'C++, Python' },
];

const patterns = [
  { concept: 'Linear layer', pytorch: 'nn.Linear(in_features, out_features)', tensorflow: 'tf.keras.layers.Dense(units)', onnx: 'MatMul + Add' },
  { concept: '2D convolution', pytorch: 'nn.Conv2d(...)', tensorflow: 'tf.keras.layers.Conv2D(...)', onnx: 'Conv' },
  { concept: 'Activation', pytorch: 'nn.ReLU()', tensorflow: 'tf.nn.relu', onnx: 'Relu' },
  { concept: 'Embedding', pytorch: 'nn.Embedding(...)', tensorflow: 'tf.keras.layers.Embedding(...)', onnx: 'Gather pattern' },
  { concept: 'Loss', pytorch: 'nn.CrossEntropyLoss()', tensorflow: 'tf.keras.losses.SparseCategoricalCrossentropy()', onnx: 'Represented by graph operations' },
  { concept: 'Optimizer', pytorch: 'torch.optim.Adam(...)', tensorflow: 'tf.keras.optimizers.Adam(...)', onnx: 'Training workflow dependent' },
  { concept: 'Compilation', pytorch: 'torch.compile()', tensorflow: 'tf.function()', onnx: 'Runtime/provider dependent' },
];

const types = [
  { name: 'Signed integer', size: '8 / 16 / 32 / 64 bits', csharp: 'sbyte / short / int / long', example: 'Counts, indices, quantized values' },
  { name: 'Unsigned integer', size: '8 bits and wider', csharp: 'byte / ushort / uint / ulong', example: 'Non-negative integer values' },
  { name: 'FP16', size: '16 bits', csharp: 'Half', example: 'Lower-precision floating point' },
  { name: 'BF16', size: '16 bits', csharp: 'Framework-dependent', example: 'Wider exponent range than FP16, fewer fraction bits' },
  { name: 'FP32', size: '32 bits', csharp: 'float', example: 'Common floating-point model data' },
  { name: 'FP64', size: '64 bits', csharp: 'double', example: 'Higher-precision floating point' },
  { name: 'Boolean / string', size: 'Representation varies', csharp: 'bool / string', example: 'Logical and text data' },
];

const accelerators = [
  { name: 'CPU', model: 'Threads and SIMD', stack: 'Native code, vector intrinsics, ONNX Runtime' },
  { name: 'NVIDIA GPU', model: 'Parallel GPU kernels and tensor operations', stack: 'CUDA, TensorRT' },
  { name: 'AMD GPU', model: 'Parallel GPU compute', stack: 'ROCm, OpenCL' },
  { name: 'Intel GPU', model: 'Parallel GPU compute', stack: 'Level Zero, SYCL, OpenVINO' },
  { name: 'Apple silicon', model: 'CPU, GPU and neural-engine paths', stack: 'Core ML, Metal, MLX' },
  { name: 'Google TPU', model: 'Tensor and matrix acceleration', stack: 'JAX, TensorFlow, XLA' },
  { name: 'Graphcore IPU', model: 'Many-core graph execution', stack: 'PopART, PopXL, Poplar' },
  { name: 'Mobile DSP / NPU', model: 'Specialized on-device inference', stack: 'Vendor SDKs and runtimes' },
  { name: 'FPGA', model: 'Configurable logic and data paths', stack: 'RTL, vendor toolchains' },
];

const formats = [
  { name: 'ONNX', extension: '.onnx', role: 'Interchange graph and model representation' },
  { name: 'TensorFlow SavedModel', extension: 'Directory', role: 'TensorFlow model and associated assets' },
  { name: 'TensorFlow Lite', extension: '.tflite', role: 'Model representation for TensorFlow Lite runtimes' },
  { name: 'PyTorch checkpoint', extension: '.pt / .pth', role: 'Saved PyTorch state; contents depend on how it was saved' },
  { name: 'Core ML', extension: '.mlmodel', role: 'Model representation for Apple platforms' },
  { name: 'TensorRT engine', extension: '.plan', role: 'Serialized inference engine for its target environment' },
  { name: 'OpenVINO IR', extension: '.xml + .bin', role: 'Model structure and weights for OpenVINO' },
  { name: 'POPEF', extension: '.popef', role: 'Graphcore executable format' },
  { name: 'GGUF', extension: '.gguf', role: 'Model format used by llama.cpp and related tools' },
  { name: 'Safetensors', extension: '.safetensors', role: 'Tensor serialization; model configuration may be separate' },
];
---

<section class="ml-reference" id="ml-reference" aria-labelledby="ml-reference-title">
  <div class="container">
    <div class="reference-intro">
      <p class="eyebrow">ML HYPERPOLYGLOT · QUICK REFERENCE</p>
      <h2 id="ml-reference-title">From languages to model deployment</h2>
      <p>Compare programming syntax, ML building blocks, runtimes, numeric types, accelerators and model formats in one place. These tables are adapted from the ML HyperPolyglot reference.</p>
      <div class="scope-note">
        <strong>How to read this reference</strong>
        <p>These are general ecosystem examples, not a list of features implemented or validated by HFLabs. APIs, operators and hardware availability depend on versions and configuration. ONNX export or an operator-compatibility check alone does not establish execution on an IPU.</p>
      </div>
      <nav class="reference-nav" aria-label="ML reference sections">
        <a href="#ml-languages">Languages</a><a href="#ml-frameworks">Frameworks</a><a href="#ml-patterns">Patterns</a><a href="#ml-precision">Precision</a><a href="#ml-hardware">Hardware</a><a href="#ml-formats">Formats</a>
      </nav>
    </div>

    <div class="reference-block" id="ml-languages">
      <div class="section-heading"><p class="eyebrow">LANGUAGES</p><h3>One idea, different syntax</h3><p>Declarations and signatures are short comparisons, not complete programs.</p></div>
      <div class="reference-scroll" tabindex="0" role="region" aria-label="Programming language comparison; scroll horizontally for more columns">
        <table><thead><tr><th scope="col">Language</th><th scope="col">Variable</th><th scope="col">Function signature</th><th scope="col">Memory model</th></tr></thead><tbody>
          {languages.map(row => <tr><th scope="row">{row.name}</th><td><code>{row.variable}</code></td><td><code>{row.function}</code></td><td>{row.memory}</td></tr>)}
        </tbody></table>
      </div>
    </div>

    <div class="reference-block" id="ml-frameworks">
      <div class="section-heading"><p class="eyebrow">FRAMEWORKS &amp; RUNTIMES</p><h3>Different layers of the ML stack</h3><p>A framework, compiler, model format and serving system solve different parts of the workflow.</p></div>
      <div class="reference-scroll" tabindex="0" role="region" aria-label="Framework and runtime comparison; scroll horizontally for more columns">
        <table><thead><tr><th scope="col">Project</th><th scope="col">Layer</th><th scope="col">Role</th><th scope="col">Example language</th></tr></thead><tbody>
          {ecosystem.map(row => <tr><th scope="row">{row.name}</th><td><span class="kind">{row.kind}</span></td><td>{row.role}</td><td>{row.example}</td></tr>)}
        </tbody></table>
      </div>
    </div>

    <div class="reference-block" id="ml-patterns">
      <div class="section-heading"><p class="eyebrow">ML PATTERNS</p><h3>Compare the building blocks</h3><p>Names and graph representations are illustrative; arguments, operator versions and execution semantics vary.</p></div>
      <div class="reference-scroll" tabindex="0" role="region" aria-label="Machine learning pattern comparison; scroll horizontally for more columns">
        <table><thead><tr><th scope="col">Concept</th><th scope="col">PyTorch</th><th scope="col">TensorFlow / Keras</th><th scope="col">ONNX graph</th></tr></thead><tbody>
          {patterns.map(row => <tr><th scope="row">{row.concept}</th><td><code>{row.pytorch}</code></td><td><code>{row.tensorflow}</code></td><td>{row.onnx}</td></tr>)}
        </tbody></table>
      </div>
      <p class="reference-footnote">In ML.NET, an estimator is fitted to produce an <code>ITransformer</code>, which can transform an <code>IDataView</code>. That tabular pipeline is a different abstraction from a general tensor API.</p>
    </div>

    <div class="reference-block" id="ml-precision">
      <div class="section-heading"><p class="eyebrow">DATA TYPES &amp; PRECISION</p><h3>Choose the representation deliberately</h3><p>Precision and range influence memory use and numerical behavior; support depends on the operation, framework and device.</p></div>
      <div class="reference-scroll" tabindex="0" role="region" aria-label="Data types and precision comparison; scroll horizontally for more columns">
        <table><thead><tr><th scope="col">Type</th><th scope="col">Size</th><th scope="col">C# spelling</th><th scope="col">Context</th></tr></thead><tbody>
          {types.map(row => <tr><th scope="row">{row.name}</th><td>{row.size}</td><td><code>{row.csharp}</code></td><td>{row.example}</td></tr>)}
        </tbody></table>
      </div>
    </div>

    <div class="reference-block" id="ml-hardware">
      <div class="section-heading"><p class="eyebrow">HARDWARE</p><h3>Different execution models</h3><p>Representative stacks are starting points, not a device compatibility matrix or performance ranking.</p></div>
      <div class="reference-scroll" tabindex="0" role="region" aria-label="Accelerator comparison; scroll horizontally for more columns">
        <table><thead><tr><th scope="col">Hardware</th><th scope="col">Execution model</th><th scope="col">Example software</th></tr></thead><tbody>
          {accelerators.map(row => <tr><th scope="row">{row.name}</th><td>{row.model}</td><td>{row.stack}</td></tr>)}
        </tbody></table>
      </div>
    </div>

    <div class="reference-block" id="ml-formats">
      <div class="section-heading"><p class="eyebrow">MODEL FORMATS</p><h3>From saved weights to executable graphs</h3><p>A file extension does not guarantee portability. Conversion and execution depend on model operators, versions and the target runtime.</p></div>
      <div class="reference-scroll" tabindex="0" role="region" aria-label="Model format comparison; scroll horizontally for more columns">
        <table><thead><tr><th scope="col">Format</th><th scope="col">Common extension</th><th scope="col">Role</th></tr></thead><tbody>
          {formats.map(row => <tr><th scope="row">{row.name}</th><td><code>{row.extension}</code></td><td>{row.role}</td></tr>)}
        </tbody></table>
      </div>
    </div>
  </div>
</section>

