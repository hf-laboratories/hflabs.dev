  // ==========================================
  // 1. Fullpage 3-Slide Controller & Wheel Lock
  // ==========================================
  const totalPages = 3;
  let currentPage = 0;
  let isPageTransitioning = false;
  let wheelClicks = 0; // Discrete clicks in current direction (0 to 3)
  let wheelDirection = 0; // 1 = Down, -1 = Up
  let wheelResetTimer: number | null = null;
  let accumulatedPixelDelta = 0;

  const slides = document.querySelectorAll('.page-slide');
  const navDots = document.querySelectorAll('.nav-dot');
  const tickEls = [
    document.getElementById('tick-1'),
    document.getElementById('tick-2'),
    document.getElementById('tick-3')
  ];

  function updateWheelVisuals(count: number) {
    const absCount = Math.min(3, Math.max(0, count));
    tickEls.forEach((el, idx) => {
      if (el) {
        if (idx < absCount) {
          el.classList.add('active');
        } else {
          el.classList.remove('active');
        }
      }
    });
  }

  function goToPage(pageIdx: number, updateHash = true) {
    if (pageIdx < 0 || pageIdx >= totalPages) return;
    
    isPageTransitioning = true;
    currentPage = pageIdx;

    slides.forEach((s, idx) => {
      if (idx === pageIdx) {
        s.classList.add('active-slide');
      } else {
        s.classList.remove('active-slide');
      }
    });

    navDots.forEach((dot, idx) => {
      if (idx === pageIdx) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });

    if (updateHash) {
      const hashes = ['#overview', '#core-systems', '#products'];
      const targetHash = hashes[pageIdx];
      if (targetHash && window.location.hash !== targetHash) {
        history.replaceState(null, '', targetHash);
      }
    }

    // Notify division cycle managers of viewport section changes
    handleSectionInViewChange();

    setTimeout(() => {
      isPageTransitioning = false;
    }, 500);
  }

  // Wheel Restrictor (Exact 3 clicks/notches of the scroll wheel to jump)
  function handleWheelEvent(e: WheelEvent) {
    // Only lock when inside desktop viewport
    if (window.innerWidth <= 1024) return;

    // Prevent default browser scrolling so we control the 3-click jump
    e.preventDefault();
    if (isPageTransitioning) return;

    // Determine raw and normalized delta
    let rawDelta = e.deltaY;
    if (e.deltaMode === 1) {
      // Line mode (Firefox/Linux): each event is a distinct wheel notch!
      rawDelta = rawDelta * 50;
    } else if (e.deltaMode === 2) {
      rawDelta = rawDelta * 500;
    }

    if (rawDelta === 0) return;

    const currentDir = rawDelta > 0 ? 1 : -1;

    // If direction changed, reset accumulator
    if (currentDir !== wheelDirection) {
      wheelDirection = currentDir;
      wheelClicks = 0;
      accumulatedPixelDelta = 0;
    }

    // Accumulate ticks
    accumulatedPixelDelta += Math.abs(rawDelta);
    // 1 click of mouse wheel is typically 50-100px of delta
    const calculatedClicks = Math.floor(accumulatedPixelDelta / 60) + 1;
    wheelClicks = Math.min(3, Math.max(wheelClicks + 1, calculatedClicks));

    updateWheelVisuals(wheelClicks);

    // Reset accumulator after 800ms of user hesitation
    if (wheelResetTimer) clearTimeout(wheelResetTimer);
    wheelResetTimer = window.setTimeout(() => {
      wheelClicks = 0;
      accumulatedPixelDelta = 0;
      wheelDirection = 0;
      updateWheelVisuals(0);
    }, 800);

    // Trigger jump on 3 clicks
    if (wheelClicks >= 3) {
      if (wheelDirection > 0 && currentPage < totalPages - 1) {
        goToPage(currentPage + 1);
      } else if (wheelDirection < 0 && currentPage > 0) {
        goToPage(currentPage - 1);
      }
      wheelClicks = 0;
      accumulatedPixelDelta = 0;
      wheelDirection = 0;
      updateWheelVisuals(0);
    }
  }

  window.addEventListener('wheel', handleWheelEvent, { passive: false });
  document.addEventListener('wheel', handleWheelEvent, { passive: false });

  // Navigation Dots Click
  navDots.forEach(dot => {
    dot.addEventListener('click', () => {
      const target = parseInt(dot.getAttribute('data-target-page') || '0', 10);
      goToPage(target);
    });
  });

  // Jump buttons on Hero and throughout the slides
  document.querySelectorAll('[data-jump-to]').forEach(btn => {
    btn.addEventListener('click', () => {
      const page = parseInt(btn.getAttribute('data-jump-to') || '0', 10);
      goToPage(page);
    });
  });

  // Keyboard Navigation
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
      if (currentPage < totalPages - 1) {
        e.preventDefault();
        goToPage(currentPage + 1);
      }
    } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
      if (currentPage > 0) {
        e.preventDefault();
        goToPage(currentPage - 1);
      }
    } else if (e.key === 'Home') {
      goToPage(0);
    } else if (e.key === 'End') {
      goToPage(totalPages - 1);
    }
  });

  // Touch Swipe for mobile/tablet
  let touchStartY = 0;
  window.addEventListener('touchstart', (e: TouchEvent) => {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  window.addEventListener('touchend', (e: TouchEvent) => {
    const touchEndY = e.changedTouches[0].clientY;
    const diff = touchStartY - touchEndY;
    if (Math.abs(diff) > 40) {
      if (diff > 0 && currentPage < totalPages - 1) {
        goToPage(currentPage + 1);
      } else if (diff < 0 && currentPage > 0) {
        goToPage(currentPage - 1);
      }
    }
  }, { passive: true });

  // ==========================================
  // 2. Section 2 (Topology Stage) Division Cycling & Overlay
  // ==========================================
  let stageCurrentDiv = 0;
  let stageCycleTimer: number | null = null;
  let isStagePaused = false;
  const stageDuration = 15000; // 15 seconds per division animation cycle

  const stageTabs = document.querySelectorAll('.stage-tab');
  const stageDivBadge = document.getElementById('stageDivBadge');
  const stageDivTitle = document.getElementById('stageDivTitle');
  const stageDivDesc = document.getElementById('stageDivDesc');
  const stageProjectPills = document.getElementById('stageProjectPills');
  const stageMetricItem1 = document.getElementById('stageMetricItem1');
  const stageMetricItem2 = document.getElementById('stageMetricItem2');
  const stageMetricItem3 = document.getElementById('stageMetricItem3');
  const stageMetricItems = [stageMetricItem1, stageMetricItem2, stageMetricItem3];

  const stageMetricLbl1 = document.getElementById('stageMetricLbl1');
  const stageMetricVal1 = document.getElementById('stageMetricVal1');
  const stageMetricLbl2 = document.getElementById('stageMetricLbl2');
  const stageMetricVal2 = document.getElementById('stageMetricVal2');
  const stageMetricLbl3 = document.getElementById('stageMetricLbl3');
  const stageMetricVal3 = document.getElementById('stageMetricVal3');
  const stageProductLink = document.getElementById('stageProductLink') as HTMLAnchorElement;
  const stagePauseBtn = document.getElementById('stagePauseBtn');
  const cycleStatusText = document.getElementById('cycleStatusText');

  const visHeaderTitle = document.getElementById('visHeaderTitle');
  const visHeaderBadge = document.getElementById('visHeaderBadge');
  const stageTerminalText = document.getElementById('stageTerminalText');
  const visStatLbl1 = document.getElementById('visStatLbl1');
  const visStatVal1 = document.getElementById('visStatVal1');
  const visStatLbl2 = document.getElementById('visStatLbl2');
  const visStatVal2 = document.getElementById('visStatVal2');
  const visStatLbl3 = document.getElementById('visStatLbl3');
  const visStatVal3 = document.getElementById('visStatVal3');

  const stageNarrativeAnimGroup = document.getElementById('stageNarrativeAnimGroup');
  const stageVisAnimGroup = document.getElementById('stageVisAnimGroup');
  const stageMetricsTrio = document.getElementById('stageMetricsTrio');

  // ==========================================
  // Sequential Metric & Project Lighting Sequencer
  // ==========================================
  let stageMetricStep = 0;
  let metricStepTimer: number | null = null;
  let isMetricHovered = false;
  const metricStepDuration = 2700; // 2.7s per metric/project light-up step

  function highlightMetricStep(stepIdx: number) {
    stageMetricStep = stepIdx % 3;
    const data = divisionData[stageCurrentDiv];
    if (!data) return;

    const currentMetric = data.metrics[stageMetricStep];
    if (!currentMetric) return;

    // Set CSS theme variables on container elements
    const rgb = data.badgeColorRgb || '56, 189, 248';
    const hex = data.badgeColor || '#38bdf8';
    if (stageNarrativeAnimGroup) {
      stageNarrativeAnimGroup.style.setProperty('--active-color', hex);
      stageNarrativeAnimGroup.style.setProperty('--active-color-rgb', rgb);
    }
    if (stageVisAnimGroup) {
      stageVisAnimGroup.style.setProperty('--active-color', hex);
      stageVisAnimGroup.style.setProperty('--active-color-rgb', rgb);
    }

    // 1. Highlight the active metric item card, dim inactive ones
    stageMetricItems.forEach((item, idx) => {
      if (!item) return;
      if (idx === stageMetricStep) {
        item.classList.add('is-lit');
        item.classList.remove('is-dimmed');
      } else {
        item.classList.remove('is-lit');
        item.classList.add('is-dimmed');
      }
    });

    // 2. Highlight matching project pills in stageProjectPills
    if (stageProjectPills) {
      const pills = stageProjectPills.querySelectorAll<HTMLElement>('.stage-pill');
      pills.forEach(pill => {
        const pillName = pill.getAttribute('data-pill-name') || pill.textContent?.trim() || '';
        const isRelated = currentMetric.relatedPills?.some((rp: string) => pillName.includes(rp) || rp.includes(pillName));
        if (isRelated) {
          pill.classList.add('is-lit');
          pill.classList.remove('is-dimmed');
        } else {
          pill.classList.remove('is-lit');
          pill.classList.add('is-dimmed');
        }
      });
    }

    // 3. Highlight matching diagram nodes in the visualizer mesh
    const nodeIds = ['vnode-1', 'vnode-2', 'vnode-3', 'vnode-4'];
    nodeIds.forEach(nodeId => {
      const nodeEl = document.getElementById(nodeId);
      if (!nodeEl) return;
      const isRelatedNode = currentMetric.relatedNodes?.includes(nodeId);
      if (isRelatedNode) {
        nodeEl.classList.add('is-lit');
        nodeEl.classList.remove('is-dimmed');
      } else {
        nodeEl.classList.remove('is-lit');
        nodeEl.classList.add('is-dimmed');
      }
    });

    // 4. Update terminal stream to spotlight the active telemetry
    if (stageTerminalText && currentMetric.telemetry) {
      stageTerminalText.textContent = currentMetric.telemetry;
    }
  }

  function startMetricCycle() {
    stopMetricCycle();
    if (isStagePaused) return;

    metricStepTimer = window.setInterval(() => {
      if (!isMetricHovered && !isStagePaused) {
        stageMetricStep = (stageMetricStep + 1) % 3;
        highlightMetricStep(stageMetricStep);
      }
    }, metricStepDuration);
  }

  function stopMetricCycle() {
    if (metricStepTimer) {
      clearInterval(metricStepTimer);
      metricStepTimer = null;
    }
  }

  function setStageDivision(divIdx: number) {
    stageCurrentDiv = divIdx;
    const data = divisionData[divIdx];
    if (!data) return;

    // Update Stage Tabs
    stageTabs.forEach((tab, idx) => {
      if (idx === divIdx) {
        tab.classList.add('active');
      } else {
        tab.classList.remove('active');
      }
    });

    // Dispatch background overlay update immediately to trigger particle morphing wave
    window.dispatchEvent(new CustomEvent('division-change', {
      detail: {
        targetOverlayId: 'stage-bg-overlay',
        divisionIndex: divIdx
      }
    }));

    // Soft fade transition on panel contents
    if (stageNarrativeAnimGroup) stageNarrativeAnimGroup.classList.add('fading');
    if (stageVisAnimGroup) stageVisAnimGroup.classList.add('fading');

    setTimeout(() => {
      // Update Narrative content
      if (stageDivBadge) {
        stageDivBadge.textContent = data.badge;
        stageDivBadge.style.color = data.badgeColor;
        stageDivBadge.style.borderColor = `${data.badgeColor}4D`;
        stageDivBadge.style.background = `${data.badgeColor}1A`;
      }
      if (stageDivTitle) stageDivTitle.textContent = data.title;
      if (stageDivDesc) stageDivDesc.textContent = data.desc;

      if (stageProjectPills) {
        stageProjectPills.innerHTML = data.pills.map(p => `<span class="stage-pill" data-pill-name="${p}">${p}</span>`).join('');
        
        // Attach interactive hover & click listeners to newly created pills
        stageProjectPills.querySelectorAll<HTMLElement>('.stage-pill').forEach(pill => {
          const pName = pill.getAttribute('data-pill-name') || '';
          pill.addEventListener('mouseenter', () => {
            isMetricHovered = true;
            const matchIdx = data.metrics.findIndex((m: any) => m.relatedPills?.some((rp: string) => pName.includes(rp) || rp.includes(pName)));
            if (matchIdx >= 0) highlightMetricStep(matchIdx);
          });
          pill.addEventListener('mouseleave', () => {
            isMetricHovered = false;
          });
          pill.addEventListener('click', () => {
            const matchIdx = data.metrics.findIndex((m: any) => m.relatedPills?.some((rp: string) => pName.includes(rp) || rp.includes(pName)));
            if (matchIdx >= 0) highlightMetricStep(matchIdx);
          });
        });
      }

      if (stageMetricLbl1 && stageMetricVal1) {
        stageMetricLbl1.textContent = data.metrics[0].lbl;
        stageMetricVal1.textContent = data.metrics[0].val;
      }
      if (stageMetricLbl2 && stageMetricVal2) {
        stageMetricLbl2.textContent = data.metrics[1].lbl;
        stageMetricVal2.textContent = data.metrics[1].val;
      }
      if (stageMetricLbl3 && stageMetricVal3) {
        stageMetricLbl3.textContent = data.metrics[2].lbl;
        stageMetricVal3.textContent = data.metrics[2].val;
      }
      if (stageProductLink) stageProductLink.href = data.link;

      // Update Visualizer Header & Terminal
      if (visHeaderTitle) visHeaderTitle.textContent = data.title;
      if (visHeaderBadge) {
        visHeaderBadge.textContent = data.badge;
        visHeaderBadge.style.color = data.badgeColor;
      }
      if (stageTerminalText) stageTerminalText.textContent = data.terminal;

      // Update Visualizer Diagram Nodes
      const nodeIds = ['vnode-1', 'vnode-2', 'vnode-3', 'vnode-4'];
      data.nodes.forEach((n, idx) => {
        const nodeEl = document.getElementById(nodeIds[idx]);
        if (nodeEl) {
          const icon = nodeEl.querySelector('.node-icon');
          const title = nodeEl.querySelector('.node-title');
          const sub = nodeEl.querySelector('.node-sub');
          if (icon) icon.textContent = n.icon;
          if (title) title.textContent = n.title;
          if (sub) sub.textContent = n.sub;
        }
      });

      // Update Stats
      if (visStatLbl1 && visStatVal1) {
        visStatLbl1.textContent = data.stats[0].lbl;
        visStatVal1.textContent = data.stats[0].val;
      }
      if (visStatLbl2 && visStatVal2) {
        visStatLbl2.textContent = data.stats[1].lbl;
        visStatVal2.textContent = data.stats[1].val;
      }
      if (visStatLbl3 && visStatVal3) {
        visStatLbl3.textContent = data.stats[2].lbl;
        visStatVal3.textContent = data.stats[2].val;
      }

      if (stageNarrativeAnimGroup) stageNarrativeAnimGroup.classList.remove('fading');
      if (stageVisAnimGroup) stageVisAnimGroup.classList.remove('fading');

      // Initialize sequential light-up at first metric item
      stageMetricStep = 0;
      highlightMetricStep(0);
      startMetricCycle();
    }, 180);
  }

  function startStageCycle() {
    stopStageCycle();
    if (isStagePaused) return;

    stageCycleTimer = window.setTimeout(() => {
      const nextDiv = (stageCurrentDiv + 1) % 3;
      setStageDivision(nextDiv);
      startStageCycle();
    }, stageDuration);
  }

  function stopStageCycle() {
    if (stageCycleTimer) {
      clearTimeout(stageCycleTimer);
      stageCycleTimer = null;
    }
    stopMetricCycle();
  }

  // Bind hover and click events to metric trio item boxes
  stageMetricItems.forEach((item, idx) => {
    if (!item) return;
    item.addEventListener('mouseenter', () => {
      isMetricHovered = true;
      highlightMetricStep(idx);
    });
    item.addEventListener('mouseleave', () => {
      isMetricHovered = false;
    });
    item.addEventListener('click', () => {
      highlightMetricStep(idx);
    });
  });

  // Stage Tab Click
  stageTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = parseInt(tab.getAttribute('data-stage-div') || '0', 10);
      setStageDivision(idx);
      startStageCycle();
    });
  });

  // Pause / Resume Stage Cycle
  if (stagePauseBtn && cycleStatusText) {
    stagePauseBtn.addEventListener('click', () => {
      isStagePaused = !isStagePaused;
      if (isStagePaused) {
        stopStageCycle();
        stopMetricCycle();
        stagePauseBtn.innerHTML = `<span class="pause-icon">&#9654;</span><span class="pause-text">Resume</span>`;
        cycleStatusText.textContent = 'Paused';
        cycleStatusText.style.color = 'var(--text-muted)';
      } else {
        startStageCycle();
        startMetricCycle();
        stagePauseBtn.innerHTML = `<span class="pause-icon">&#10074;&#10074;</span><span class="pause-text">Pause</span>`;
        cycleStatusText.textContent = 'Active Cycle (15s)';
        cycleStatusText.style.color = 'var(--accent-emerald)';
      }
    });
  }

  // ==========================================
  // 3. Section 3 (Core Divisions Stack) Cycling & Overlay
  // ==========================================
  let divisionsCurrentDiv = 0;
  let divisionsCycleTimer: number | null = null;
  const divisionsDuration = 15000; // 15 seconds per division animation cycle

  const divisionCards = document.querySelectorAll('.division-card-interactive');

  function setDivisionsCardFocus(divIdx: number) {
    divisionsCurrentDiv = divIdx;
    divisionCards.forEach((card, idx) => {
      if (idx === divIdx) {
        card.classList.add('focused');
      } else {
        card.classList.remove('focused');
      }
    });

    // Update background overlay for division section
    window.dispatchEvent(new CustomEvent('division-change', {
      detail: {
        targetOverlayId: 'divisions-bg-overlay',
        divisionIndex: divIdx
      }
    }));
  }

  function startDivisionsCycle() {
    stopDivisionsCycle();
    divisionsCycleTimer = window.setTimeout(() => {
      const nextDiv = (divisionsCurrentDiv + 1) % 3;
      setDivisionsCardFocus(nextDiv);
      startDivisionsCycle();
    }, divisionsDuration);
  }

  function stopDivisionsCycle() {
    if (divisionsCycleTimer) {
      clearTimeout(divisionsCycleTimer);
      divisionsCycleTimer = null;
    }
  }

  // Card click or hover interaction
  divisionCards.forEach(card => {
    card.addEventListener('click', () => {
      const idx = parseInt(card.getAttribute('data-division-index') || '0', 10);
      setDivisionsCardFocus(idx);
      startDivisionsCycle();
    });
    card.addEventListener('mouseenter', () => {
      const idx = parseInt(card.getAttribute('data-division-index') || '0', 10);
      setDivisionsCardFocus(idx);
    });
  });

  // ==========================================
  // 4. In-View Section Handling
  // "division cycling should only effect the section in view"
  // ==========================================
  function handleSectionInViewChange() {
    // If Page 1 (Topology Stage) is active, run its cycle; otherwise pause it!
    if (currentPage === 1) {
      setStageDivision(stageCurrentDiv);
      startStageCycle();
    } else {
      stopStageCycle();
    }

    // If Page 2 (Core Divisions Stack) is active, run its cycle; otherwise pause it!
    if (currentPage === 2) {
      setDivisionsCardFocus(divisionsCurrentDiv);
      startDivisionsCycle();
    } else {
      stopDivisionsCycle();
    }
  }

  // Intercept header navigation links on the home page for instant slide transitions
  document.querySelectorAll('a[href^="/#"], a[href^="#"], [data-section-target]').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href') || '';
      const explicitTarget = link.getAttribute('data-section-target');
      
      let targetPage = -1;
      if (explicitTarget !== null && explicitTarget !== '') {
        targetPage = parseInt(explicitTarget, 10);
      } else if (href.includes('#core-systems') || href.includes('#systems') || href.includes('#stage') || href.includes('#section-2')) {
        targetPage = 1;
      } else if (href.includes('#products') || href.includes('#divisions') || href.includes('#stack') || href.includes('#section-3')) {
        targetPage = 2;
      } else if (href.includes('#overview') || href.includes('#hero') || href.includes('#section-1')) {
        targetPage = 0;
      }

      // If user clicks the products button while ALREADY on /#products (or on page 2), open /products catalog
      if (targetPage === 2) {
        const currentHash = window.location.hash.toLowerCase();
        const isOnProductsSlide = currentPage === 2 || 
                                  currentHash.includes('products') || 
                                  currentHash.includes('divisions') || 
                                  currentHash.includes('stack') || 
                                  currentHash.includes('section-3');
        if (isOnProductsSlide) {
          e.preventDefault();
          window.location.href = '/products';
          return;
        }
      }

      if (targetPage >= 0) {
        e.preventDefault();
        goToPage(targetPage);
      }
    });
  });

  // Check URL hash on page load and hashchange
  function handleHashNavigation() {
    const hash = window.location.hash.toLowerCase();
    if (hash.includes('core-systems') || hash.includes('systems') || hash.includes('stage') || hash.includes('section-2')) {
      goToPage(1);
    } else if (hash.includes('products') || hash.includes('divisions') || hash.includes('stack') || hash.includes('section-3')) {
      goToPage(2);
    } else if (hash.includes('overview') || hash.includes('hero') || hash.includes('section-1')) {
      goToPage(0);
    }
  }

  window.addEventListener('hashchange', handleHashNavigation);

  // Initialize
  handleSectionInViewChange();
  handleHashNavigation();
</script>
