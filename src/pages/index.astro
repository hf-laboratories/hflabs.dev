---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import DivisionBackgroundOverlay from '../components/DivisionBackgroundOverlay.astro';
import divisions from '../data/divisions.json';
---

<Layout 
  title="HFLabs — Systems Research, Swarm Metaheuristics & In-Memory GraphRAG"
  description="High-performance vector cognition, Intel Level Zero hardware acceleration, and autonomous swarm systems."
  isFullPage={true}
  hideFooter={true}
>
  <!-- Fullpage 3-Slide Presentation Container -->
  <div id="hflabs-fullpage-container" class="fullpage-slider">
    
    <!-- Floating Side Pagination Navigation -->
    <nav class="fullpage-nav" aria-label="Section Navigation">
      <button class="nav-dot active" data-target-page="0" title="01 Architecture Overview">
        <span class="dot-num">01</span>
        <span class="dot-label">Overview</span>
      </button>
      <button class="nav-dot" data-target-page="1" title="02 Interactive Topology Stage">
        <span class="dot-num">02</span>
        <span class="dot-label">Topology Stage</span>
      </button>
      <button class="nav-dot" data-target-page="2" title="03 Core Divisions Stack">
        <span class="dot-num">03</span>
        <span class="dot-label">Core Divisions</span>
      </button>
    </nav>

    <!-- Floating Wheel Click Progress Indicator -->
    <div id="wheel-progress-indicator" class="wheel-indicator" title="Scroll 3 wheel clicks to jump sections">
      <span class="wheel-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="5" y="2" width="14" height="20" rx="7"></rect>
          <line x1="12" y1="6" x2="12" y2="10"></line>
        </svg>
      </span>
      <div class="wheel-ticks">
        <span class="wheel-tick" id="tick-1"></span>
        <span class="wheel-tick" id="tick-2"></span>
        <span class="wheel-tick" id="tick-3"></span>
      </div>
      <span class="wheel-label">3 clicks to jump</span>
    </div>

    <!-- =========================================================================
         PAGE 1 / SLIDE 0: EXECUTIVE HERO & HIGH-ASSURANCE ARCHITECTURE OVERVIEW
         ========================================================================= -->
    <section class="page-slide slide-hero active-slide" id="page-0" data-page-index="0">
      <DivisionBackgroundOverlay id="hero-bg-overlay" initialDivision={0} opacity={1.0} />
      
      <div class="container slide-content">
        <div class="hero-top-badges">
          <span class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.35);">
            HFLabs Systems Architecture
          </span>
          <span class="badge" style="background:rgba(16,185,129,0.12); color:var(--accent-emerald); border:1px solid rgba(16,185,129,0.3);">
            Production Runtimes (.NET 10 &bull; C ABI &bull; Level Zero)
          </span>
        </div>

        <h1 class="hero-title">
          High-Assurance Systems, <br />
          <span class="text-gradient">SIMD Vector Cognition</span> &amp; Swarm Metaheuristics.
        </h1>

        <p class="hero-lead">
          Explore the primary engineering divisions of HFLabs: in-memory GraphRAG &amp; swarm optimization, heterogeneous ML &amp; query acceleration, and bare-metal Intel Level Zero / Poplar native substrates.
        </p>

        <!-- Systems Telemetry HUD Grid -->
        <div class="systems-hud-grid">
          <div class="hud-card" style="--card-border: #38bdf8;">
            <div class="hud-header">
              <span class="hud-dot" style="background:#38bdf8;"></span>
              <span class="hud-code">HYPERTENSOR GRAPHRAG</span>
            </div>
            <div class="hud-metric">0.15–1.95 ms</div>
            <div class="hud-sub">2-Hop in-memory graph traversal with 128-d SIMD TensorPrimitives.</div>
          </div>

          <div class="hud-card" style="--card-border: #06b6d4;">
            <div class="hud-header">
              <span class="hud-dot" style="background:#06b6d4;"></span>
              <span class="hud-code">FASTMCP PROTOCOL</span>
            </div>
            <div class="hud-metric">65+ Agent Tools</div>
            <div class="hud-sub">High-throughput agent integration via typed STDIO and HTTP transport.</div>
          </div>

          <div class="hud-card" style="--card-border: #a855f7;">
            <div class="hud-header">
              <span class="hud-dot" style="background:#a855f7;"></span>
              <span class="hud-code">LEVEL ZERO &amp; POPLAR</span>
            </div>
            <div class="hud-metric">407 Kernel Modules</div>
            <div class="hud-sub">37 distinct kernels precompiled across 11 Intel GPU targets.</div>
          </div>

          <div class="hud-card" style="--card-border: #f43f5e;">
            <div class="hud-header">
              <span class="hud-dot" style="background:#f43f5e;"></span>
              <span class="hud-code">ZERO-ALLOC ABI</span>
            </div>
            <div class="hud-metric">Span&lt;T&gt; &amp; AVX-512</div>
            <div class="hud-sub">Source-generated P/Invoke and direct C-linkage driver shims.</div>
          </div>
        </div>

        <!-- Hero Actions & Direct Section Jump Buttons -->
        <div class="hero-actions-row">
          <button class="btn-primary jump-to-stage-btn" data-jump-to="1">
            <span>Explore Topology Stage</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </button>
          <button class="btn-secondary jump-to-divisions-btn" data-jump-to="2">
            <span>Core Technology Stack</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
          <a href="/polyglot" class="btn-secondary">
            <span>Hyperpolyglot Matrix</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>

        <!-- Slide Scroll Prompt -->
        <div class="scroll-prompt-bar jump-to-stage-btn" data-jump-to="1" style="cursor: pointer;">
          <span class="prompt-mouse-pulse"></span>
          <span>Scroll down (3 clicks of scroll wheel) or click to jump &darr;</span>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         PAGE 2 / SLIDE 1: INTERACTIVE TOPOLOGY STAGE & NARRATIVE SCROLLYTELLING
         ========================================================================= -->
    <section class="page-slide slide-stage" id="page-1" data-page-index="1">
      <DivisionBackgroundOverlay id="stage-bg-overlay" initialDivision={0} opacity={1.0} />

      <div class="container slide-content">
        <!-- Stage Top Header -->
        <div class="stage-header-row">
          <div>
            <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:6px;">
              Interactive Scrollytelling Stage
            </div>
            <h2 class="stage-main-title">Systems Topology &amp; Architecture</h2>
          </div>

          <!-- Division Cycle Tabs -->
          <div class="stage-div-tabs" role="tablist">
            <button class="stage-tab active" data-stage-div="0" role="tab" style="--tab-color:#38bdf8;">
              <span class="tab-num">01</span>
              <span class="tab-txt">Cognition &amp; Swarm</span>
              <div class="tab-cycle-progress"></div>
            </button>
            <button class="stage-tab" data-stage-div="1" role="tab" style="--tab-color:#06b6d4;">
              <span class="tab-num">02</span>
              <span class="tab-txt">ML &amp; Acceleration</span>
              <div class="tab-cycle-progress"></div>
            </button>
            <button class="stage-tab" data-stage-div="2" role="tab" style="--tab-color:#f43f5e;">
              <span class="tab-num">03</span>
              <span class="tab-txt">Hardware Substrates</span>
              <div class="tab-cycle-progress"></div>
            </button>
          </div>
        </div>

        <!-- Stage Split Workspace -->
        <div class="stage-workspace-grid">
          <!-- Left: Narrative Information Card -->
          <div class="stage-narrative-panel">
            <div class="stage-narrative-card">
              <div class="card-top-meta">
                <span id="stageDivBadge" class="div-identity-badge">DIVISION 01</span>
                <span class="cycle-status-pill">
                  <span class="pulse-dot"></span>
                  <span id="cycleStatusText">Active Cycle (15s)</span>
                </span>
              </div>

              <div class="stage-card-anim-target" id="stageNarrativeAnimGroup">
                <h3 id="stageDivTitle" class="stage-narrative-heading">Cognition &amp; Swarm Intelligence</h3>
                <p id="stageDivDesc" class="stage-narrative-body">
                  In-memory graph retrieval, SIMD vector search, and multi-algorithm swarm optimization. Keeps the entire graph resident in RAM to eliminate disk-bound lookups, powering agent reasoning through FastMCP and desktop visualization HUDs.
                </p>

                <!-- Dynamic Project Badges -->
                <div id="stageProjectPills" class="stage-pills-row">
                  <span class="stage-pill">Hypertensor GraphRAG</span>
                  <span class="stage-pill">HyperSwarm Suite</span>
                  <span class="stage-pill">SwarmDev</span>
                </div>

                <!-- Metric Stats Grid (Sequential Telemetry Scanner) -->
                <div class="stage-metrics-trio" id="stageMetricsTrio">
                  <div class="metric-trio-item" id="stageMetricItem1" data-metric-idx="0">
                    <span id="stageMetricLbl1" class="metric-lbl">2-Hop Traversal</span>
                    <strong id="stageMetricVal1" class="metric-val">0.15–1.95 ms</strong>
                  </div>
                  <div class="metric-trio-item" id="stageMetricItem2" data-metric-idx="1">
                    <span id="stageMetricLbl2" class="metric-lbl">SIMD Vectors</span>
                    <strong id="stageMetricVal2" class="metric-val">128-d Default</strong>
                  </div>
                  <div class="metric-trio-item" id="stageMetricItem3" data-metric-idx="2">
                    <span id="stageMetricLbl3" class="metric-lbl">MCP Connectivity</span>
                    <strong id="stageMetricVal3" class="metric-val">65+ Tools</strong>
                  </div>
                </div>
              </div>

              <div class="stage-action-row">
                <a id="stageProductLink" href="/products/ht-graphrag" class="btn-primary" style="font-size:12px; padding:6px 14px;">
                  Explore Products &rarr;
                </a>
                <button class="stage-pause-btn" id="stagePauseBtn" title="Pause / Resume Auto-Cycle">
                  <span class="pause-icon">&#10074;&#10074;</span>
                  <span class="pause-text">Pause Cycle</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Right: Live Interactive Visualizer Diagram & Telemetry -->
          <div class="stage-visualizer-panel">
            <div class="visualizer-display-box">
              <div class="visualizer-bar">
                <div class="bar-left">
                  <span class="green-status-dot"></span>
                  <span id="visHeaderTitle" class="vis-header-text">Cognition &amp; Swarm Intelligence</span>
                </div>
                <span id="visHeaderBadge" class="vis-header-tag">DIVISION 01</span>
              </div>

              <div class="stage-vis-anim-target" id="stageVisAnimGroup">
                <!-- Live Node Mesh Diagram -->
                <div class="diagram-mesh-wrapper">
                  <div class="diagram-nodes-grid" id="stageNodesGrid">
                    <div class="diagram-node node-primary" id="vnode-1">
                      <span class="node-icon">🧠</span>
                      <div class="node-text">
                        <span class="node-title">Hypertensor GraphRAG</span>
                        <span class="node-sub">In-Memory Typed Store</span>
                      </div>
                    </div>
                    <div class="diagram-link link-h" id="vlink-1">
                      <span class="link-pulse"></span>
                    </div>
                    <div class="diagram-node node-secondary" id="vnode-2">
                      <span class="node-icon">⚡</span>
                      <div class="node-text">
                        <span class="node-title">SIMD TensorPrimitives</span>
                        <span class="node-sub">128-d Vector Cosine</span>
                      </div>
                    </div>
                    <div class="diagram-node node-secondary" id="vnode-3">
                      <span class="node-icon">🐝</span>
                      <div class="node-text">
                        <span class="node-title">HyperSwarm Suite</span>
                        <span class="node-sub">Director Authority</span>
                      </div>
                    </div>
                    <div class="diagram-link link-h" id="vlink-2">
                      <span class="link-pulse"></span>
                    </div>
                    <div class="diagram-node node-primary" id="vnode-4">
                      <span class="node-icon">🔌</span>
                      <div class="node-text">
                        <span class="node-title">FastMCP Server</span>
                        <span class="node-sub">65+ Agent Tools</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Dynamic Terminal Telemetry Stream -->
                <div class="stage-terminal-stream">
                  <div class="term-header">
                    <span class="term-dot red"></span>
                    <span class="term-dot yellow"></span>
                    <span class="term-dot green"></span>
                    <span class="term-title">HFLABS TELEMETRY KERNEL</span>
                  </div>
                  <code id="stageTerminalText" class="term-output">
                    [Cognition &amp; Swarm] Hypertensor GraphRAG: 2-hop traversal in 0.15 ms | SIMD 128d | FastMCP 65+ tools active
                  </code>
                </div>

                <!-- Stage Bottom Hardware Telemetry -->
                <div class="stage-vis-footer">
                  <div class="vis-footer-stat">
                    <span id="visStatLbl1" class="vf-lbl">Graph Residency</span>
                    <strong id="visStatVal1" class="vf-val">In-Memory RAM</strong>
                  </div>
                  <div class="vis-footer-stat">
                    <span id="visStatLbl2" class="vf-lbl">Vector Engine</span>
                    <strong id="visStatVal2" class="vf-val">SIMD TensorPrimitives</strong>
                  </div>
                  <div class="vis-footer-stat">
                    <span id="visStatLbl3" class="vf-lbl">Agent Protocol</span>
                    <strong id="visStatVal3" class="vf-val">FastMCP (65+ Tools)</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         PAGE 3 / SLIDE 2: CORE TECHNOLOGY STACK & DIVISIONS GRID (+ FOOTER)
         ========================================================================= -->
    <section class="page-slide slide-divisions" id="page-2" data-page-index="2">
      <DivisionBackgroundOverlay id="divisions-bg-overlay" initialDivision={0} opacity={1.0} />

      <div class="container slide-content divisions-slide-inner">
        <!-- Section Header -->
        <div class="divisions-top-bar">
          <div class="div-top-title-group">
            <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3);">
              Core Technology Stack
            </div>
            <h2 class="divisions-main-heading">3 Specialized Divisions</h2>
          </div>
          <p class="divisions-sub-desc">
            High-assurance architectures spanning in-memory GraphRAG, autonomous swarm optimization, LevelZero.NET GPU acceleration, and bare-metal compute substrates.
          </p>
        </div>

        <!-- 3-Division Bento Cards Grid -->
        <div class="divisions-grid-trio">
          {divisions.map((div, idx) => (
            <div 
              id={`div-card-${idx}`}
              class={`division-card-interactive ${idx === 0 ? 'focused' : ''}`}
              data-division-index={idx}
              style={`--div-accent:${div.color};`}
            >
              <div class="card-focus-indicator">
                <span class="focus-ring"></span>
                <span class="focus-text">Active Focused Division</span>
                <div class="focus-countdown-bar"></div>
              </div>

              <div class="div-card-head">
                <span class="div-card-icon">{div.icon}</span>
                <div>
                  <h3 class="div-card-name">{div.name}</h3>
                  <span class="div-card-badge">{div.badge}</span>
                </div>
              </div>

              <p class="div-card-tagline">{div.tagline}</p>

              <div class="div-card-projects">
                <h4>Core Projects &amp; Runtimes</h4>
                <ul class="projects-scroller">
                  {div.projects.map(p => (
                    <li class="project-mini-item">
                      <div class="proj-title-row">
                        <strong class="p-name">{p.name}</strong>
                        <span class={`p-status status-${p.status.toLowerCase().replace(/\s+/g, '-')}`}>{p.status}</span>
                      </div>
                      <p class="p-desc">{p.description}</p>
                      {p.name.includes("GraphRAG") && (
                        <a href="/products/ht-graphrag" class="p-link-btn">HT GraphRAG Product Page &rarr;</a>
                      )}
                      {p.name.includes("HyperSwarm") && (
                        <a href="/products/hyperswarm" class="p-link-btn">HyperSwarm Product Page &rarr;</a>
                      )}
                      {p.name.includes("SwarmDev") && (
                        <a href="/products/swarmdev" class="p-link-btn">SwarmDev Product Page &rarr;</a>
                      )}
                      {p.name.includes("SwarmBench") && (
                        <a href="/products/swarmbench" class="p-link-btn">SwarmBench Product Page &rarr;</a>
                      )}
                      {p.name.includes("AutoMLApp") && (
                        <a href="/products/automlapp" class="p-link-btn">AutoMLApp Product Page &rarr;</a>
                      )}
                      {p.name.includes("Machine Learning Suite") && (
                        <a href="/products/ml-suite" class="p-link-btn">ML Suite Product Page &rarr;</a>
                      )}
                      {p.name === "Accelerator" && (
                        <a href="/products/accelerator" class="p-link-btn">Accelerator Product Page &rarr;</a>
                      )}
                      {(p.name.includes("QueryAccel") || p.name.includes("IPU SQL")) && (
                        <a href="/products/queryaccel" class="p-link-btn">QueryAccel Product Page &rarr;</a>
                      )}
                      {p.name.includes("LevelZero") && (
                        <a href="/products/levelzero" class="p-link-btn">LevelZero.NET Product Page &rarr;</a>
                      )}
                      {p.name.includes("Poplar") && (
                        <a href="/products/poplar" class="p-link-btn">Poplar.NET Product Page &rarr;</a>
                      )}
                      {p.name.includes("Abigen") && (
                        <a href="/products/abigen" class="p-link-btn">Abigen Product Page &rarr;</a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <!-- Integrated Compact Slide Footer -->
        <footer class="slide-footer-ribbon">
          <div class="footer-ribbon-left">
            <span class="ribbon-brand">&copy; {new Date().getFullYear()} HFLabs</span>
            <span class="ribbon-sep">&bull;</span>
            <span class="ribbon-license">MIT &amp; High-Assurance Commercial Licenses</span>
            <span class="ribbon-sep">&bull;</span>
            <span class="ribbon-disclaimer">All hardware trademarks belong to respective owners.</span>
          </div>
          <div class="footer-ribbon-links">
            <a href="/polyglot">Polyglot Matrix</a>
            <a href="/schemas">Schemas</a>
            <a href="/docs">Docs</a>
            <a href="/about">About</a>
            <a href="https://github.com/hf-laboratories" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </footer>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* Fullpage Slider Layout */
  .fullpage-slider {
    position: relative;
    width: 100%;
    height: calc(100vh - 65px);
    overflow: hidden;
  }

  .page-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transform: translateY(30px) scale(0.985);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .page-slide.active-slide {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    z-index: 10;
  }

  .slide-content {
    position: relative;
    z-index: 5;
    width: 100%;
    padding: 24px 0;
    max-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Floating Navigation Dots */
  .fullpage-nav {
    position: fixed;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 150;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .nav-dot {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.25s ease;
  }

  .nav-dot:hover {
    border-color: var(--accent-blue);
    color: #fff;
    transform: translateX(-4px);
  }

  .nav-dot.active {
    background: rgba(56, 189, 248, 0.18);
    border-color: var(--accent-blue);
    color: #fff;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.3);
  }

  .dot-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  .dot-label {
    font-size: 11px;
    font-weight: 600;
  }

  /* Wheel Click Indicator */
  .wheel-indicator {
    position: fixed;
    bottom: 20px;
    right: 24px;
    z-index: 150;
    background: rgba(8, 12, 24, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 5px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .wheel-ticks {
    display: flex;
    gap: 4px;
  }

  .wheel-tick {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    transition: background 0.15s, transform 0.15s;
  }

  .wheel-tick.active {
    background: var(--accent-blue);
    transform: scale(1.3);
    box-shadow: 0 0 8px var(--accent-blue);
  }

  /* Page 1 (Hero) Styles */
  .hero-top-badges {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #f8fafc;
    margin-bottom: 14px;
  }

  .text-gradient {
    background: linear-gradient(135deg, #38bdf8, #818cf8, #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 820px;
    margin-bottom: 22px;
  }

  .systems-hud-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .hud-card {
    background: rgba(12, 18, 34, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-top: 2px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    backdrop-filter: blur(8px) saturate(200%);
    -webkit-backdrop-filter: blur(8px) saturate(200%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.2), 0 8px 24px -4px rgba(0, 0, 0, 0.35);
    transition: all 0.2s ease;
  }

  .hud-card:hover {
    transform: translateY(-2px);
    background: rgba(22, 33, 62, 0.45);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.3), 0 12px 30px -4px rgba(0, 0, 0, 0.45), 0 0 16px rgba(56, 189, 248, 0.2);
  }

  .hud-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .hud-code {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
  }

  .hud-metric {
    font-size: 16px;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 4px;
  }

  .hud-sub {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .hero-actions-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .scroll-prompt-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .scroll-prompt-bar:hover {
    color: var(--accent-blue);
  }

  .prompt-mouse-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 10px var(--accent-blue);
    animation: mousePulse 1.5s infinite;
  }

  @keyframes mousePulse {
    0% { transform: scale(0.8); opacity: 0.5; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.8); opacity: 0.5; }
  }

  /* Page 2 (Stage) Styles */
  .stage-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .stage-main-title {
    font-size: 24px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .stage-div-tabs {
    display: flex;
    gap: 8px;
  }

  .stage-tab {
    position: relative;
    background: rgba(10, 15, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 7px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .stage-tab:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .stage-tab.active {
    color: #fff;
    border-color: var(--tab-color);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-num {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--tab-color);
    font-weight: 700;
  }

  .tab-cycle-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--tab-color);
    width: 0%;
    transition: width 0.1s linear;
  }

  .stage-tab.active .tab-cycle-progress {
    width: 100%;
    transition: width 15s linear;
  }

  .stage-workspace-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: stretch;
  }

  .stage-narrative-card {
    background: rgba(12, 18, 34, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: 22px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    backdrop-filter: blur(8px) saturate(200%);
    -webkit-backdrop-filter: blur(8px) saturate(200%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.2), 0 12px 32px 0 rgba(0, 0, 0, 0.35);
  }

  .stage-card-anim-target,
  .stage-vis-anim-target {
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stage-card-anim-target.fading,
  .stage-vis-anim-target.fading {
    opacity: 0.1;
    transform: translateY(4px);
  }

  .card-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .div-identity-badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .cycle-status-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-emerald);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 6px var(--accent-emerald);
    animation: mousePulse 1.2s infinite;
  }

  .stage-narrative-heading {
    font-size: 20px;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 8px;
  }

  .stage-narrative-body {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .stage-pills-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .stage-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    padding: 3px 8px;
    border-radius: 4px;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    user-select: none;
  }

  .stage-pill:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .stage-pill.is-lit {
    background: rgba(var(--active-color-rgb, 56, 189, 248), 0.22);
    border-color: var(--active-color, #38bdf8);
    color: #ffffff;
    box-shadow: 0 0 14px rgba(var(--active-color-rgb, 56, 189, 248), 0.45);
    transform: translateY(-1px) scale(1.04);
    font-weight: 600;
  }

  .stage-pill.is-lit::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--active-color, #38bdf8);
    box-shadow: 0 0 6px var(--active-color, #38bdf8);
    animation: pillBeaconPulse 1.2s infinite ease-in-out;
  }

  @keyframes pillBeaconPulse {
    0%, 100% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }

  .stage-pill.is-dimmed {
    opacity: 0.42;
  }

  .stage-metrics-trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 10px;
    margin-bottom: 16px;
    position: relative;
  }

  .metric-trio-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    user-select: none;
  }

  .metric-trio-item::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    transition: all 0.35s ease;
  }

  .metric-trio-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .metric-trio-item.is-lit {
    background: rgba(var(--active-color-rgb, 56, 189, 248), 0.12);
    border-color: rgba(var(--active-color-rgb, 56, 189, 248), 0.65);
    box-shadow: 0 0 16px rgba(var(--active-color-rgb, 56, 189, 248), 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .metric-trio-item.is-lit::after {
    background: var(--active-color, #38bdf8);
    box-shadow: 0 0 8px var(--active-color, #38bdf8);
  }

  .metric-trio-item.is-lit .metric-lbl {
    color: var(--active-color, #38bdf8);
    font-weight: 600;
  }

  .metric-trio-item.is-lit .metric-val {
    color: #ffffff;
    text-shadow: 0 0 10px rgba(var(--active-color-rgb, 56, 189, 248), 0.65);
  }

  .metric-trio-item.is-dimmed {
    opacity: 0.45;
  }

  .metric-lbl {
    font-size: 9.5px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .metric-val {
    font-size: 12.5px;
    color: #f8fafc;
    transition: all 0.3s ease;
  }

  .stage-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stage-pause-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stage-pause-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* Visualizer Display Box */
  .visualizer-display-box {
    background: rgba(10, 15, 28, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: 16px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    backdrop-filter: blur(8px) saturate(200%);
    -webkit-backdrop-filter: blur(8px) saturate(200%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.18), 0 12px 32px 0 rgba(0, 0, 0, 0.35);
  }

  .visualizer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .green-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
  }

  .vis-header-text {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
  }

  .vis-header-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-blue);
  }

  .diagram-mesh-wrapper {
    background: #020409;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 12px;
  }

  .diagram-nodes-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto;
    gap: 10px 12px;
    align-items: center;
  }

  .diagram-node {
    background: #080c18;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .diagram-node.is-lit {
    background: rgba(var(--active-color-rgb, 56, 189, 248), 0.16);
    border-color: var(--active-color, #38bdf8);
    box-shadow: 0 0 18px rgba(var(--active-color-rgb, 56, 189, 248), 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transform: scale(1.03);
  }

  .diagram-node.is-lit .node-title {
    color: #ffffff;
    text-shadow: 0 0 8px rgba(var(--active-color-rgb, 56, 189, 248), 0.5);
  }

  .diagram-node.is-lit .node-sub {
    color: var(--active-color, #38bdf8);
  }

  .diagram-node.is-lit .node-icon {
    transform: scale(1.15);
    filter: drop-shadow(0 0 8px var(--active-color, #38bdf8));
  }

  .diagram-node.is-dimmed {
    opacity: 0.4;
  }

  .node-icon {
    font-size: 16px;
  }

  .node-text {
    display: flex;
    flex-direction: column;
  }

  .node-title {
    font-size: 11.5px;
    font-weight: 700;
    color: #f8fafc;
  }

  .node-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-muted);
  }

  .diagram-link {
    height: 2px;
    background: rgba(56, 189, 248, 0.2);
    position: relative;
    width: 24px;
  }

  .link-pulse {
    position: absolute;
    width: 6px;
    height: 6px;
    top: -2px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
    animation: linkTravel 2s infinite ease-in-out;
  }

  @keyframes linkTravel {
    0% { left: 0; }
    100% { left: calc(100% - 6px); }
  }

  .stage-terminal-stream {
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    margin-bottom: 12px;
  }

  .term-header {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 4px;
  }

  .term-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .term-dot.red { background: #ef4444; }
  .term-dot.yellow { background: #eab308; }
  .term-dot.green { background: #22c55e; }

  .term-title {
    font-family: var(--font-mono);
    font-size: 8.5px;
    color: var(--text-muted);
    margin-left: 4px;
    letter-spacing: 0.05em;
  }

  .term-output {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #38bdf8;
    line-height: 1.4;
    display: block;
  }

  .stage-vis-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 8px;
  }

  .vis-footer-stat {
    display: flex;
    flex-direction: column;
  }

  .vf-lbl {
    font-size: 9px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .vf-val {
    font-size: 11px;
    color: #e2e8f0;
  }

  /* Page 3 (Divisions Stack) Styles */
  .slide-divisions {
    align-items: stretch;
    overflow: hidden;
  }

  .slide-divisions .slide-content {
    height: 100%;
    max-height: calc(100vh - 65px);
    padding: 16px 0 14px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .divisions-slide-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    justify-content: space-between;
    gap: 12px;
  }

  .divisions-top-bar {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .div-top-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .divisions-main-heading {
    font-size: 22px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .divisions-sub-desc {
    font-size: 12px;
    color: var(--text-secondary);
    max-width: 620px;
    line-height: 1.4;
  }

  .divisions-grid-trio {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 8px;
    align-items: stretch;
  }

  .division-card-interactive {
    position: relative;
    background: rgba(12, 18, 34, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-top: 3px solid var(--div-accent);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    cursor: pointer;
    backdrop-filter: blur(8px) saturate(200%);
    -webkit-backdrop-filter: blur(8px) saturate(200%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.2), 0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .division-card-interactive:hover {
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(22, 33, 62, 0.45);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.3), 0 12px 36px 0 rgba(0, 0, 0, 0.45);
  }

  .division-card-interactive.focused {
    border-color: var(--div-accent);
    background: rgba(20, 30, 58, 0.55);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.3), 0 0 28px rgba(0, 0, 0, 0.6), 0 0 24px color-mix(in srgb, var(--div-accent) 35%, transparent);
    transform: translateY(-2px);
  }

  .card-focus-indicator {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    padding: 4px 8px;
    position: relative;
    overflow: hidden;
  }

  .focus-ring {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .division-card-interactive.focused .focus-ring {
    background: var(--div-accent);
    box-shadow: 0 0 8px var(--div-accent);
  }

  .focus-text {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-muted);
  }

  .division-card-interactive.focused .focus-text {
    color: var(--div-accent);
    font-weight: 700;
  }

  .focus-countdown-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--div-accent);
    width: 0%;
  }

  .division-card-interactive.focused .focus-countdown-bar {
    width: 100%;
    transition: width 15s linear;
  }

  .div-card-head {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .div-card-icon {
    font-size: 22px;
  }

  .div-card-name {
    font-size: 15px;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.25;
  }

  .div-card-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--div-accent);
  }

  .div-card-tagline {
    flex-shrink: 0;
    font-size: 11.5px;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .div-card-projects {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .div-card-projects h4 {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }

  .projects-scroller {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
    padding-right: 6px;
  }

  .projects-scroller::-webkit-scrollbar {
    width: 4px;
  }

  .projects-scroller::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }

  .projects-scroller::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
  }

  .projects-scroller::-webkit-scrollbar-thumb:hover {
    background: var(--accent-blue);
  }

  .project-mini-item {
    background: rgba(0, 0, 0, 0.38);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color 0.2s;
  }

  .project-mini-item:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .proj-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .p-name {
    font-size: 12.5px;
    font-weight: 700;
    color: #f8fafc;
  }

  .p-status {
    font-family: var(--font-mono);
