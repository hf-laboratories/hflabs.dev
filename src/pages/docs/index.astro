---
// src/pages/docs/index.astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allDocs = await getCollection('docs');

// Sort docs by order
const sortedDocs = allDocs.sort((a, b) => {
  if (a.data.category === b.data.category) {
    return (a.data.order ?? 99) - (b.data.order ?? 99);
  }
  return a.data.category.localeCompare(b.data.category);
});

// Default doc to display at /docs
const defaultDoc = sortedDocs.find((d) => d.id === 'getting-started') || sortedDocs[0];
const { Content, headings } = await render(defaultDoc);

// Group docs by category
const categories: Record<string, typeof allDocs> = {};
const categoryOrder = [
  "Overview & Setup",
  "GraphRAG & Cognition",
  "Optimization & Swarms",
  "Machine Learning Suite",
  "Hardware & Substrates",
  "Tooling & DevOps"
];

sortedDocs.forEach((d) => {
  const cat = d.data.category || "General";
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(d);
});

const orderedCategories = Object.keys(categories).sort((a, b) => {
  const idxA = categoryOrder.indexOf(a);
  const idxB = categoryOrder.indexOf(b);
  if (idxA !== -1 && idxB !== -1) return idxA - idxB;
  if (idxA !== -1) return -1;
  if (idxB !== -1) return 1;
  return a.localeCompare(b);
});

const nextDoc = sortedDocs.length > 1 ? sortedDocs[1] : null;

const categoryIcons: Record<string, string> = {
  "Overview & Setup": "🚀",
  "GraphRAG & Cognition": "🧠",
  "Optimization & Swarms": "🌊",
  "Machine Learning Suite": "🎯",
  "Hardware & Substrates": "⚡",
  "Tooling & DevOps": "🛠️"
};
---

<Layout 
  title={`${defaultDoc.data.title} • HFLabs Docs`}
  description={defaultDoc.data.description}
>
  <div class="docs-app">
    <!-- Top Mobile Header Bar -->
    <div class="docs-mobile-bar">
      <button id="mobile-sidebar-toggle" class="mobile-toggle-btn" aria-label="Toggle Navigation">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Docs Menu</span>
      </button>
      <span class="mobile-current-title">{defaultDoc.data.title}</span>
    </div>

    <div class="docs-layout-container container">
      <!-- Left Navigation Sidebar -->
      <aside id="docs-sidebar" class="docs-sidebar">
        <div class="sidebar-header">
          <div class="sidebar-title-row">
            <span class="sidebar-title">Documentation</span>
            <span class="version-pill">.NET 10 &bull; AOT</span>
          </div>
          <!-- Live Search Input -->
          <div class="search-box">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              id="doc-search-input" 
              placeholder="Filter manuals & guides..." 
              autocomplete="off"
            />
          </div>
        </div>

        <nav class="sidebar-nav" id="sidebar-nav">
          {orderedCategories.map((category) => (
            <div class="nav-category-group" data-category={category}>
              <div class="category-header">
                <span class="category-icon">{categoryIcons[category] || "📁"}</span>
                <span class="category-name">{category}</span>
                <span class="category-badge">{categories[category].length}</span>
              </div>
              <ul class="category-list">
                {categories[category].map((item) => {
                  const isActive = item.id === defaultDoc.id;
                  return (
                    <li class={`nav-item ${isActive ? 'active' : ''}`} data-doc-title={item.data.title.toLowerCase()} data-doc-tags={item.data.tags?.join(' ').toLowerCase() || ''}>
                      <a href={`/docs/${item.id}`} class="nav-link">
                        <span class="nav-item-title">{item.data.title}</span>
                        {item.data.badge && (
                          <span class={`nav-item-badge ${isActive ? 'badge-active' : ''}`}>
                            {item.data.badge}
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          <div id="no-search-results" class="no-results hidden">
            No matching documents found.
          </div>
        </nav>

        <div class="sidebar-footer">
          <a href="https://github.com/hf-laboratories" target="_blank" rel="noopener noreferrer" class="repo-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>hf-laboratories / hflabs</span>
          </a>
        </div>
      </aside>

      <!-- Center Document Reader -->
      <main class="docs-content-area">
        <!-- Breadcrumb & Tag Row -->
        <div class="content-header-top">
          <nav class="breadcrumb">
            <a href="/">Home</a>
            <span class="sep">/</span>
            <a href="/docs">Docs</a>
            <span class="sep">/</span>
            <span class="cat">{defaultDoc.data.category}</span>
            <span class="sep">/</span>
            <span class="curr">{defaultDoc.data.title}</span>
          </nav>
        </div>

        <article class="doc-article">
          <!-- Document Header Card -->
          <header class="doc-header-card">
            <div class="doc-badge-row">
              <span class="badge badge-cyan">{defaultDoc.data.category.toUpperCase()}</span>
              {defaultDoc.data.badge && (
                <span class="badge badge-emerald">{defaultDoc.data.badge.toUpperCase()}</span>
              )}
              <span class="badge badge-purple">LOCAL AIR-GAPPED</span>
            </div>
            <h1 class="doc-main-title">{defaultDoc.data.title}</h1>
            <p class="doc-main-desc">{defaultDoc.data.description}</p>
            {defaultDoc.data.tags && defaultDoc.data.tags.length > 0 && (
              <div class="doc-tags-list">
                {defaultDoc.data.tags.map((tag) => (
                  <span class="doc-tag">#{tag}</span>
                ))}
              </div>
            )}
          </header>

          <!-- Rendered Markdown Body -->
          <div class="markdown-body">
            <Content />
          </div>

          <!-- Bottom Navigation Links -->
          <div class="doc-pagination">
            <div />
            {nextDoc && (
              <a href={`/docs/${nextDoc.id}`} class="pagination-btn next">
                <span class="pag-label">Next &rarr;</span>
                <span class="pag-title">{nextDoc.data.title}</span>
              </a>
            )}
          </div>
        </article>
      </main>

      <!-- Right On-Page Table of Contents (Desktop) -->
      {headings && headings.length > 0 && (
        <aside class="docs-toc-sidebar">
          <div class="toc-container">
            <span class="toc-title">On This Page</span>
            <ul class="toc-list">
              {headings.filter(h => h.depth <= 3).map((h) => (
                <li class={`toc-item depth-${h.depth}`}>
                  <a href={`#${h.slug}`} class="toc-link">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
            <div class="toc-actions">
              <a href="#top" class="back-to-top">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 15l-6-6-6 6"/>
                </svg>
                <span>Back to top</span>
              </a>
            </div>
          </div>
        </aside>
      )}
    </div>
  </div>
</Layout>

<script>
  // Search and Filter functionality for sidebar
  const searchInput = document.getElementById('doc-search-input') as HTMLInputElement;
  const navItems = document.querySelectorAll('.category-list .nav-item');
  const categoryGroups = document.querySelectorAll('.nav-category-group');
  const noResults = document.getElementById('no-search-results');

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      let totalVisible = 0;

      categoryGroups.forEach((group) => {
        let groupVisibleCount = 0;
        const items = group.querySelectorAll('.nav-item');

        items.forEach((item) => {
          const title = item.getAttribute('data-doc-title') || '';
          const tags = item.getAttribute('data-doc-tags') || '';
          const matches = title.includes(query) || tags.includes(query);

          if (matches || query === '') {
            (item as HTMLElement).style.display = 'block';
            groupVisibleCount++;
            totalVisible++;
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });

        if (groupVisibleCount === 0 && query !== '') {
          (group as HTMLElement).style.display = 'none';
        } else {
          (group as HTMLElement).style.display = 'block';
        }
      });

      if (noResults) {
        if (totalVisible === 0 && query !== '') {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    });
  }

  // Mobile sidebar drawer toggle
  const mobileToggle = document.getElementById('mobile-sidebar-toggle');
  const sidebar = document.getElementById('docs-sidebar');

  if (mobileToggle && sidebar) {
    mobileToggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
    });
  }

  // Add copy button to all pre code blocks in markdown body
  document.querySelectorAll('.markdown-body pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const copyBtn = document.createElement('button');
    copyBtn.className = 'copy-code-btn';
    copyBtn.innerHTML = `
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span>Copy</span>
    `;

    copyBtn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText || pre.innerText;
      await navigator.clipboard.writeText(code);
      copyBtn.classList.add('copied');
      copyBtn.innerHTML = `
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span style="color:#10b981">Copied!</span>
      `;
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy</span>
        `;
      }, 2000);
    });

    wrapper.appendChild(copyBtn);
  });
</script>

<style>
  .docs-app {
    min-height: calc(100vh - 70px);
    background: #060912;
  }

  .docs-mobile-bar {
    display: none;
    background: #090e1c;
    border-bottom: 1px solid var(--border-color);
    padding: 10px 16px;
    align-items: center;
    gap: 12px;
    position: sticky;
    top: 60px;
    z-index: 90;
  }

  @media (max-width: 900px) {
    .docs-mobile-bar {
      display: flex;
    }
  }

  .mobile-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--accent-blue);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }

  .mobile-current-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .docs-layout-container {
    display: grid;
    grid-template-columns: 280px 1fr 240px;
    gap: 32px;
    padding-top: 32px;
    padding-bottom: 80px;
  }

  @media (max-width: 1200px) {
    .docs-layout-container {
      grid-template-columns: 260px 1fr;
    }
    .docs-toc-sidebar {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .docs-layout-container {
      grid-template-columns: 1fr;
      padding-top: 20px;
    }
    .docs-sidebar {
      display: none;
      position: fixed;
      top: 105px;
      left: 0;
      width: 300px;
      height: calc(100vh - 105px);
      z-index: 95;
      background: #080c18;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
    }
    .docs-sidebar.open {
      display: flex;
    }
  }

  /* Left Sidebar */
  .docs-sidebar {
    background: #080c18;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    height: calc(100vh - 110px);
    position: sticky;
    top: 90px;
    overflow: hidden;
  }

  .sidebar-header {
    padding: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .sidebar-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .sidebar-title {
    font-size: 14px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .version-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .search-box {
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    background: #050811;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 8px 10px 8px 30px;
    font-size: 12px;
    color: #f1f5f9;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-box input:focus {
    border-color: var(--accent-blue);
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-category-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--font-mono);
  }

  .category-icon {
    font-size: 13px;
  }

  .category-name {
    flex: 1;
  }

  .category-badge {
    background: rgba(255, 255, 255, 0.05);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 10px;
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item {
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  .nav-item.active {
    background: rgba(56, 189, 248, 0.12);
    border-left: 2px solid var(--accent-blue);
  }

  .nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 10px;
    font-size: 12.5px;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.35;
    gap: 6px;
  }

  .nav-item:hover:not(.active) .nav-link {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-sm);
  }

  .nav-item.active .nav-link {
    color: #ffffff;
    font-weight: 600;
  }

  .nav-item-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    padding: 1px 5px;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-item-badge.badge-active {
    background: rgba(56, 189, 248, 0.2);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .no-results {
    font-size: 12px;
    color: var(--text-muted);
    padding: 16px;
    text-align: center;
  }

  .hidden {
    display: none !important;
  }

  .sidebar-footer {
    padding: 12px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: #050811;
  }

  .repo-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-decoration: none;
  }

  .repo-link:hover {
    color: var(--accent-blue);
  }

  /* Center Document Reader */
  .docs-content-area {
    min-width: 0;
  }

  .content-header-top {
    margin-bottom: 18px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-blue);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .breadcrumb .cat {
    color: var(--text-muted);
  }

  .breadcrumb .curr {
    color: var(--text-primary);
  }

  .doc-article {
    background: #080c18;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 768px) {
    .doc-article {
      padding: 24px 18px;
    }
  }

  .doc-header-card {
    padding-bottom: 28px;
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .doc-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .doc-main-title {
    font-size: 34px;
    font-weight: 900;
    color: #f8fafc;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .doc-main-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .doc-tags-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .doc-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 2px 7px;
    border-radius: 4px;
  }

  /* Rendered Markdown Typography */
  .markdown-body {
    color: #cbd5e1;
    font-size: 14.5px;
    line-height: 1.7;
  }

  .markdown-body :global(h1) {
    display: none; /* Already rendered in doc-header-card */
  }

  .markdown-body :global(h2) {
    font-size: 22px;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 36px;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    letter-spacing: -0.01em;
  }

  .markdown-body :global(h3) {
    font-size: 17px;
    font-weight: 700;
    color: #f1f5f9;
    margin-top: 24px;
    margin-bottom: 10px;
  }

  .markdown-body :global(p) {
    margin-bottom: 16px;
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 18px;
    padding-left: 24px;
  }

  .markdown-body :global(li) {
    margin-bottom: 6px;
  }

  .markdown-body :global(strong) {
    color: #f8fafc;
  }

  .markdown-body :global(code) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    color: #38bdf8;
  }

  .markdown-body :global(.code-block-wrapper) {
    position: relative;
    margin-bottom: 20px;
  }

  .markdown-body :global(pre) {
    background: #040711;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: #e2e8f0;
  }

  .markdown-body :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }

  .markdown-body :global(.copy-code-btn) {
    position: absolute;
