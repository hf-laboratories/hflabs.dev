---
// docs/index.astro
import Layout from '../../layouts/Layout.astro';

const guides = [
  {
    title: "Hypertensor GraphRAG & SIMD Vectors",
    slug: "graphrag-operator",
    badge: "Vector Cognition",
    desc: "Deploy, configure, and operate the in-memory Hypertensor GraphRAG engine, SIMD vector index, and FastMCP host bridge.",
    commands: [
      "dotnet run --project src/HFLabs/Products/HypertensorGraphRAG/Server/Server.csproj -c Release",
      "dotnet run --project src/HFLabs/Products/HypertensorGraphRAG/App/App.csproj -c Release -- --headless --query \"Director\"",
      "python -m mcp_graphrag.server --transport sse --port 8000"
    ]
  },
  {
    title: "HyperSwarm Optimization Suite, SwarmML & SwarmDev",
    slug: "swarm-benchmark",
    badge: "Swarm Metaheuristics",
    desc: "Execute matrix sweeps, dynamic Director authority switching, SwarmML hyperparameter search, and SwarmDev benchmarks.",
    commands: [
      "dotnet run --project src/HFLabs/Products/HyperSwarmOptimizationSuite/BenchmarkRunner.csproj -c Release -- matrix-sweep",
      "dotnet run --project src/HFLabs/Products/SwarmDev/SwarmDev.csproj -c Release -- run-benchmarks",
      "dotnet run --project src/HFLabs/Products/AutoMLApp/SwarmML.csproj -- optimize --iterations 500"
    ]
  },
  {
    title: "LevelZero.NET & L0 Kernel Catalog",
    slug: "levelzero-net",
    badge: "GPU Substrate",
    desc: "Auditing SPIR-V kernels, executing precompiled zebin binaries on Intel Iris Xe GT2 (tgllp) and Arc GPUs, and native ABI probes.",
    commands: [
      "pwsh -File src/HFLabs/Hardware/LevelZero.Toolchain/Audit-SpvKernels.ps1",
      "pwsh -File src/HFLabs/Hardware/LevelZero.Toolchain/Test-LevelZeroAbi.ps1",
      "dotnet test src/HFLabs/Hardware/KernelCatalog/KernelCatalog.Tests.csproj"
    ]
  },
  {
    title: "Accelerator, IPU SQL, Poplar.NET & ABIGen",
    slug: "accelerator-interop",
    badge: "Compute Acceleration",
    desc: "Hardware-accelerated database queries, Graphcore IPU hardware shims via Poplar.NET, task DAG acceleration, and automated ABIGen synthesizers.",
    commands: [
      "dotnet run --project src/HFLabs/Products/QueryAccel/QueryAccel.csproj -c Release -- --benchmark",
      "dotnet run --project src/HFLabs/Hardware/Poplar.NET/PoplarDriver.csproj -c Release",
      "dotnet run --project src/HFLabs/DevTools/ABIGen/ABIGen.csproj -- --generate-bindings"
    ]
  }
];
---

<Layout title="Operator Manuals &amp; Technical Docs &bull; HFLabs" description="Comprehensive operator guides for GraphRAG In-Memory Server, HyperSwarm Director, and LevelZero.NET GPU acceleration.">
  <div class="container" style="padding:60px 24px;">
    <div style="margin-bottom:32px;">
      <a href="/" style="font-size:12px; font-family:var(--font-mono);">&larr; Back to HFLabs Overview</a>
    </div>

    <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:12px;">
      Operator Guides &amp; Technical Manuals
    </div>
    <h1 style="font-size:36px; font-weight:800; margin-bottom:16px;">Operator Manuals &amp; System Docs</h1>
    <p style="font-size:16px; color:var(--text-secondary); max-width:720px; margin-bottom:48px;">
      Production guides and terminal commands to build, test, and run HFLabs products across bare-metal hardware and cloud environments.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(400px, 1fr)); gap:24px;">
      {guides.map(g => (
        <div id={g.slug} style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-lg); padding:28px; display:flex; flex-direction:column; gap:16px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size:18px; font-weight:700; color:var(--text-primary);">{g.title}</h3>
            <span class="badge" style="background:rgba(56,189,248,0.1); color:var(--accent-blue); font-size:10px;">{g.badge}</span>
          </div>
          <p style="font-size:13px; color:var(--text-secondary); line-height:1.5;">{g.desc}</p>
          <div style="margin-top:auto;">
            <h4 style="font-size:11px; text-transform:uppercase; color:var(--text-muted); font-family:var(--font-mono); margin-bottom:8px;">Invocation Commands</h4>
            <div style="display:flex; flex-direction:column; gap:6px; margin-bottom:12px;">
              {g.commands.map(cmd => (
                <pre style="background:#060911; border:1px solid rgba(255,255,255,0.06); border-radius:4px; padding:8px 10px; font-size:11px; color:#a5b4fc; overflow-x:auto;"><code>{cmd}</code></pre>
              ))}
            </div>
            {g.slug === "graphrag-operator" && (
              <div>
                <a href="/products/ht-graphrag" class="btn-primary" style="font-size:11px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
                  HT GraphRAG Product Page &rarr;
                </a>
              </div>
            )}
            {g.slug === "swarm-benchmark" && (
              <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a href="/products/hyperswarm" class="btn-primary" style="font-size:11px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
                  HyperSwarm Product Page &rarr;
                </a>
                <a href="/products/swarmdev" class="btn-secondary" style="font-size:11px; padding:4px 10px; display:inline-flex; align-items:center; gap:4px;">
                  SwarmDev Product Page &rarr;
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
