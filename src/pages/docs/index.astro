---
// docs/index.astro
import Layout from '../../layouts/Layout.astro';

const guides = [
  {
    title: "GraphRAG Operator Manual",
    slug: "graphrag-operator",
    badge: "Runtime",
    desc: "How to deploy, configure, and operate the In-Memory GraphRAG server, Headless CLI daemon, and FastMCP agent bridge.",
    commands: [
      "dotnet run --project src/HFLabs/Products/GraphRAG/Server/HFLabs.GraphRAG.Server.csproj -c Release",
      "dotnet run --project src/HFLabs/Products/GraphRAG/App/HFLabs.GraphRAG.App.csproj -c Release -- --headless --query \"Director\"",
      "python -m mcp_graphrag.server --transport sse --port 8000"
    ]
  },
  {
    title: "HyperSwarm Benchmark Runner & Sweeps",
    slug: "swarm-benchmark",
    badge: "Optimization",
    desc: "Executing 270-case matrix sweeps, threshold tuning, and Director authority validation harnesses.",
    commands: [
      "dotnet run --project src/HFLabs/Products/SwarmAlgorithms/BenchmarkRunner/BenchmarkRunner.csproj -c Release -- matrix-sweep",
      "dotnet run --project BenchmarkRunner.csproj -- hypercache-export --mode 2"
    ]
  },
  {
    title: "Intel Level Zero Acceleration Substrate",
    slug: "levelzero-net",
    badge: "Hardware",
    desc: "Auditing SPIR-V kernels, compiling zebin binaries for Iris Xe GT2 (tgllp), and ABI probe patterns.",
    commands: [
      "pwsh -File src/HFLabs/Hardware/LevelZero.Toolchain/Audit-SpvKernels.ps1",
      "pwsh -File src/HFLabs/Hardware/LevelZero.Toolchain/Test-LevelZeroAbi.ps1"
    ]
  },
  {
    title: "Deterministic Restructuring & Migration",
    slug: "restructuring-engine",
    badge: "Governance",
    desc: "5-layer graph stack for clean monorepo migration, universal IPUServices scrubbing, and dry-run validation.",
    commands: [
      "pwsh -File Scripts/Apply-MonorepoRestructuring.ps1 -WhatIf",
      "pwsh -File Scripts/Rollback-MonorepoRestructuring.ps1 -WhatIf"
    ]
  }
];
---

<Layout title="Operator Manuals &amp; Technical Docs &bull; HFLabs" description="Comprehensive operator guides for GraphRAG In-Memory Server, HyperSwarm Director, and LevelZero.NET GPU acceleration.">
  <div class="container" style="padding:60px 24px;">
    <div style="margin-bottom:32px;">
      <a href="/" style="font-size:12px; font-family:var(--font-mono);">&larr; Back to HFLabs Overview</a>
    </div>

    <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:12px;">
      Operator Guides &amp; Technical Manuals
    </div>
    <h1 style="font-size:36px; font-weight:800; margin-bottom:16px;">Operator Manuals &amp; System Docs</h1>
    <p style="font-size:16px; color:var(--text-secondary); max-width:720px; margin-bottom:48px;">
      Production guides and terminal commands to build, test, and run HFLabs products across bare-metal hardware and cloud environments.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(400px, 1fr)); gap:24px;">
      {guides.map(g => (
        <div style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:var(--radius-lg); padding:28px; display:flex; flex-direction:column; gap:16px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size:18px; font-weight:700; color:var(--text-primary);">{g.title}</h3>
            <span class="badge" style="background:rgba(56,189,248,0.1); color:var(--accent-blue); font-size:10px;">{g.badge}</span>
          </div>
          <p style="font-size:13px; color:var(--text-secondary); line-height:1.5;">{g.desc}</p>
          <div style="margin-top:auto;">
            <h4 style="font-size:11px; text-transform:uppercase; color:var(--text-muted); font-family:var(--font-mono); margin-bottom:8px;">Invocation Commands</h4>
            <div style="display:flex; flex-direction:column; gap:6px;">
              {g.commands.map(cmd => (
                <pre style="background:#060911; border:1px solid rgba(255,255,255,0.06); border-radius:4px; padding:8px 10px; font-size:11px; color:#a5b4fc; overflow-x:auto;"><code>{cmd}</code></pre>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
