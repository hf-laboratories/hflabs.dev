---
// src/pages/schemas/index.astro
import Layout from '../../layouts/Layout.astro';
import { getAllSchemas } from '../../utils/schemaCatalog';

const allSchemas = getAllSchemas();

// Extract unique categories
const categories = Array.from(new Set(allSchemas.map(s => s.category))).sort();

// Group schemas by category
const schemasByCategory: Record<string, typeof allSchemas> = {};
categories.forEach(cat => {
  schemasByCategory[cat] = allSchemas.filter(s => s.category === cat);
});

// Category icons
const categoryIcons: Record<string, string> = {
  "Hardware & IPU Architecture": "⚡",
  "Accelerator & Compute Plans": "🚀",
  "Swarm & Optimization": "🌊",
  "Registry & Storage APIs": "🗄️",
  "Security & Execution Defense": "🛡️",
  "Orchestration & DevOps": "🛠️",
  "Streaming Telemetry (JSONL)": "📊",
  "XML & Data Contracts": "📄",
  "Protobuf & gRPC": "🔌",
  "General & Utility": "📁"
};

// Default initial schema
const initialSchema = allSchemas.find(s => s.filename.includes('accelerator_plan_input')) || allSchemas[0];
---

<Layout 
  title="Schema Portal & Wire Contract Registry • HF Labs"
  description="Explore, inspect, and validate formal schemas in JSON Schema, JSONL streams, XML/XSD, and Protobuf gRPC powering HF Labs engines."
>
  <div class="schema-portal-app">
    <!-- Top Bar -->
    <div class="portal-top-bar">
      <div class="container">
        <div class="top-bar-inner">
          <nav class="breadcrumb">
            <a href="/">Home</a>
            <span class="sep">/</span>
            <span class="curr">Schema &amp; Wire Contract Registry</span>
          </nav>
          <div class="stats-pills">
            <span class="stat-pill"><strong id="total-schemas-count">{allSchemas.length}</strong> Schemas</span>
            <span class="stat-pill">4 Wire Formats</span>
            <span class="stat-pill highlight">Zero Cloud Dependencies</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation Toggle -->
    <div class="mobile-nav-bar">
      <button id="mobile-schema-toggle" class="mobile-toggle-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Schema Catalog</span>
      </button>
      <span id="mobile-active-title" class="mobile-title-text">{initialSchema.title}</span>
    </div>

    <!-- Main Workspace Container -->
    <div class="container portal-workspace">
      <!-- Left Sidebar Explorer -->
      <aside id="schema-sidebar" class="schema-sidebar">
        <div class="sidebar-header">
          <div class="sidebar-title-row">
            <span class="sidebar-title">Contract Registry</span>
            <span class="schema-counter-badge">{allSchemas.length} items</span>
          </div>

          <!-- Search Box -->
          <div class="search-wrapper">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              id="schema-search-input" 
              placeholder="Search schemas, fields, formats..." 
              autocomplete="off"
            />
          </div>

          <!-- Format Filter Tabs -->
          <div class="format-filter-bar">
            <button class="filter-chip active" data-format="all">All</button>
            <button class="filter-chip" data-format="JSON Schema">JSON</button>
            <button class="filter-chip" data-format="JSONL">JSONL</button>
            <button class="filter-chip" data-format="XML">XML</button>
            <button class="filter-chip" data-format="Protobuf">Proto</button>
          </div>
        </div>

        <!-- Scrollable Schema Tree -->
        <div class="sidebar-scroll" id="sidebar-schema-list">
          {categories.map(cat => (
            <div class="category-block" data-category={cat}>
              <div class="category-header">
                <span class="cat-icon">{categoryIcons[cat] || "📁"}</span>
                <span class="cat-name">{cat}</span>
                <span class="cat-count">{schemasByCategory[cat].length}</span>
              </div>
              <ul class="schema-items-list">
                {schemasByCategory[cat].map(s => {
                  const isActive = s.id === initialSchema.id;
                  let formatColorClass = 'badge-json';
                  if (s.format === 'JSONL') formatColorClass = 'badge-jsonl';
                  else if (s.format === 'XML') formatColorClass = 'badge-xml';
                  else if (s.format === 'Protobuf') formatColorClass = 'badge-proto';

                  return (
                    <li 
                      class={`schema-item-entry ${isActive ? 'active' : ''}`}
                      data-id={s.id}
                      data-filename={s.filename.toLowerCase()}
                      data-title={s.title.toLowerCase()}
                      data-desc={s.description.toLowerCase()}
                      data-format={s.format}
                      data-fields={s.fields.map(f => f.name.toLowerCase()).join(' ')}
                    >
                      <button class="schema-select-btn" data-target-id={s.id}>
                        <div class="item-main-row">
                          <span class="item-title">{s.title}</span>
                          <span class={`format-pill ${formatColorClass}`}>{s.format}</span>
                        </div>
                        <span class="item-filename">{s.filename}</span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          <div id="no-schema-results" class="no-results-msg hidden">
            No matching schemas found.
          </div>
        </div>

        <div class="sidebar-footer">
          <a href="https://github.com/hf-laboratories" target="_blank" rel="noopener noreferrer" class="repo-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>hf-laboratories / public / schemas</span>
          </a>
        </div>
      </aside>

      <!-- Center Schema Reader Area -->
      <main class="schema-reader-main">
        <!-- Active Schema Header Card -->
        <div class="reader-header-card">
          <div class="header-tag-row">
            <span id="active-format-badge" class="badge badge-cyan">{initialSchema.formatBadge}</span>
            <span id="active-category-badge" class="badge badge-purple">{initialSchema.category}</span>
            <span id="active-version-badge" class="badge badge-emerald">v{initialSchema.version}</span>
            <span class="badge badge-amber">LOCAL FIRST</span>
          </div>

          <div class="header-main-row">
            <div>
              <h1 id="active-schema-title" class="schema-main-heading">{initialSchema.title}</h1>
              <span id="active-schema-filename" class="schema-code-path">/schemas/{initialSchema.filename}</span>
            </div>

            <div class="header-actions">
              <a id="active-download-btn" href={initialSchema.downloadUrl} download class="btn-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span>Download Raw</span>
              </a>
              <button id="active-copy-btn" class="btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span>Copy</span>
              </button>
            </div>
          </div>

          <p id="active-schema-description" class="schema-lead-desc">{initialSchema.description}</p>
        </div>

        <!-- Navigation Tabs -->
        <div class="reader-tabs-nav">
          <button class="reader-tab active" data-tab="properties">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
            <span>Property Explorer</span>
            <span id="tab-property-count" class="tab-badge">{initialSchema.propertyCount}</span>
          </button>

          <button class="reader-tab" data-tab="code">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
            <span>Raw Definition</span>
          </button>

          <button class="reader-tab" data-tab="sample">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            </svg>
            <span>Wire Payload Sample</span>
          </button>

          <button class="reader-tab" data-tab="validator">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span>Interactive Sandbox</span>
          </button>
        </div>

        <!-- Tab 1: Property Explorer -->
        <div id="tab-content-properties" class="tab-pane active">
          <div class="pane-card">
            <div class="pane-header-row">
              <h3 class="pane-title">Fields &amp; Constraint Rules</h3>
              <span class="pane-subtitle">Parsed schema parameters and validation attributes</span>
            </div>

            <div class="table-responsive">
              <table class="properties-table">
                <thead>
                  <tr>
                    <th>Field Name</th>
                    <th>Type</th>
                    <th>Required</th>
                    <th>Constraints &amp; Rules</th>
                    <th>Description</th>
                  </tr>
                </thead>
                <tbody id="properties-table-body">
                  {initialSchema.fields.map(f => (
                    <tr>
                      <td class="prop-name"><code>{f.name}</code></td>
                      <td class="prop-type"><span class="type-pill">{f.type}</span></td>
                      <td class="prop-req">{f.required ? <span class="req-yes">Required</span> : <span class="req-opt">Optional</span>}</td>
                      <td class="prop-constraints">{f.constraints ? <code>{f.constraints}</code> : <span class="muted-dash">—</span>}</td>
                      <td class="prop-desc">{f.desc}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div id="empty-fields-msg" class={`empty-state ${initialSchema.fields.length === 0 ? '' : 'hidden'}`}>
                No direct property array defined for this contract format. Use the <strong>Raw Definition</strong> tab to view the complete specification.
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 2: Raw Code Viewer -->
        <div id="tab-content-code" class="tab-pane">
          <div class="pane-card">
            <div class="pane-header-row">
              <h3 class="pane-title">Raw Schema Content</h3>
              <button id="copy-code-btn" class="copy-sub-btn">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span>Copy Code</span>
              </button>
            </div>
            <pre class="raw-code-block"><code id="raw-code-display">{initialSchema.rawContent}</code></pre>
          </div>
        </div>

        <!-- Tab 3: Sample Wire Payload -->
        <div id="tab-content-sample" class="tab-pane">
          <div class="pane-card">
            <div class="pane-header-row">
              <h3 class="pane-title">Generated Wire Payload</h3>
              <span class="pane-subtitle">Example payload structure for client integrations</span>
            </div>
            <pre class="raw-code-block"><code id="sample-payload-display">{typeof initialSchema.samplePayload === 'string' ? initialSchema.samplePayload : JSON.stringify(initialSchema.samplePayload, null, 2)}</code></pre>
          </div>
        </div>

        <!-- Tab 4: Interactive Validator Sandbox -->
        <div id="tab-content-validator" class="tab-pane">
          <div class="pane-card">
            <div class="pane-header-row">
              <h3 class="pane-title">Client-Side Validation Sandbox</h3>
              <span class="pane-subtitle">Paste or edit JSON/JSONL to test against contract rules</span>
            </div>

            <div class="validator-grid">
              <div class="validator-input-box">
                <div class="editor-header">
                  <span>Input JSON Payload</span>
                  <button id="reset-sandbox-btn" class="btn-text">Reset to Sample</button>
                </div>
                <textarea id="sandbox-input" class="sandbox-textarea" spellcheck="false">{JSON.stringify(initialSchema.samplePayload, null, 2)}</textarea>
              </div>

              <div class="validator-output-box">
                <div class="editor-header">
                  <span>Validation Result</span>
                  <button id="run-validation-btn" class="btn-validate">Run Test</button>
                </div>
                <div id="sandbox-result" class="sandbox-result valid">
                  <div class="result-status-row">
                    <span class="result-icon">✓</span>
                    <strong class="result-title">Valid Payload Syntax</strong>
                  </div>
                  <p class="result-detail">JSON syntax verified. All required fields match schema constraints.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<!-- Client-Side Schema Catalog Data Payload -->
<script define:vars={{ allSchemas }}>
  window.__HF_SCHEMAS_CATALOG__ = allSchemas;
</script>

<script>
  interface SchemaField {
    name: string;
    type: string;
    required: boolean;
    desc: string;
    constraints?: string;
  }

  interface SchemaItem {
    id: string;
    filename: string;
    title: string;
    description: string;
    category: string;
    format: string;
    formatBadge: string;
    version: string;
    downloadUrl: string;
    rawContent: string;
    fields: SchemaField[];
    samplePayload: any;
    propertyCount: number;
  }

  const catalog: SchemaItem[] = (window as any).__HF_SCHEMAS_CATALOG__ || [];

  let activeSchema: SchemaItem = catalog[0];

  // DOM Elements
  const searchInput = document.getElementById('schema-search-input') as HTMLInputElement;
  const filterChips = document.querySelectorAll('.filter-chip');
  const schemaEntries = document.querySelectorAll('.schema-item-entry');
  const categoryBlocks = document.querySelectorAll('.category-block');
  const noResultsMsg = document.getElementById('no-schema-results');

  // Reader elements
  const elTitle = document.getElementById('active-schema-title');
  const elFilename = document.getElementById('active-schema-filename');
  const elDesc = document.getElementById('active-schema-description');
  const elFormatBadge = document.getElementById('active-format-badge');
  const elCategoryBadge = document.getElementById('active-category-badge');
  const elVersionBadge = document.getElementById('active-version-badge');
  const elDownloadBtn = document.getElementById('active-download-btn') as HTMLAnchorElement;
  const elRawCode = document.getElementById('raw-code-display');
  const elSampleCode = document.getElementById('sample-payload-display');
  const elTableBody = document.getElementById('properties-table-body');
  const elEmptyFields = document.getElementById('empty-fields-msg');
  const elPropertyCount = document.getElementById('tab-property-count');
  const elMobileTitle = document.getElementById('mobile-active-title');

  // Sandbox elements
  const sandboxInput = document.getElementById('sandbox-input') as HTMLTextAreaElement;
  const sandboxResult = document.getElementById('sandbox-result');
  const runValidationBtn = document.getElementById('run-validation-btn');
  const resetSandboxBtn = document.getElementById('reset-sandbox-btn');

  // Tab switching
  const tabButtons = document.querySelectorAll('.reader-tab');
  const tabPanes = document.querySelectorAll('.tab-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      tabButtons.forEach(b => b.classList.remove('active'));
      tabPanes.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      const targetPane = document.getElementById(`tab-content-${tabId}`);
      if (targetPane) targetPane.classList.add('active');
    });
  });

  // Switch Active Schema Function
  function selectSchema(id: string) {
    const item = catalog.find(s => s.id === id);
    if (!item) return;
    activeSchema = item;

    // Update active highlight in sidebar
    schemaEntries.forEach(entry => {
      if (entry.getAttribute('data-id') === id) {
        entry.classList.add('active');
      } else {
        entry.classList.remove('active');
      }
    });

    // Update reader views
    if (elTitle) elTitle.textContent = item.title;
    if (elFilename) elFilename.textContent = `/schemas/${item.filename}`;
    if (elDesc) elDesc.textContent = item.description;
    if (elFormatBadge) elFormatBadge.textContent = item.formatBadge;
    if (elCategoryBadge) elCategoryBadge.textContent = item.category;
    if (elVersionBadge) elVersionBadge.textContent = `v${item.version}`;
    if (elDownloadBtn) {
      elDownloadBtn.href = item.downloadUrl;
      elDownloadBtn.setAttribute('download', item.filename);
    }
    if (elRawCode) elRawCode.textContent = item.rawContent;
    if (elSampleCode) {
      elSampleCode.textContent = typeof item.samplePayload === 'string' 
        ? item.samplePayload 
        : JSON.stringify(item.samplePayload, null, 2);
    }
    if (elPropertyCount) elPropertyCount.textContent = String(item.propertyCount);
    if (elMobileTitle) elMobileTitle.textContent = item.title;

    // Render properties table
    if (elTableBody) {
      elTableBody.innerHTML = '';
      if (item.fields.length > 0) {
        if (elEmptyFields) elEmptyFields.classList.add('hidden');
        item.fields.forEach(f => {
          const row = document.createElement('tr');
          row.innerHTML = `
            <td class="prop-name"><code>${f.name}</code></td>
            <td class="prop-type"><span class="type-pill">${f.type}</span></td>
            <td class="prop-req">${f.required ? '<span class="req-yes">Required</span>' : '<span class="req-opt">Optional</span>'}</td>
            <td class="prop-constraints">${f.constraints ? `<code>${f.constraints}</code>` : '<span class="muted-dash">—</span>'}</td>
            <td class="prop-desc">${f.desc}</td>
          `;
          elTableBody.appendChild(row);
        });
      } else {
        if (elEmptyFields) elEmptyFields.classList.remove('hidden');
      }
    }

    // Update sandbox input
    if (sandboxInput) {
      sandboxInput.value = typeof item.samplePayload === 'string'
        ? item.samplePayload
        : JSON.stringify(item.samplePayload, null, 2);
    }
    validateSandbox();

    // Close mobile drawer if open
    const sidebar = document.getElementById('schema-sidebar');
    if (sidebar && sidebar.classList.contains('open')) {
      sidebar.classList.remove('open');
    }

    // Update URL hash for deeplinking
    window.location.hash = item.id;
  }

  // Bind click handlers to schema buttons
  document.querySelectorAll('.schema-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target-id');
      if (targetId) selectSchema(targetId);
    });
  });

  // Filter & Search Logic
  let currentFormatFilter = 'all';

  function applyFilters() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    let totalVisible = 0;

    categoryBlocks.forEach(block => {
      let blockVisibleCount = 0;
      const entries = block.querySelectorAll('.schema-item-entry');

      entries.forEach(entry => {
        const title = entry.getAttribute('data-title') || '';
        const filename = entry.getAttribute('data-filename') || '';
        const desc = entry.getAttribute('data-desc') || '';
        const format = entry.getAttribute('data-format') || '';
        const fields = entry.getAttribute('data-fields') || '';

        const matchesQuery = query === '' || 
          title.includes(query) || 
          filename.includes(query) || 
          desc.includes(query) || 
          fields.includes(query);

        const matchesFormat = currentFormatFilter === 'all' || format === currentFormatFilter;

        if (matchesQuery && matchesFormat) {
          (entry as HTMLElement).style.display = 'block';
          blockVisibleCount++;
          totalVisible++;
        } else {
          (entry as HTMLElement).style.display = 'none';
        }
      });

      if (blockVisibleCount === 0) {
        (block as HTMLElement).style.display = 'none';
      } else {
        (block as HTMLElement).style.display = 'block';
      }
    });

    if (noResultsMsg) {
      if (totalVisible === 0) noResultsMsg.classList.remove('hidden');
      else noResultsMsg.classList.add('hidden');
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', applyFilters);
  }

  filterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      filterChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      currentFormatFilter = chip.getAttribute('data-format') || 'all';
      applyFilters();
    });
  });

  // Sandbox Validator
  function validateSandbox() {
    if (!sandboxInput || !sandboxResult) return;
    const text = sandboxInput.value.trim();

    if (!text) {
      sandboxResult.className = 'sandbox-result invalid';
      sandboxResult.innerHTML = `
        <div class="result-status-row">
          <span class="result-icon" style="color:#ef4444;">✕</span>
          <strong class="result-title">Empty Input</strong>
        </div>
        <p class="result-detail">Please provide JSON or contract data to validate.</p>
      `;
      return;
    }

    if (activeSchema.format === 'JSON Schema' || activeSchema.format === 'JSON') {
      try {
        const parsed = JSON.parse(text);
        // Check required fields if available
        const missingReq: string[] = [];
        activeSchema.fields.forEach(f => {
          if (f.required && (parsed[f.name] === undefined || parsed[f.name] === null)) {
            missingReq.push(f.name);
          }
        });

        if (missingReq.length > 0) {
          sandboxResult.className = 'sandbox-result warning';
          sandboxResult.innerHTML = `
            <div class="result-status-row">
              <span class="result-icon" style="color:#f59e0b;">⚠</span>
              <strong class="result-title">Valid JSON &bull; Missing Required Fields</strong>
            </div>
            <p class="result-detail">Missing fields: <code>${missingReq.join(', ')}</code></p>
          `;
        } else {
          sandboxResult.className = 'sandbox-result valid';
          sandboxResult.innerHTML = `
            <div class="result-status-row">
              <span class="result-icon" style="color:#10b981;">✓</span>
              <strong class="result-title">Valid Payload Syntax &amp; Schema Match</strong>
            </div>
            <p class="result-detail">Payload successfully passed JSON syntax and required field checks.</p>
          `;
        }
      } catch (err: any) {
        sandboxResult.className = 'sandbox-result invalid';
        sandboxResult.innerHTML = `
          <div class="result-status-row">
            <span class="result-icon" style="color:#ef4444;">✕</span>
            <strong class="result-title">JSON Parse Error</strong>
          </div>
          <p class="result-detail">${err.message}</p>
        `;
      }
    } else if (activeSchema.format === 'JSONL') {
      const lines = text.split('\n').filter(l => l.trim().length > 0);
      let parseErrors = 0;
      lines.forEach((line, idx) => {
        try {
          JSON.parse(line);
        } catch (e) {
          parseErrors++;
        }
      });

      if (parseErrors > 0) {
        sandboxResult.className = 'sandbox-result invalid';
        sandboxResult.innerHTML = `
          <div class="result-status-row">
            <span class="result-icon" style="color:#ef4444;">✕</span>
            <strong class="result-title">Invalid JSONL Stream</strong>
          </div>
          <p class="result-detail">${parseErrors} line(s) failed JSON parsing.</p>
        `;
      } else {
        sandboxResult.className = 'sandbox-result valid';
        sandboxResult.innerHTML = `
          <div class="result-status-row">
            <span class="result-icon" style="color:#10b981;">✓</span>
            <strong class="result-title">Valid JSONL Stream (${lines.length} lines)</strong>
          </div>
          <p class="result-detail">All line-delimited records successfully verified as valid JSON objects.</p>
        `;
      }
    } else {
      sandboxResult.className = 'sandbox-result valid';
      sandboxResult.innerHTML = `
        <div class="result-status-row">
          <span class="result-icon" style="color:#10b981;">✓</span>
          <strong class="result-title">Contract Loaded</strong>
        </div>
        <p class="result-detail">${activeSchema.format} contract loaded in workspace.</p>
      `;
    }
  }

  if (runValidationBtn) runValidationBtn.addEventListener('click', validateSandbox);
  if (resetSandboxBtn) {
    resetSandboxBtn.addEventListener('click', () => {
      if (sandboxInput) {
        sandboxInput.value = typeof activeSchema.samplePayload === 'string'
          ? activeSchema.samplePayload
          : JSON.stringify(activeSchema.samplePayload, null, 2);
      }
      validateSandbox();
    });
  }

  // Copy Buttons
  const copyBtn = document.getElementById('active-copy-btn');
  const copyCodeBtn = document.getElementById('copy-code-btn');

  function copyText(text: string, button: HTMLElement | null) {
    if (!button) return;
    navigator.clipboard.writeText(text).then(() => {
      const originalHtml = button.innerHTML;
      button.innerHTML = `<span>Copied!</span>`;
      setTimeout(() => {
        button.innerHTML = originalHtml;
      }, 2000);
    });
  }

  if (copyBtn) copyBtn.addEventListener('click', () => copyText(activeSchema.rawContent, copyBtn));
  if (copyCodeBtn) copyCodeBtn.addEventListener('click', () => copyText(activeSchema.rawContent, copyCodeBtn));

  // Mobile drawer toggle
  const mobileToggle = document.getElementById('mobile-schema-toggle');
  const sidebar = document.getElementById('schema-sidebar');
  if (mobileToggle && sidebar) {
    mobileToggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
    });
  }

  // Check URL Hash for deeplink
  if (window.location.hash) {
    const targetHash = window.location.hash.substring(1);
    const matched = catalog.find(s => s.id === targetHash || s.filename.includes(targetHash));
    if (matched) {
      selectSchema(matched.id);
    }
  }
</script>

