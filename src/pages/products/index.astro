---
// src/pages/products/index.astro
import Layout from '../../layouts/Layout.astro';

const products = [
  {
    id: "ht-graphrag",
    name: "Hypertensor GraphRAG",
    badge: "Vector & Graph Engine",
    badgeColor: "#38bdf8",
    tagline: "In-memory typed property-graph store with hybrid dense and BM25 retrieval, SIMD TensorPrimitives, and FastMCP agent context.",
    status: "Production Ready",
    href: "/products/ht-graphrag",
    buttonText: "View Product & Licensing Tiers →",
    features: [
      "In-memory typed property-graph store with dense & BM25 retrieval",
      "SIMD TensorPrimitives with optional Level Zero GPU offload",
      "65+ tool FastMCP server & desktop HUD for agent context",
      "Tiered Open-Core and Commercial licensing"
    ]
  },
  {
    id: "swarmdev",
    name: "SwarmDev",
    badge: "Deterministic Pipeline",
    badgeColor: "#f59e0b",
    tagline: "A deterministic pipeline that turns a natural-language request into an inspectable plan with a diagnostic trail at every step.",
    status: "Production Library",
    href: "/products/swarmdev",
    buttonText: "Explore SwarmDev Product Page →",
    features: [
      "6 explicit stages: Classify, Analyze, Graph, Route, Normalize, Emit",
      "Deterministic core with full regression testability",
      "Optional kGNN graph reasoning & HyperSwarm wavescan bridge",
      "Structured telemetry sidecar and hard policy interception gates"
    ]
  },
  {
    id: "ml-suite",
    name: "HFLabs Machine Learning Suite",
    badge: "Local ML & Agentic AI",
    badgeColor: "#10b981",
    tagline: "Optimization, inference and agent reasoning in one .NET library set, with no cloud service in the loop.",
    status: "Production Libraries",
    href: "/products/ml-suite",
    buttonText: "Explore ML Suite Product Page →",
    features: [
      "5 HPO engines (Bayesian, Hyperband, BOHB, ASHA-BOHB, TuRBO) with JSON checkpointing",
      "6 KGE models (TransE, RotatE, ComplEx, DistMult, ZPinch, Dual-Conj) & ontology extractors",
      "From-scratch Level Zero LLM runtime with graph-constrained tri-beam hallucination defense",
      "22 ML.Agentic dependency-free primitives & 5 ML.Reasoning graph algorithms"
    ]
  },
  {
    id: "automlapp",
    name: "AutoMLApp (in development)",
    badge: "Node-Graph Editor",
    badgeColor: "#06b6d4",
    tagline: "Design ML pipelines on a canvas. Run them on your hardware with 185+ node types across 25+ domains.",
    status: "In Development",
    href: "/products/automlapp",
    buttonText: "Explore AutoMLApp Product Page →",
    features: [
      "185+ node types across 25+ domains (Data, ONNX, IPU, SNN, Swarm, FPGA)",
      "Topologically sorted plan compilation with domain-specific step handlers",
      "F7 instant invariant validation (cycles, orphans, duplicate IDs, types)",
      "Pluggable HyperSwarm-backed AutoML & telemetry-aware cost scoring"
    ]
  },
  {
    id: "abigen",
    name: "Abigen (in development)",
    badge: "C/C++ Binding Engine",
    badgeColor: "#f43f5e",
    tagline: "Point it at a C/C++ header, get reviewed, verified C# bindings — and keep them in sync as the native library moves.",
    status: "In Development",
    href: "/products/abigen",
    buttonText: "Explore Abigen Product Page →",
    features: [
      "Narrow, fail-closed generator: binds top-level C functions, scalar fields & opaque handles",
      "Full manifest tracking with resolved libclang SHA-256 fingerprint & Clang args",
      "Release tracking for GitHub repos & build feeds with API word count diffs",
      "Desktop dashboard with 5-stage verification (smoke test, deterministic rerun, schema)"
    ]
  },
  {
    id: "hyperswarm",
    name: "HyperSwarm Optimization Suite",
    badge: "Swarm Metaheuristics",
    badgeColor: "#818cf8",
    tagline: "Swarm optimization, from a single algorithm to a coordinated fleet. 35 optimizer modes with Intel Level Zero GPU kernels.",
    status: "Active Development",
    href: "/products/hyperswarm",
    buttonText: "Explore HyperSwarm Product Page →",
    features: [
      "35 optimizers: 12 core swarm models, 14 hybrids, 9 advanced & multi-objective",
      "Director ensembles with dynamic budget & authority assignment",
      "10 GPU offload classes with compiled Level Zero SPIR-V / Zebin kernels",
      "123+ registered features & ~2,500 tests across 191 test suites"
    ]
  },
  {
    id: "levelzero-net",
    name: "LevelZero.NET & Kernel Catalog",
    badge: "GPU Substrate",
    badgeColor: "#f43f5e",
    tagline: "Intel GPU compute from .NET, one DLL, no driver SDK to install.",
    status: "Production Ready",
    href: "/products/levelzero",
    buttonText: "Explore LevelZero.NET Product Page →",
    features: [
      "Single DLL: Managed API, native shim, and 407 pre-compiled kernel modules (37 × 11 targets)",
      "37 kernel wrappers across Swarm, SNN, LLM Inference & Knowledge Retrieval",
      "11 Intel GPU targets from 11th-gen Iris Xe to Battlemage & Panther Lake",
      "Zero boilerplate with ComputeDevice, SharedBuffer<T>, and auto device detection"
    ]
  },
  {
    id: "poplar-net",
    name: "Poplar.NET (in development)",
    badge: "IPU Substrate",
    badgeColor: "#fbbf24",
    tagline: "C ABI shim and managed .NET wrapper for Graphcore Poplar/PopART computational graph execution.",
    status: "In Development",
    href: "/products/poplar",
    buttonText: "Explore Poplar.NET Product Page →",
    features: [
      "Safe native handles (IPUDevice, PoplarGraph, EngineSession, StreamHandle)",
      "PopART & ONNX computational graph construction and multi-tile execution",
      "Asynchronous ring-pipe streaming over zero-copy pinned host memory",
      "Direct integration with QueryAccel, Accelerator Layer, and HFLabs ML Suite"
    ]
  },
  {
    id: "accelerator-stack",
    name: "Accelerator & Heterogeneous Engines",
    badge: "Compute Orchestration",
    badgeColor: "#34d399",
    tagline: "Unified hardware-accelerator layer, IPU SQL query acceleration, Poplar.NET IPU shims, and Abigen C/C++ binding generator.",
    status: "Production Ready",
    href: "/products/accelerator",
    buttonText: "Explore Accelerator Product Page →",
    features: [
      "gRPC plan execution across IPU, CUDA, OpenCL, Level Zero, FPGA, DMA/RDMA",
      "IPU SQL query acceleration for PostgreSQL & SQL Server CLR (aggregates & distance)",
      "Poplar.NET managed .NET wrapper for Graphcore Poplar/PopART",
      "Abigen libclang-driven C ABI shim and C# binding synthesizer"
    ]
  },
  {
    id: "queryaccel-ipu",
    name: "QueryAccel IPU Database Layer",
    badge: "Database Acceleration",
    badgeColor: "#38bdf8",
    tagline: "Push SQL's heaviest operations onto IPU hardware, transparently. Native PostgreSQL FDW and SQL Server CLR bridge.",
    status: "Production Ready",
    href: "/products/queryaccel",
    buttonText: "Explore QueryAccel Product Page →",
    features: [
      "PostgreSQL native C/C++ Foreign Data Wrapper with cost-based pushdown",
      "SQL Server CLR assembly executing IPU inference with single T-SQL EXEC",
      "Hardware offload for COUNT, SUM, AVG, MIN, MAX and dense vector metrics",
      "100% graceful degradation to CPU path when no IPU hardware is present"
    ]
  }
];
---

<Layout title="HFLabs Products • High-Assurance Systems & Runtimes" description="Explore HFLabs core product suite: In-Memory Hypertensor GraphRAG, HyperSwarm, LevelZero.NET, and Accelerator.">
  <div class="container" style="padding:60px 0 80px;">
    <div style="margin-bottom:32px;">
      <a href="/" style="font-size:12px; font-family:var(--font-mono); color:var(--text-muted);">&larr; Back to HFLabs Overview</a>
    </div>

    <div class="section-header" style="text-align:center; max-width:800px; margin:0 auto 48px;">
      <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:12px;">
        Core Systems &amp; Products
      </div>
      <h1 style="font-size:36px; font-weight:800; margin-bottom:16px;">HFLabs Product Portfolio</h1>
      <p style="font-size:15px; color:var(--text-secondary); line-height:1.6;">
        Specialized low-latency engines and high-assurance compute substrates designed for autonomous agents, metaheuristic optimization, and direct hardware execution.
      </p>
    </div>

    <div class="products-grid">
      {products.map(p => (
        <div class="product-card" style={`--prod-accent:${p.badgeColor};`}>
          <div class="card-top">
            <div class="badge-row">
              <span class="prod-badge">{p.badge}</span>
              <span class="status-badge">{p.status}</span>
            </div>
            <h2 class="prod-name">{p.name}</h2>
            <p class="prod-tagline">{p.tagline}</p>
          </div>

          <div class="prod-features">
            <h4>Key Capabilities</h4>
            <ul>
              {p.features.map(f => (
                <li>
                  <span class="check-mark">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-footer">
            <a href={p.href} class="btn-primary" style="width:100%; text-align:center; padding:10px 16px; font-size:13px;">
              {p.buttonText || 'View Documentation & Guides →'}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
  }

  .product-card {
    background: rgba(13, 19, 36, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 3px solid var(--prod-accent);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.15), 0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:hover {
    background: rgba(22, 33, 62, 0.65);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.25), 0 16px 40px 0 rgba(0, 0, 0, 0.45), 0 0 20px color-mix(in srgb, var(--prod-accent) 25%, transparent);
    transform: translateY(-2px);
  }

  .badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .prod-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--prod-accent);
    background: rgba(255, 255, 255, 0.05);
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 700;
  }

  .status-badge {
    font-size: 10px;
    color: var(--accent-emerald);
    background: rgba(52, 211, 153, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .prod-name {
    font-size: 20px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .prod-tagline {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .prod-features {
    background: rgba(8, 12, 24, 0.55);
    border-radius: var(--radius-sm);
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.06);
  }

  .prod-features h4 {
    font-size: 10px;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .prod-features ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prod-features li {
    font-size: 12px;
    color: var(--text-secondary);
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .check-mark {
    color: var(--prod-accent);
    font-weight: 700;
  }

  .card-footer {
    margin-top: auto;
  }
</style>
