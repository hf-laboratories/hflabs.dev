---
// src/pages/products/index.astro
import Layout from '../../layouts/Layout.astro';

const products = [
  {
    id: "levelzero-net",
    name: "LevelZero.NET",
    badge: "Flagship GPU Runtime",
    badgeColor: "#f43f5e",
    tagline: "Native Intel GPU acceleration and managed Level Zero runtime with pre-compiled SPIR-V kernels for .NET 10.",
    status: "Released v2.0.0",
    href: "/products/levelzero",
    buttonText: "Explore LevelZero.NET Product Page →",
    releaseHref: "https://github.com/hf-laboratories/LevelZero.NET/releases/tag/v2.0.0",
    releaseText: "Release Assets (v2.0.0)",
    features: [
      "Single DLL: Managed API, native C shim, and 418 pre-compiled kernel modules across 11 Intel GPU targets",
      "Unified Shared Memory (USM) zero-copy buffer allocations with typed Span<T>",
      "Precompiled modules for Iris Xe, Arc A-Series, Lunar Lake, Arrow Lake, Battlemage, and Ponte Vecchio",
      "Powers local LLM inference, swarm optimizers, and spiking neural network kernels"
    ]
  },
  {
    id: "l0llm",
    name: "l0llm",
    badge: "Flagship LLM Server",
    badgeColor: "#a855f7",
    tagline: "Pure C# & Intel Level Zero native LLM runner and OpenAI-compatible REST server. 41.3 tok/s on Iris Xe with zero GC allocations.",
    status: "Released v2.0.0",
    href: "/products/l0llm",
    buttonText: "Explore l0llm Showcase →",
    releaseHref: "https://github.com/hf-laboratories/l0llm/releases/tag/v2.0.0",
    releaseText: "Download (v2.0.0)",
    features: [
      "Zero Python, zero Conda, zero C++ framework dependencies — 100% managed C#",
      "Native support for LLaMA 3, Qwen 2.5, DeepSeek, Mistral, and Phi architectures",
      "Drop-in OpenAI REST API (/v1/chat/completions) with SSE streaming for Open-WebUI & LangChain",
      "Zero-allocation decode loop achieving 41.3 tokens/sec on mobile 15W Intel Iris Xe"
    ]
  },
  {
    id: "l0check",
    name: "l0check",
    badge: "Diagnostics CLI",
    badgeColor: "#059669",
    tagline: "Fast, standalone command-line diagnostic tool for inspecting Intel GPU architectures and validating compute kernels.",
    status: "Released v2.0.0",
    href: "/products/l0check",
    buttonText: "Explore l0check CLI →",
    releaseHref: "https://github.com/hf-laboratories/l0check/releases/tag/v2.0.0",
    releaseText: "Download (v2.0.0)",
    features: [
      "Query driver versions, API versions, device IDs, PCI bus, and execution unit configurations",
      "Analyze memory subsystems, sub-device slices, and cache topology hierarchy",
      "Comprehensive diagnostic smoke tests and compute kernel pipeline verification",
      "Self-contained single-file executable with zero installation dependencies"
    ]
  },
  {
    id: "ml-agentic",
    name: "ML.Agentic",
    badge: "Agentic AI Engine",
    badgeColor: "#38bdf8",
    tagline: "Zero-dependency, in-memory building blocks for enterprise multi-agent systems and protocols on .NET 10.",
    status: "Released v1.0.0",
    href: "/products/ml-agentic",
    buttonText: "Explore ML.Agentic Product Page →",
    releaseHref: "https://github.com/hf-laboratories/ML.Agentic/releases/tag/v1.0.0",
    releaseText: "Download NuGet (v1.0.0)",
    features: [
      "21 canonical agentic patterns (Blackboard, HumanInTheLoopGate, ResourceBudgetLedger, Guardrails)",
      "Native protocol engine for Model Context Protocol (MCP), Agent2Agent (A2A), and JSON-RPC 2.0",
      "Sub-millisecond execution with 0 external package references or heavy graph stores",
      "Deterministic seeded testing and optional Level Zero GPU kernel offload"
    ]
  },
  {
    id: "poplar-net",
    name: "Poplar.NET",
    badge: "IPU Runtime Engine",
    badgeColor: "#10b981",
    tagline: "Enterprise .NET 10 runtime engine & resident graph orchestration SDK for Graphcore Colossus IPUs.",
    status: "Released v1.0.0-preview",
    href: "/products/poplar",
    buttonText: "Explore Poplar.NET Product Page →",
    releaseHref: "https://github.com/hf-laboratories/Poplar.NET/releases/tag/v1.0.0-preview",
    releaseText: "Download Binaries (v1.0.0-preview)",
    features: [
      "Direct C# bindings and native C ABI shim for Graphcore Poplar & PopART SDK",
      "Pre-compiled on-chip resident graphs for LLM attention, swarm velocity, and covariance math",
      "Dynamic hardware telemetry, IPU fan governor, and zero-allocation FIFO streaming",
      "Paired with Poplar Explorer fork and IPU SQL Query Acceleration"
    ]
  },
  {
    id: "interactive-pnn",
    name: "Interactive PNN Decision Matrix",
    badge: "Interactive Visualization",
    badgeColor: "#f59e0b",
    tagline: "Interactive browser diagram of a probabilistic neural network decision matrix in HTML5/CSS/JavaScript.",
    status: "Live Web App",
    href: "https://hf-laboratories.github.io/Interactive-Probabilistic-Neural-Network-Decision-Matrix/",
    buttonText: "Launch Interactive App →",
    releaseHref: "https://github.com/hf-laboratories/Interactive-Probabilistic-Neural-Network-Decision-Matrix",
    releaseText: "GitHub Repo",
    features: [
      "Live interactive neural decision matrix visualization in pure JavaScript/HTML5",
      "Dynamic parameter exploration and probabilistic decision boundary simulation",
      "Zero-install browser app hosted on GitHub Pages",
      "Full source code available on GitHub"
    ]
  },
  {
    id: "ht-graphrag",
    name: "Hypertensor GraphRAG",
    badge: "Vector & Graph Engine",
    badgeColor: "#38bdf8",
    tagline: "In-memory typed property-graph store with hybrid dense and BM25 retrieval, SIMD TensorPrimitives, and FastMCP agent context.",
    status: "Coming soon",
    href: "/products/ht-graphrag",
    buttonText: "View Product & Licensing Tiers →",
    features: [
      "In-memory typed property-graph store with dense & BM25 retrieval",
      "SIMD TensorPrimitives with optional Level Zero GPU offload",
      "65+ tool FastMCP server & desktop HUD for agent context",
      "Tiered Open-Core and Commercial licensing"
    ]
  },
  {
    id: "swarmdev",
    name: "SwarmDev",
    badge: "Deterministic Pipeline",
    badgeColor: "#f59e0b",
    tagline: "A deterministic pipeline that turns a natural-language request into an inspectable plan with a diagnostic trail at every step.",
    status: "Production Library",
    href: "/products/swarmdev",
    buttonText: "Explore SwarmDev Product Page →",
    features: [
      "6 explicit stages: Classify, Analyze, Graph, Route, Normalize, Emit",
      "Deterministic core with full regression testability",
      "Optional kGNN graph reasoning & HyperSwarm wavescan bridge",
      "Structured telemetry sidecar and hard policy interception gates"
    ]
  },
  {
    id: "ml-suite",
    name: "HFLabs Machine Learning Suite",
    badge: "Local ML & Agentic AI",
    badgeColor: "#10b981",
    tagline: "Optimization, inference and agent reasoning in one .NET library set, with no cloud service in the loop.",
    status: "Production Libraries",
    href: "/products/ml-suite",
    buttonText: "Explore ML Suite Product Page →",
    features: [
      "5 HPO engines (Bayesian, Hyperband, BOHB, ASHA-BOHB, TuRBO) with JSON checkpointing",
      "6 KGE models (TransE, RotatE, ComplEx, DistMult, ZPinch, Dual-Conj) & ontology extractors",
      "Level Zero LLM runtime with graph-constrained beam decoding and flash attention",
      "21 ML.Agentic dependency-free primitives & cognitive orchestration loops"
    ]
  },
  {
    id: "hyperswarm",
    name: "HyperSwarm Optimization Suite",
    badge: "Swarm Metaheuristics",
    badgeColor: "#818cf8",
    tagline: "Swarm optimization, from a single algorithm to a coordinated fleet. 35 optimizer modes with Intel Level Zero GPU kernels.",
    status: "Active Development",
    href: "/products/hyperswarm",
    buttonText: "Explore HyperSwarm Product Page →",
    features: [
      "35 optimizers: 12 core swarm models, 14 hybrids, 9 advanced & multi-objective",
      "Director ensembles with dynamic budget & authority assignment",
      "10 GPU offload classes with compiled Level Zero SPIR-V / Zebin kernels",
      "123+ registered features & ~2,500 tests across 191 test suites"
    ]
  },
  {
    id: "swarmbench",
    name: "SwarmBench",
    badge: "Benchmarking & HUD",
    badgeColor: "#00e5ff",
    tagline: "Measure how swarms really behave, and watch them work. 34 optimization algorithms tested against 110 benchmark functions with real-time HUD visualizer.",
    status: "Production Tooling",
    href: "/products/swarmbench",
    buttonText: "Explore SwarmBench Product Page →",
    features: [
      "110 registered test functions across 9 problem families (unimodal to high-D)",
      "SwarmBenchmarkRunner CLI covering streams, diagnostics & elimination tournaments",
      "SwarmVisualizer.Host desktop HUD with 6-layer frame telemetry & 7 lifecycle stages",
      "HyperCache config reuse & self-validating SwarmCharacterization LaTeX/JSON profiles"
    ]
  },
  {
    id: "automlapp",
    name: "AutoMLApp (in development)",
    badge: "Node-Graph Editor",
    badgeColor: "#06b6d4",
    tagline: "Design ML pipelines on a canvas. Run them on your hardware with 185+ node types across 25+ domains.",
    status: "In Development",
    href: "/products/automlapp",
    buttonText: "Explore AutoMLApp Product Page →",
    features: [
      "185+ node types across 25+ domains (Data, ONNX, IPU, SNN, Swarm, FPGA)",
      "Topologically sorted plan compilation with domain-specific step handlers",
      "F7 instant invariant validation (cycles, orphans, duplicate IDs, types)",
      "Pluggable HyperSwarm-backed AutoML & telemetry-aware cost scoring"
    ]
  },
  {
    id: "abigen",
    name: "Abigen (in development)",
    badge: "C/C++ Binding Engine",
    badgeColor: "#f43f5e",
    tagline: "Point it at a C/C++ header, get reviewed, verified C# bindings — and keep them in sync as the native library moves.",
    status: "In Development",
    href: "/products/abigen",
    buttonText: "Explore Abigen Product Page →",
    features: [
      "Narrow, fail-closed generator: binds top-level C functions, scalar fields & opaque handles",
      "Full manifest tracking with resolved libclang SHA-256 fingerprint & Clang args",
      "Release tracking for GitHub repos & build feeds with API word count diffs",
      "Desktop dashboard with 5-stage verification (smoke test, deterministic rerun, schema)"
    ]
  },
  {
    id: "query-accel",
    name: "QueryAccel (MVP)",
    badge: "IPU SQL Engine",
    badgeColor: "#eab308",
    tagline: "Offload PostgreSQL & SQL Server analytical queries to Graphcore IPUs with gRPC bridge microservice.",
    status: "MVP",
    href: "/products/query-accel",
    buttonText: "Explore QueryAccel Product Page →",
    features: [
      "PostgreSQL extension & SQL Server CLR bridge offloading aggregates and vector ops",
      "Hardware-accelerated COUNT, SUM, AVG, MIN, MAX, Cosine, Dot, L2 distance",
      "Integrated gRPC microservice connecting database engine to Poplar runtime",
      "Evaluated on Graphcore Bow-2000 and Bow Pod clusters"
    ]
  }
];
---

<Layout title="HFLabs Products • High-Assurance Systems & Runtimes" description="Explore HFLabs core product suite: In-Memory Hypertensor GraphRAG, HyperSwarm, LevelZero.NET, Poplar.NET, ML.Agentic, and Accelerator.">
  <div class="container" style="padding:60px 0 80px;">
    <div style="margin-bottom:32px;">
      <a href="/" style="font-size:12px; font-family:var(--font-mono); color:var(--text-muted);">&larr; Back to HFLabs Overview</a>
    </div>

    <div class="section-header" style="text-align:center; max-width:800px; margin:0 auto 48px;">
      <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:12px;">
        Core Systems &amp; Products
      </div>
      <h1 style="font-size:36px; font-weight:800; margin-bottom:16px;">HFLabs Product Portfolio</h1>
      <p style="font-size:15px; color:var(--text-secondary); line-height:1.6;">
        Specialized low-latency engines and high-assurance compute substrates designed for autonomous agents, metaheuristic optimization, and direct hardware execution.
      </p>
    </div>

    <div class="products-grid">
      {products.map(p => (
        <div class="product-card" style={`--prod-accent:${p.badgeColor};`}>
          <div class="card-top">
            <div class="badge-row">
              <span class="prod-badge">{p.badge}</span>
              <span class="status-badge">{p.status}</span>
            </div>
            <h2 class="prod-name">{p.name}</h2>
            <p class="prod-tagline">{p.tagline}</p>
          </div>

          <div class="prod-features">
            <h4>Key Capabilities</h4>
            <ul>
              {p.features.map(f => (
                <li>
                  <span class="check-mark">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-footer" style="display:flex; flex-direction:column; gap:8px;">
            <a href={p.href} class="btn-primary" style="width:100%; text-align:center; padding:10px 16px; font-size:13px;">
              {p.buttonText || 'View Documentation & Guides →'}
            </a>
            {p.releaseHref && (
              <a 
                href={p.releaseHref} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-secondary" 
                data-released="true"
                style="width:100%; text-align:center; padding:8px 14px; font-size:12px; display:inline-flex; justify-content:center; align-items:center; gap:6px;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                <span>{p.releaseText || 'GitHub Releases'}</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
  }

  .product-card {
    background: rgba(13, 19, 36, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 3px solid var(--prod-accent);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.15), 0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:hover {
    background: rgba(22, 33, 62, 0.65);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.25), 0 16px 40px 0 rgba(0, 0, 0, 0.45), 0 0 20px color-mix(in srgb, var(--prod-accent) 25%, transparent);
    transform: translateY(-2px);
  }

  .badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .prod-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--prod-accent);
    background: rgba(255, 255, 255, 0.05);
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 700;
  }

  .status-badge {
    font-size: 10px;
    color: var(--accent-emerald);
    background: rgba(52, 211, 153, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .prod-name {
    font-size: 20px;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .prod-tagline {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .prod-features {
    background: rgba(8, 12, 24, 0.55);
    border-radius: var(--radius-sm);
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.06);
  }

  .prod-features h4 {
    font-size: 10px;
    text-transform: uppercase;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .prod-features ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .prod-features li {
    font-size: 12px;
    color: var(--text-secondary);
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .check-mark {
    color: var(--prod-accent);
    font-weight: 700;
  }

  .card-footer {
    margin-top: auto;
  }
</style>
