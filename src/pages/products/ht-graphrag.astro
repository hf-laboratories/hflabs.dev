---
// src/pages/products/ht-graphrag.astro
import Layout from '../../layouts/Layout.astro';
import LicenseTierCard from '../../components/LicenseTierCard.astro';

const metrics = [
  { label: "2-hop traversal", value: "0.15–1.95 ms", detail: "1k nodes up to 25k nodes / 100k edges, measured" },
  { label: "SIMD vectors", value: "128-d default", detail: "per-store dimension is configurable; .NET SIMD, AVX2/AVX-512" },
  { label: "residency", value: "In-Memory", detail: "RAM-resident graph with bidirectional adjacency indices and a BM25 index" },
  { label: "MCP connectivity", value: "FastMCP", detail: "stdio, SSE and Streamable HTTP; 65+ tools" },
  { label: "grounding", value: "TAPE + Grounding Verifier", detail: "action-perception planning plus claim-to-graph verification" }
];

const features = [
  {
    icon: "⚡",
    title: "Low-latency in-memory traversal",
    desc: "The graph store is RAM-resident. Measured 2-hop traversal is about 0.15 ms at ~1,000 nodes and 0.16 ms at ~10,000 nodes. It rises to about 1.95 ms at 25,000 nodes / 100,000 edges. A thread-safe worker pool serves concurrent queries."
  },
  {
    icon: "📐",
    title: "SIMD vector search",
    desc: "Dense cosine similarity runs on .NET TensorPrimitives with hardware SIMD. Vectors are 128-dimensional by default and configurable per store. It is combined with BM25 for hybrid retrieval. Level Zero GPU offload is available in the High-Assurance tier."
  },
  {
    icon: "🔌",
    title: "FastMCP protocol server",
    desc: "A Python FastMCP layer bridges MCP clients to the .NET server. It supports stdio, SSE and Streamable HTTP. Agents can query codebase topology, dependency graphs and symbol call-graphs."
  },
  {
    icon: "🛡️",
    title: "Offline signed licensing and MLS",
    desc: "Licenses are verified offline against an issuer public key (RSA), so air-gapped deployments work. High-Assurance adds Bell-LaPadula multi-level security (MLS) clearance enforcement and FIPS-approved HMAC-SHA256 clearance tokens."
  },
  {
    icon: "🧬",
    title: "Graph-grounded verification",
    desc: "The Grounding Verifier checks claims against graph memory, validates citations and flags hallucinated edges. TAPE (Task-Adaptive Prediction & Explanation) plans exploration and reasoning as action-perception DAGs."
  },
  {
    icon: "🔄",
    title: "Sharded, hardware-aware memory",
    desc: "The BESS partitioner shards graphs. A hardware-topology model covers NUMA nodes, fabric links and pinned host memory. The largest benchmarked configuration is 1,000,000 nodes / 5,000,000 edges."
  }
];
---

<Layout 
  title="Hypertensor GraphRAG & SIMD Vectors • In-Memory Graph & Vector Store" 
  description="An in-memory typed property-graph and vector store for autonomous developer agents. Keeps the graph in RAM and serves agents over REST and MCP.">
  
  <!-- Breadcrumb & Top Bar -->
  <div class="product-top-bar">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Overview</a>
        <span class="sep">/</span>
        <a href="/#divisions">Products</a>
        <span class="sep">/</span>
        <span class="curr">Hypertensor GraphRAG</span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="product-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3);">
          Vector &amp; Graph Engine
        </span>
        <span class="badge" style="background:rgba(52,211,153,0.15); color:var(--accent-emerald); border:1px solid rgba(52,211,153,0.3);">
          Production Ready
        </span>
        <span class="badge" style="background:rgba(251,191,36,0.15); color:var(--accent-amber); border:1px solid rgba(251,191,36,0.3);">
          Open-Core + Commercial
        </span>
      </div>

      <h1 class="hero-title">Hypertensor GraphRAG &amp; SIMD Vectors</h1>
      <p class="hero-desc">
        An in-memory typed property-graph and vector store for autonomous developer agents. It keeps the graph in RAM and serves agents over REST and MCP. That removes disk-bound lookups and external database round-trips.
      </p>

      <div class="hero-actions">
        <a href="#licensing" class="btn-primary" style="padding:12px 24px; font-size:14px;">
          View Licensing Tiers &darr;
        </a>
        <a href="#quickstart" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          Operator Quickstart &rarr;
        </a>
        <a href="/docs#graphrag-operator" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          Documentation
        </a>
      </div>

      <!-- Live Metrics Strip -->
      <div class="metrics-strip">
        {metrics.map(m => (
          <div class="metric-card">
            <span class="metric-val">{m.value}</span>
            <span class="metric-label">{m.label}</span>
            <span class="metric-detail">{m.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Architecture & Capabilities -->
  <section class="features-section">
    <div class="container">
      <div class="section-header" style="text-align:center; max-width:760px; margin:0 auto 48px;">
        <div class="badge" style="background:rgba(129,140,248,0.15); color:var(--accent-purple); border:1px solid rgba(129,140,248,0.3); margin-bottom:12px;">
          Core Substrates
        </div>
        <h2 style="font-size:28px; font-weight:800; margin-bottom:12px;">Engine Architecture &amp; Substrates</h2>
        <p style="color:var(--text-secondary); font-size:14px; line-height:1.6;">
          Built for low-latency agent workloads where a disk-bound or networked vector database adds too much per-query overhead.
        </p>
      </div>

      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card">
            <div class="feature-icon">{f.icon}</div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dedicated License Items Section -->
  <LicenseTierCard 
    badge="HT GraphRAG Commercial &amp; Open-Core Licensing"
    title="Licensing Tiers"
    subtitle="Choose the tier that fits your workload: free single-developer use, per-seat Pro, or team-level High-Assurance."
  />

  <!-- Procurement & Inquiry Section -->
  <section class="inquiry-section">
    <div class="container">
      <div class="inquiry-card">
        <div class="inquiry-content">
          <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:12px;">
            Licensing Procurement
          </div>
          <h2 style="font-size:24px; font-weight:800; margin-bottom:12px;">Ready to Deploy Hypertensor GraphRAG?</h2>
          <p style="color:var(--text-secondary); font-size:14px; line-height:1.6; max-width:600px;">
            Developer Pro trial keys are provisioned within 24 hours. High-Assurance Enterprise contracts include cryptographic license generator tooling, custom NUMA build optimization, and air-gapped installation bundles.
          </p>
          <div class="contact-details">
            <div class="contact-chip">
              <span class="chip-label">Direct Contact:</span>
              <a href="mailto:alix@hflabs.dev" class="chip-val">alix@hflabs.dev</a>
            </div>
          </div>
        </div>
        <div class="inquiry-actions">
          <a href="mailto:alix@hflabs.dev?subject=HT%20GraphRAG%20Licensing%20Inquiry" class="btn-primary" style="padding:14px 28px; font-size:14px; text-align:center;">
            Contact alix@hflabs.dev &rarr;
          </a>
          <a href="/docs#graphrag-operator" class="btn-secondary" style="padding:14px 28px; font-size:14px; text-align:center;">
            Read Operator Manual
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quickstart Commands Section -->
  <section id="quickstart" class="quickstart-section">
    <div class="container">
      <div class="section-header" style="text-align:center; max-width:760px; margin:0 auto 40px;">
        <div class="badge" style="background:rgba(52,211,153,0.15); color:var(--accent-emerald); border:1px solid rgba(52,211,153,0.3); margin-bottom:12px;">
          Developer Quickstart
        </div>
        <h2 style="font-size:26px; font-weight:800; margin-bottom:12px;">Runtime Launch Commands</h2>
        <p style="color:var(--text-secondary); font-size:14px;">
          Run Hypertensor GraphRAG as an embedded .NET daemon, CLI query engine, or Python FastMCP bridge.
        </p>
      </div>

      <div class="commands-grid">
        <div class="command-card">
          <div class="command-header">
            <span class="cmd-title">1. Dedicated Server Daemon</span>
            <span class="cmd-badge">gRPC / In-Memory</span>
          </div>
          <pre class="cmd-code"><code>dotnet run --project src/HFLabs/Products/HypertensorGraphRAG/Server/Server.csproj -c Release</code></pre>
          <p class="cmd-desc">Spins up the in-memory graph store and binds zero-copy IPC socket interfaces.</p>
        </div>

        <div class="command-card">
          <div class="command-header">
            <span class="cmd-title">2. Headless Topological Query CLI</span>
            <span class="cmd-badge">CLI / SIMD</span>
          </div>
          <pre class="cmd-code"><code>dotnet run --project src/HFLabs/Products/HypertensorGraphRAG/App/App.csproj -c Release -- --headless --query "Director"</code></pre>
          <p class="cmd-desc">Executes 2-hop graph reasoning with SIMD cosine scoring and outputs JSON results.</p>
        </div>

        <div class="command-card">
          <div class="command-header">
            <span class="cmd-title">3. FastMCP SSE Agent Bridge</span>
            <span class="cmd-badge">Python / MCP</span>
          </div>
          <pre class="cmd-code"><code>python -m mcp_graphrag.server --transport sse --port 8000</code></pre>
          <p class="cmd-desc">Exposes HT GraphRAG traversal primitives as Model Context Protocol tools for AI agents.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-top-bar {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-color);
    background: rgba(7, 10, 19, 0.6);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent-blue);
  }

  .breadcrumb .sep {
    color: var(--text-muted);
  }

  .breadcrumb .curr {
    color: var(--text-primary);
    font-weight: 600;
  }

  .product-hero {
    padding: 70px 0 50px;
    border-bottom: 1px solid var(--border-color);
    background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08), transparent 70%);
  }

  .hero-badge-row {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    max-width: 900px;
  }

  .hero-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 780px;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .metric-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .metric-detail {
    font-size: 11px;
    color: var(--text-muted);
  }

  .features-section {
    padding: 70px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s, border-color 0.2s;
  }

  .feature-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-2px);
  }

  .feature-icon {
    font-size: 24px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-sm);
  }

  .feature-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .feature-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .inquiry-section {
    padding: 60px 0;
    background: rgba(11, 15, 25, 0.6);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .inquiry-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(7, 10, 19, 0.95));
    border: 1px solid var(--border-highlight);
    border-radius: var(--radius-lg);
    padding: 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .inquiry-content {
    flex: 1;
    min-width: 300px;
  }

  .contact-details {
    display: flex;
    gap: 16px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .contact-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .chip-label {
    color: var(--text-muted);
  }

  .chip-val {
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .inquiry-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 220px;
  }

  .quickstart-section {
    padding: 70px 0;
  }

  .commands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
  }

  .command-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .command-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cmd-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cmd-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .cmd-code {
    background: #060911;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
    color: #a5b4fc;
    overflow-x: auto;
    font-family: var(--font-mono);
  }

  .cmd-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
