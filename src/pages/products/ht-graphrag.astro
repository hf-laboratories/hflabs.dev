---
// src/pages/products/ht-graphrag.astro
import Layout from '../../layouts/Layout.astro';

const metrics = [
  { label: "Product surfaces", value: "3", detail: "Windows desktop, headless CLI and HTTP server" },
  { label: "Graph stores", value: "In-memory", detail: "Named graph stores and a read-oriented compact ZIP corpus path" },
  { label: "Vector operations", value: "SIMD", detail: ".NET CPU vector search; acceleration depends on configuration" },
  { label: "Agent integration", value: "MCP", detail: "Python bridge to the GraphRAG HTTP server" }
];

const features = [
  {
    icon: "🕸️",
    title: "Graph stores and retrieval",
    desc: "Work with named in-memory graph stores, graph traversal and retrieval. A separate compact path indexes a selected ZIP corpus and can reuse a fingerprinted layer cache."
  },
  {
    icon: "📐",
    title: "Vector and text components",
    desc: "The codebase includes CPU SIMD vector search and BM25 text retrieval components. Their presence does not mean every query route combines both; behavior depends on the selected path and configuration."
  },
  {
    icon: "🔌",
    title: "Desktop, CLI and HTTP",
    desc: "A Windows desktop HUD and headless CLI operate alongside an ASP.NET Core server. The CLI supervises or calls the server through its API."
  },
  {
    icon: "🤝",
    title: "MCP agent bridge",
    desc: "A Python FastMCP bridge connects MCP clients to the HTTP server, with stdio, SSE and Streamable HTTP transports and optional scoped bundles."
  },
  {
    icon: "🧭",
    title: "Graph workflows",
    desc: "The server includes graph onboarding, querying and codebase topology workflows, including a separate KGE-based project deduplication operation."
  },
  {
    icon: "🧪",
    title: "Validation in progress",
    desc: "Product QA covers the compact store, live HTTP host and topology workflows. Provider-dependent agent capabilities and deployment configurations require their own validation."
  }
];
---

<Layout 
  title="Hypertensor GraphRAG & SIMD Vectors • In-Memory Graph & Vector Store" 
  description="An in-memory typed property-graph and vector store for autonomous developer agents. Keeps the graph in RAM and serves agents over REST and MCP.">
  
  <!-- Breadcrumb & Top Bar -->
  <div class="product-top-bar">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Overview</a>
        <span class="sep">/</span>
        <a href="/#divisions">Products</a>
        <span class="sep">/</span>
        <span class="curr">Hypertensor GraphRAG</span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="product-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3);">
          Vector &amp; Graph Engine
        </span>
        <span class="badge" style="background:rgba(251,191,36,0.15); color:var(--accent-amber); border:1px solid rgba(251,191,36,0.3);">
          Active Development · QA in Progress
        </span>
        <span class="badge" style="background:rgba(251,191,36,0.15); color:var(--accent-amber); border:1px solid rgba(251,191,36,0.3);">
          Open-Core Planned · Pro/HA Private
        </span>
      </div>

      <h1 class="hero-title">Hypertensor GraphRAG &amp; SIMD Vectors</h1>
      <p class="hero-desc" style="font-weight:600;">Active development: production QA and rollout-gate validation are in progress. Open-core is planned; Pro and High-Assurance feature bundles remain private and are not yet generally available.</p>
      <p class="hero-desc">
        A graph and retrieval toolkit for building, inspecting and querying knowledge. The product combines in-memory graph stores, a compact corpus retrieval path and operator interfaces for desktop, CLI, HTTP and MCP clients.
      </p>
      <p class="hero-desc">
        Graph queries can run without a generative model. Some agent workflows require configured providers, and end-to-end retrieval quality and production deployment readiness are still being evaluated.
      </p>

      <div class="hero-actions">
        <a href="#architecture" class="btn-primary" style="padding:12px 24px; font-size:14px;">
          Explore the Architecture &darr;
        </a>
        <a href="#licensing" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          View Licensing Tiers &darr;
        </a>
        <a href="#quickstart" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          Operator Quickstart &rarr;
        </a>
        <a href="/docs/graphrag-operator" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          Documentation
        </a>
      </div>

      <!-- Live Metrics Strip -->
      <div class="metrics-strip">
        {metrics.map(m => (
          <div class="metric-card">
            <span class="metric-val">{m.value}</span>
            <span class="metric-label">{m.label}</span>
            <span class="metric-detail">{m.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Architecture & Capabilities -->
  <section id="architecture" class="features-section">
    <div class="container">
      <div class="section-header" style="text-align:center; max-width:760px; margin:0 auto 48px;">
        <div class="badge" style="background:rgba(129,140,248,0.15); color:var(--accent-purple); border:1px solid rgba(129,140,248,0.3); margin-bottom:12px;">
          Core Substrates
        </div>
        <h2 style="font-size:28px; font-weight:800; margin-bottom:12px;">Engine Architecture &amp; Substrates</h2>
        <p style="color:var(--text-secondary); font-size:14px; line-height:1.6;">
          The repository contains several connected components with different storage contracts and stages of integration.
        </p>
      </div>

      <div class="features-grid">
        {features.map(f => (
          <div class="feature-card">
            <div class="feature-icon">{f.icon}</div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Procurement & Inquiry Section -->
  <section id="licensing" class="inquiry-section">
    <div class="container">
      <div class="inquiry-card">
        <div class="inquiry-content">
          <div class="badge" style="background:rgba(56,189,248,0.15); color:var(--accent-blue); border:1px solid rgba(56,189,248,0.3); margin-bottom:12px;">
            Licensing Procurement
          </div>
          <h2 style="font-size:24px; font-weight:800; margin-bottom:12px;">Licensing &amp; Availability</h2>
          <p style="color:var(--text-secondary); font-size:14px; line-height:1.6; max-width:600px;">
            GraphRAG is in active development. Pro and High-Assurance feature bundles are private, licensed offerings; availability and terms will be shared when those bundles are ready.
          </p>
          <div class="contact-details">
            <div class="contact-chip">
              <span class="chip-label">Direct Contact:</span>
              <a href="mailto:alix@hflabs.dev" class="chip-val">alix@hflabs.dev</a>
            </div>
          </div>
        </div>
        <div class="inquiry-actions">
          <a href="mailto:alix@hflabs.dev?subject=HT%20GraphRAG%20Licensing%20Inquiry" class="btn-primary" style="padding:14px 28px; font-size:14px; text-align:center;">
            Contact alix@hflabs.dev &rarr;
          </a>
          <a href="/docs/graphrag-operator" class="btn-secondary" style="padding:14px 28px; font-size:14px; text-align:center;">
            Read Operator Manual
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quickstart Commands Section -->
  <section id="quickstart" class="quickstart-section">
    <div class="container">
      <div class="section-header" style="text-align:center; max-width:760px; margin:0 auto 40px;">
        <div class="badge" style="background:rgba(52,211,153,0.15); color:var(--accent-emerald); border:1px solid rgba(52,211,153,0.3); margin-bottom:12px;">
          Developer Quickstart
        </div>
        <h2 style="font-size:26px; font-weight:800; margin-bottom:12px;">Runtime Launch Commands</h2>
        <p style="color:var(--text-secondary); font-size:14px;">
          From the IPUServices repository root, run the HTTP host and use the Windows headless client or Python MCP bridge. Configure authentication for your environment before connecting clients.
        </p>
      </div>

      <div class="commands-grid">
        <div class="command-card">
          <div class="command-header">
            <span class="cmd-title">1. HTTP Server</span>
            <span class="cmd-badge">ASP.NET Core</span>
          </div>
          <pre class="cmd-code"><code>dotnet run --project src/HFLabs/Products/HypertensorGraphRAG/Server/HFLabs.GraphRAG.Server.csproj -c Release</code></pre>
          <p class="cmd-desc">Starts the server host. Its default configured URL is http://localhost:5000.</p>
        </div>

        <div class="command-card">
          <div class="command-header">
            <span class="cmd-title">2. Headless Query CLI</span>
            <span class="cmd-badge">CLI / SIMD</span>
          </div>
          <pre class="cmd-code"><code>dotnet run --project src/HFLabs/Products/HypertensorGraphRAG/App/HFLabs.GraphRAG.App.csproj -c Release -- --headless query "Director"</code></pre>
          <p class="cmd-desc">Calls the running server. Use --help to inspect commands and options.</p>
        </div>

        <div class="command-card">
          <div class="command-header">
            <span class="cmd-title">3. FastMCP SSE Agent Bridge</span>
            <span class="cmd-badge">Python / MCP</span>
          </div>
          <pre class="cmd-code"><code>pip install -e src/HFLabs/Products/HypertensorGraphRAG/MCPHost
python -m mcp_graphrag.server --transport sse --port 8000</code></pre>
          <p class="cmd-desc">Install the bridge, then start it against a configured GraphRAG server.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-top-bar {
    padding: 16px 0;
    border-bottom: 1px solid var(--border-color);
    background: rgba(7, 10, 19, 0.6);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent-blue);
  }

  .breadcrumb .sep {
    color: var(--text-muted);
  }

  .breadcrumb .curr {
    color: var(--text-primary);
    font-weight: 600;
  }

  .product-hero {
    padding: 70px 0 50px;
    border-bottom: 1px solid var(--border-color);
    background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.08), transparent 70%);
  }

  .hero-badge-row {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    max-width: 900px;
  }

  .hero-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 780px;
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .metric-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .metric-detail {
    font-size: 11px;
    color: var(--text-muted);
  }

  .features-section {
    padding: 70px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s, border-color 0.2s;
  }

  .feature-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-2px);
  }

  .feature-icon {
    font-size: 24px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-sm);
  }

  .feature-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .feature-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .inquiry-section {
    padding: 60px 0;
    background: rgba(11, 15, 25, 0.6);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .inquiry-card {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(7, 10, 19, 0.95));
    border: 1px solid var(--border-highlight);
    border-radius: var(--radius-lg);
    padding: 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .inquiry-content {
    flex: 1;
    min-width: 300px;
  }

  .contact-details {
    display: flex;
    gap: 16px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .contact-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .chip-label {
    color: var(--text-muted);
  }

  .chip-val {
    color: var(--accent-blue);
    font-family: var(--font-mono);
  }

  .inquiry-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 220px;
  }

  .quickstart-section {
    padding: 70px 0;
  }

  .commands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
  }

  .command-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .command-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cmd-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cmd-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.1);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .cmd-code {
    background: #060911;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
    color: #a5b4fc;
    overflow-x: auto;
    font-family: var(--font-mono);
  }

  .cmd-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
