---
import Layout from '../../layouts/Layout.astro';

const metrics = [
  { label: "Core Philosophy", value: "Fail-Closed By Design", detail: "Binds only verifiable C-compatible types; rejects ambiguous ABI constructs with explicit reasons" },
  { label: "Manifest Tracking", value: "Full SHA-256 Fingerprint", detail: "Records resolved libclang path, normalized include paths, defines, and exact compiler flags" },
  { label: "Upstream Sync", value: "Automated Release Watcher", detail: "Monitors GitHub releases/feeds, diffs API word count against approved baselines, and flags changes" },
  { label: "Verification Loop", value: "5-Stage Validation", detail: "Native build, managed compilation, smoke tests, deterministic rerun & schema verification" }
];

const failClosedRules = [
  {
    type: "Supported & Verifiable",
    status: "Verified Safe",
    statusColor: "#10b981",
    icon: "✓",
    items: [
      "Top-level C-compatible free functions",
      "Scalar and fixed-width integer types (int32_t, uint64_t, size_t, etc.)",
      "Plain structs with public scalar fields & nested POD structs",
      "Fixed-size primitive arrays (e.g., uint8_t[32])",
      "Non-owning pointers to supported plain structs (ref/in semantics)",
      "Explicitly configured opaque native handles with ownership metadata"
    ]
  },
  {
    type: "Fail-Closed Rejections (Never Guessed)",
    status: "Strictly Rejected",
    statusColor: "#f43f5e",
    icon: "✕",
    items: [
      "C++ Namespaces & Classes with virtual method tables",
      "Complex structs with non-trivial constructors/destructors",
      "Unsupported or untyped C++ enums",
      "C++ References (& and && rvalue references)",
      "Struct-pointer returns with ambiguous ownership",
      "C++ Templates, Overloads, Callbacks, Unions & Bitfields"
    ]
  }
];

const dashboardProjects = [
  { name: "Intel LevelZero Core ABI", version: "v1.17.4", status: "Succeeded", statusColor: "#10b981", feed: "GitHub Release", diff: "0 changes (Approved)", standard: "C++17" },
  { name: "Graphcore Poplar C Shim", version: "v3.3.0", status: "Update Available", statusColor: "#38bdf8", feed: "Build Feed", diff: "+14 decls / -2 deprecated", standard: "C++20" },
  { name: "HFLabs AVX512 Math Driver", version: "v2.1.0", status: "Ready", statusColor: "#818cf8", feed: "Local Git", diff: "Baseline Synced", standard: "C++20" },
  { name: "Heterogeneous RDMA Kernel", version: "v0.8.2-rc", status: "Verification Failed", statusColor: "#f43f5e", feed: "CI Webhook", diff: "Smoke Test 0x04 Exit", standard: "C++23" }
];

const verificationStages = [
  { name: "1. Native Build", desc: "Compiles C ABI native shim with target toolchain to verify syntax and symbol visibility." },
  { name: "2. Managed Build", desc: "Invokes Roslyn compiler on generated C# P/Invoke bindings, verifying unsafe struct layouts." },
  { name: "3. Smoke Test", desc: "Executes automated native-to-managed roundtrip calls validating parameter passing and alignment." },
  { name: "4. Deterministic Rerun", desc: "Regenerates from identical headers and asserts bit-for-bit identical manifest and code output." },
  { name: "5. Schema Validation", desc: "Validates emitted metadata against HFLabs standard API and wire contract schemas." }
];
---

<Layout 
  title="Abigen (in development) • Reviewed & Verified C# Bindings from C/C++ Headers | HF Labs"
  description="Abigen generates reviewed, verified C# bindings from C/C++ headers and manages the ongoing relationship with upstream native libraries as they evolve."
>
  <!-- Top Breadcrumb Bar -->
  <div class="product-top-bar">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Overview</a>
        <span class="sep">/</span>
        <a href="/products">Products</a>
        <span class="sep">/</span>
        <span class="curr">Abigen (in development)</span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="product-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="badge badge-amber">In Development</span>
        <span class="badge badge-rose">Fail-Closed Parser</span>
        <span class="badge badge-purple">libclang Engine</span>
        <span class="badge badge-cyan">Abigen.Desktop &amp; Abigen.Core</span>
      </div>

      <h1 class="hero-title">Abigen <span style="font-size:24px; font-weight:500; color:var(--text-muted);">(in development)</span></h1>
      
      <p class="hero-lead">
        Point it at a C/C++ header, get reviewed, verified C# bindings — and keep them in sync as the native library moves.
      </p>

      <p class="hero-desc">
        Abigen generates C/C# interop bindings from C++ headers, then manages the ongoing relationship with the native library those bindings came from: tracking new releases, regenerating, verifying, and flagging what changed for human review before anything ships. It's a desktop app (Abigen.Desktop) on top of a managed project engine (Abigen.Core), which itself wraps HF Labs' own header-analysis and code-generation CLI rather than duplicating its parser or ABI decisions.
      </p>

      <!-- Primary Action CTAs -->
      <div class="hero-actions">
        <a href="https://github.com/hf-laboratories/IPUServices" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding:12px 24px; font-size:14px;">
          View on GitHub
        </a>
        <a href="/docs/accelerator-interop" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          Read the Docs &rarr;
        </a>
        <a href="mailto:alix@hflabs.dev" class="btn-secondary" style="padding:12px 24px; font-size:14px;">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <!-- Metrics Ribbon -->
  <section class="metrics-ribbon">
    <div class="container">
      <div class="metrics-grid">
        {metrics.map(m => (
          <div class="metric-card">
            <span class="metric-label">{m.label}</span>
            <strong class="metric-value">{m.value}</strong>
            <p class="metric-detail">{m.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 1: A narrow, fail-closed generator, by design -->
  <section class="product-section">
    <div class="container">
      <div class="section-center-header">
        <div class="badge badge-rose" style="margin-bottom:12px;">Strict Boundary Isolation</div>
        <h2 class="section-heading">A Narrow, Fail-Closed Generator, by Design</h2>
        <p class="section-subtext">
          The generator does not attempt to bind arbitrary C++. It emits bindings only for what it can verify is safe: top-level C-compatible free functions, scalar and fixed-width integer types, plain structs with public scalar fields (including nested structs and fixed arrays), non-owning pointers to supported structs, and explicitly configured opaque native handles.
        </p>
      </div>

      <div class="fail-closed-grid">
        {failClosedRules.map(rule => (
          <div class="rule-card" style={`--rule-color: ${rule.statusColor};`}>
            <div class="rule-header">
              <span class="rule-icon">{rule.icon}</span>
              <div>
                <h3 class="rule-title">{rule.type}</h3>
                <span class="rule-badge" style={`color:${rule.statusColor}; border-color:${rule.statusColor}40; background:${rule.statusColor}15;`}>
                  {rule.status}
                </span>
              </div>
            </div>
            <ul class="rule-list">
              {rule.items.map(item => (
                <li>
                  <span class="bullet-dot" style={`background:${rule.statusColor};`}></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="rejection-callout-box">
        <div class="callout-icon-large">🛡️</div>
        <div>
          <h4>Never Guessing with Bare IntPtr</h4>
          <p>
            Everything else — <strong>namespaces, classes, complex structs, unsupported enums, references, struct-pointer returns, templates, callbacks, overloads, unions, bitfields</strong> — is rejected, not guessed at. Rejected declarations are reported with reasons and are never silently turned into a bare <code>IntPtr</code> binding that might be wrong.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: A project, not a one-shot run -->
  <section class="product-section alt-bg">
    <div class="container">
      <div class="grid-2col">
        <div>
          <div class="badge badge-purple" style="margin-bottom:12px;">Managed Project Engine</div>
          <h2 class="section-heading">A Project, Not a One-Shot Run</h2>
          <p class="section-desc">
            <code>Abigen.Core</code> wraps each header/library pairing as a project with its own configuration: header paths, include paths and defines, target language standard (C++11 through C++23), an export policy (include/exclude patterns, name overrides, ownership metadata for handles), and a resolved libclang toolchain fingerprint recorded for reproducibility.
          </p>
          <p class="section-desc">
            Every generation records a full manifest — the resolved libclang path and SHA-256 fingerprint, normalized include paths and defines, effective Clang arguments — so a binding set can be verified as reproducible later, not just trusted.
          </p>
        </div>

        <div class="code-terminal-card">
          <div class="terminal-bar">
            <span class="t-dot red"></span>
            <span class="t-dot yellow"></span>
            <span class="t-dot green"></span>
            <span class="t-title">abigen_manifest.json • Reproducible Fingerprint</span>
          </div>
          <pre class="terminal-code"><code>&#123;
  "$schema": "https://hflabs.dev/schemas/abigen_project_v1.json",
  "projectName": "LevelZero.Core.Interop",
  "targetLanguageStandard": "C++17",
  "toolchain": &#123;
    "libclangPath": "/opt/llvm-18/lib/libclang.so.18",
    "libclangSha256": "9f8a3c...b412e87",
    "effectiveClangArgs": [
      "-std=c++17",
      "-DZE_ENABLE_PREVIEW",
      "-I/usr/include/level_zero"
    ]
  &#125;,
  "exportPolicy": &#123;
    "opaqueHandles": ["ze_driver_handle_t", "ze_device_handle_t"],
    "ownershipRules": &#123; "ze_device_handle_t": "BorrowNonOwning" &#125;,
    "namePrefixTransform": "TrimPrefix(ze)"
  &#125;,
  "approvalState": "Approved",
  "lastVerifiedTimestamp": "2026-09-21T18:42:00Z"
&#125;</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3 & 4: Release Tracking & Review Before Trust -->
  <section class="product-section">
    <div class="container">
      <div class="dual-feature-grid">
        <div class="feature-panel">
          <div class="panel-icon">📡</div>
          <div class="badge badge-cyan" style="margin-bottom:8px;">Continuous Upstream Sync</div>
          <h3 class="panel-heading">Release Tracking, Not a One-Time Export</h3>
          <p class="panel-desc">
            A project can track a GitHub repository or a build feed and follow a version policy (latest-release by default). When a new release lands, Abigen surfaces it as an update, diffs the API surface word count against what was last approved, and lets you review before regenerating. An RSS server can publish that feed state out to other tools.
          </p>
          <div class="pill-badge-list">
            <span class="tech-pill">GitHub Release Watcher</span>
            <span class="tech-pill">API Surface Word-Diff</span>
            <span class="tech-pill">Embedded RSS Feed Server</span>
          </div>
        </div>

        <div class="feature-panel">
          <div class="panel-icon">⚖️</div>
          <div class="badge badge-amber" style="margin-bottom:8px;">Human In The Loop</div>
          <h3 class="panel-heading">Review Before It's Trusted</h3>
          <p class="panel-desc">
            Every project carries an approval state (unreviewed by default). The desktop app's API review dialog shows the generated report per project, and generation failures return a distinct, documented exit code rather than a silent partial success.
          </p>
          <p class="panel-desc">
            A verification workflow runs configurable native build, managed build, smoke-test, deterministic-rerun and schema-validation commands, and records the last verification timestamp and the workspace from the last failure, so a broken regeneration is diagnosable, not just red.
          </p>
        </div>
      </div>

      <!-- Verification Workflow Strip -->
      <div class="verification-stepper">
        <div class="stepper-titlebar">
          <span class="badge badge-emerald">5-Stage Verification Workflow</span>
          <h4>Complete Automated Invariant Checking</h4>
        </div>
        <div class="stepper-grid">
          {verificationStages.map(s => (
            <div class="step-card">
              <strong class="step-name">{s.name}</strong>
              <p class="step-desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Desktop Workflow Dashboard -->
  <section class="product-section alt-bg">
    <div class="container">
      <div class="section-center-header">
        <div class="badge badge-purple" style="margin-bottom:12px;">Visual Project Command Center</div>
        <h2 class="section-heading">Desktop Workflow (Abigen.Desktop)</h2>
        <p class="section-subtext">
          The desktop app is a project dashboard: a grid of tracked projects and their status (not configured, ready, running, succeeded, generation failed, verification failed, update available, feed unavailable), a toolchain report dialog showing the resolved libclang evidence, an API review dialog per project, and a project editor for header paths, opaque handle types and export policy.
        </p>
      </div>

      <!-- Mockup Window of Desktop UI -->
      <div class="desktop-mockup-frame">
        <div class="mockup-topbar">
          <div class="mockup-controls">
            <span class="dot-btn red"></span>
            <span class="dot-btn yellow"></span>
            <span class="dot-btn green"></span>
          </div>
          <span class="mockup-title">Abigen.Desktop v1.0 • Interop Project Dashboard</span>
          <span class="mockup-tag">libclang 18.1.8</span>
        </div>

        <div class="mockup-body">
          <div class="mockup-toolbar">
            <div class="toolbar-btn primary">+ New Tracked Project</div>
            <div class="toolbar-btn">⚡ Run Verification All</div>
            <div class="toolbar-btn">📋 libclang Toolchain Report</div>
            <div class="toolbar-btn">📡 RSS Feed Status</div>
          </div>

          <div class="mockup-table">
            <div class="table-head">
              <span>PROJECT NAME</span>
              <span>UPSTREAM VERSION</span>
              <span>STATUS</span>
              <span>FEED SOURCE</span>
              <span>API REVIEW DIFF</span>
              <span>ACTIONS</span>
            </div>
            {dashboardProjects.map(p => (
              <div class="table-row">
                <strong class="proj-name">{p.name}</strong>
                <span class="proj-ver">{p.version}</span>
                <span>
                  <span class="status-chip" style={`color:${p.statusColor}; border-color:${p.statusColor}40; background:${p.statusColor}18;`}>
                    {p.status}
                  </span>
                </span>
                <span class="proj-feed">{p.feed}</span>
                <span class="proj-diff">{p.diff}</span>
                <span class="proj-actions">
                  <button class="table-action-btn">Review</button>
                  <button class="table-action-btn">Edit</button>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Why This Exists -->
  <section class="product-section">
    <div class="container">
      <div class="rationale-card">
        <div class="badge badge-rose" style="margin-bottom:12px;">Architectural Rationale</div>
        <h2 class="rationale-title">Why This Exists</h2>
        <p class="rationale-quote">
          &ldquo;Hand-written P/Invoke bindings rot the moment the native library changes, and a general-purpose C++ binder papers over ABI decisions no one actually reviewed. Abigen keeps the boundary narrow enough to trust by construction, and keeps it current by watching the upstream release instead of waiting for someone to notice it drifted.&rdquo;
        </p>
        
        <div class="cta-banner-row">
          <div class="cta-actions">
            <a href="https://github.com/hf-laboratories/IPUServices" target="_blank" rel="noopener noreferrer" class="btn-primary" style="padding:12px 28px;">
              View on GitHub
            </a>
            <a href="/docs/accelerator-interop" class="btn-secondary" style="padding:12px 24px;">
              Read the Docs &rarr;
            </a>
            <a href="mailto:alix@hflabs.dev" class="btn-secondary" style="padding:12px 24px;">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-top-bar {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid var(--border-color);
    padding: 12px 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--accent-blue);
  }

  .breadcrumb .curr {
    color: var(--accent-blue);
    font-weight: 600;
  }

  .product-hero {
    padding: 60px 0 40px;
    background: 
      radial-gradient(ellipse 70% 50% at 50% -10%, rgba(244, 63, 94, 0.2), transparent 70%),
      radial-gradient(ellipse 50% 30% at 20% 0%, rgba(56, 189, 248, 0.15), transparent 60%);
  }

  .hero-badge-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    line-height: 1.15;
  }

  .hero-lead {
    font-size: 20px;
    font-weight: 600;
    color: #38bdf8;
    max-width: 860px;
    line-height: 1.45;
    margin-bottom: 16px;
  }

  .hero-desc {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 900px;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .metrics-ribbon {
    padding: 30px 0;
    background: rgba(10, 15, 28, 0.45);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .metric-card {
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.14), 0 8px 24px -4px rgba(0, 0, 0, 0.4);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .metric-card:hover {
    background: rgba(24, 34, 64, 0.6);
    border-color: rgba(255, 255, 255, 0.24);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.24), 0 12px 32px 0 rgba(0, 0, 0, 0.45);
    transform: translateY(-2px);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-value {
    font-size: 19px;
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .metric-detail {
    font-size: 12.5px;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .product-section {
    padding: 60px 0;
  }

  .product-section.alt-bg {
    background: rgba(15, 23, 42, 0.4);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-center-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 40px;
  }

  .section-heading {
    font-size: clamp(24px, 3.5vw, 32px);
    font-weight: 800;
    color: #f8fafc;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .section-subtext {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .section-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 14px;
  }

  /* Fail-Closed Rules Grid */
  .fail-closed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-bottom: 30px;
  }

  .rule-card {
    background: rgba(15, 23, 42, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 3px solid var(--rule-color);
    border-radius: var(--radius-md);
    padding: 24px;
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.14), 0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.25s ease;
  }

  .rule-card:hover {
    background: rgba(22, 33, 62, 0.6);
    border-color: rgba(255, 255, 255, 0.22);
    border-left-color: var(--rule-color);
    box-shadow: inset 0 1px 2px 0 rgba(255, 255, 255, 0.22), 0 12px 36px 0 rgba(0, 0, 0, 0.45);
  }

  .rule-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .rule-icon {
    font-size: 20px;
    font-weight: 900;
    color: var(--rule-color);
  }

  .rule-title {
    font-size: 17px;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 4px;
  }

  .rule-badge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid;
    display: inline-block;
  }

  .rule-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rule-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    color: #cbd5e1;
    line-height: 1.5;
  }

  .bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: 7px;
    flex-shrink: 0;
  }

  .rejection-callout-box {
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .callout-icon-large {
    font-size: 28px;
    flex-shrink: 0;
  }

  .rejection-callout-box h4 {
    font-size: 15px;
    font-weight: 700;
    color: #f43f5e;
    margin-bottom: 6px;
  }

  .rejection-callout-box p {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .rejection-callout-box code {
    background: rgba(0, 0, 0, 0.4);
    padding: 2px 6px;
    border-radius: 4px;
    color: #fbbf24;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* 2 Column Section */
  .grid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .grid-2col {
      grid-template-columns: 1fr;
    }
