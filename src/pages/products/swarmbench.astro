---
// src/pages/products/swarmbench.astro
import Layout from '../../layouts/Layout.astro';
import { 
  BENCHMARK_FUNCTIONS, 
  BENCHMARK_CATEGORIES, 
  BENCHMARK_COMMANDS, 
  VISUALIZER_LAYERS, 
  LIFECYCLE_STAGES 
} from '../../data/swarmBenchCatalog';

const metrics = [
  { value: "34", label: "Optimization Algorithms", detail: "Classic swarms, search methods, 14 hybrids and multi-objective engines" },
  { value: "110", label: "Registered Test Functions", detail: "9 problem families: unimodal, multimodal, constrained, combinatorial, etc." },
  { value: "2,500+", label: "Automated Tests", detail: "Full unit test suite validating mathematical correctness and invariants" },
  { value: "7", label: "Run Lifecycle Stages", detail: "From topology scan to convergence events and HyperCache writeback" },
  { value: "100%", label: "Deterministic & Seeded", detail: "Exact seed replay, dimension binning, and self-validating characterization" }
];

const pillars = [
  {
    icon: "🌐",
    title: "Broad by default",
    desc: "Classic swarms, search methods, 14 hybrids and two multi-objective algorithms meet unimodal, multimodal, constrained, multi-objective, combinatorial, dynamic, niching, noisy and high-dimensional problems.",
    color: "#38bdf8"
  },
  {
    icon: "🎯",
    title: "Repeatable",
    desc: "Every run takes a seed, the larger problem variants use fixed seeds, and tuned settings are cached per function and dimension bin.",
    color: "#818cf8"
  },
  {
    icon: "👁️",
    title: "Visible",
    desc: "A live and replay visualizer shows agents, subswarms, topology regions and feature planes as a run unfolds.",
    color: "#10b981"
  },
  {
    icon: "🛡️",
    title: "Checked",
    desc: "The algorithm library alone carries more than 2,500 automated tests, and characterization profiles validate themselves before they are written.",
    color: "#f59e0b"
  }
];
---

<Layout 
  title="SwarmBench • Benchmarking, Characterization & HUD for Swarms | HF Labs"
  description="Measure how swarms really behave, and watch them work. HyperSwarm's benchmarking and visualization tools run 34 optimization algorithms against 110 test functions, record every run, and let you watch or replay each one agent by agent."
>
  <!-- Top Breadcrumb -->
  <div class="product-top-bar">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Overview</a>
        <span class="sep">/</span>
        <a href="/products">Products</a>
        <span class="sep">/</span>
        <span class="curr">SwarmBench</span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="product-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="badge badge-accent">HyperSwarm Ecosystem</span>
        <span class="badge badge-green">34 Optimizers &bull; 110 Test Functions</span>
        <span class="badge badge-purple">Real-Time Telemetry &amp; HUD</span>
      </div>

      <h1 class="hero-title">
        SwarmBench
      </h1>

      <p class="hero-tagline">
        Measure how swarms really behave, and watch them work.
      </p>

      <p class="hero-desc">
        HyperSwarm's benchmarking and visualization tools run 34 optimization algorithms against 110 test functions, record every run, and let you watch or replay each one agent by agent. Benchmark any algorithm on any problem with standardized seeds, eliminate underperforming configs in multi-stage tournaments, and inspect live swarm dispersion on desktop HUD canvases.
      </p>

      <!-- Primary Action CTAs -->
      <div class="hero-actions">
        <a href="#functions-catalog" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M3 9h18M9 21V9"></path>
          </svg>
          <span>Explore 110 Functions</span>
        </a>
        <a href="#command-runner" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          <span>CLI Commands</span>
        </a>
        <a href="#visualizer" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
          <span>Swarm Visualizer HUD</span>
        </a>
        <a href="/products/hyperswarm" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>HyperSwarm Product</span>
        </a>
      </div>

      <!-- Live Metrics Strip -->
      <div class="metrics-strip">
        {metrics.map(m => (
          <div class="metric-card">
            <span class="metric-val">{m.value}</span>
            <span class="metric-label">{m.label}</span>
            <span class="metric-detail">{m.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Core Pillars -->
  <section class="pillars-section">
    <div class="container">
      <div class="pillars-grid">
        {pillars.map(p => (
          <div class="pillar-card" style={`--p-color:${p.color};`}>
            <div class="pillar-icon-wrap" style={`background:${p.color}15; border-color:${p.color}40;`}>
              <span class="p-icon">{p.icon}</span>
            </div>
            <h3 class="pillar-title">{p.title}</h3>
            <p class="pillar-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benchmark Any Algorithm on Any Problem (CLI Runner) -->
  <section id="command-runner" class="command-runner-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-accent">CLI &bull; SwarmBenchmarkRunner</div>
        <h2 class="section-title">Benchmark Any Algorithm on Any Problem</h2>
        <p class="section-subtitle">
          One command-line runner, <code>SwarmBenchmarkRunner</code>, covers single runs, streamed telemetry, tournaments, tuning sweeps and cache maintenance. Every run takes the same core options: <code>--algorithm</code>, <code>--function</code>, <code>--dimensions</code> (default 10), <code>--iterations</code> (default 500), <code>--swarm-size</code> (default 50) and a random <code>--seed</code> (default 42).
        </p>
      </div>

      <!-- Commands Table -->
      <div class="commands-table-box">
        <div class="table-header-row">
          <span class="th-col col-cmd">Command</span>
          <span class="th-col col-desc">What it does</span>
          <span class="th-col col-syntax">Example Syntax</span>
        </div>
        <div class="table-body">
          {BENCHMARK_COMMANDS.map(c => (
            <div class="table-row">
              <div class="td-col col-cmd">
                <code>{c.cmd}</code>
                <span class="cat-tag">{c.category}</span>
              </div>
              <div class="td-col col-desc">{c.desc}</div>
              <div class="td-col col-syntax">
                <div class="code-snippet-row">
                  <pre><code>{c.syntax}</code></pre>
                  <button class="copy-cmd-btn" data-clipboard={c.syntax} title="Copy command">Copy</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Workflow Deep Dive Grid -->
      <div class="workflow-cards-grid">
        <!-- Card 1: Tournaments -->
        <div class="workflow-card">
          <div class="wf-header">
            <span class="wf-badge" style="color:#f59e0b; background:#f59e0b15; border-color:#f59e0b40;">Tournament Engine</span>
            <h3 class="wf-title">Tournaments, not just single runs</h3>
          </div>
          <p class="wf-desc">
            The benchmark game puts a pool of agents (50 by default) through stages drawn from the test functions. Each stage elects agents for full trials, keeps a fraction as survivors, and can split the pool into subswarms once it converges together. Filter the stages by category, choose the algorithms in the pool, and set the hardware backend.
          </p>
          <div class="wf-code-box">
            <pre><code>SwarmBenchmarkRunner run-game \
  --pool 50 \
  --survivors 0.5 \
  --split-subswarms \
  --backend levelzero</code></pre>
          </div>
        </div>

        <!-- Card 2: HyperCache -->
        <div class="workflow-card">
          <div class="wf-header">
            <span class="wf-badge" style="color:#10b981; background:#10b98115; border-color:#10b98140;">Tuned Cache</span>
            <h3 class="wf-title">Tuned settings you can reuse</h3>
          </div>
          <p class="wf-desc">
            The HyperCache stores the best configurations found for each function and dimension bin, and the validate commands check that every cached configuration can still be reached across consecutive seed replays.
          </p>
          <div class="wf-code-box">
            <pre><code>SwarmBenchmarkRunner hypercache-validate \
  --check-recall \
  --dimension-bins 10d,30d,100d</code></pre>
          </div>
        </div>

        <!-- Card 3: Characterization Profiles -->
        <div class="workflow-card">
          <div class="wf-header">
            <span class="wf-badge" style="color:#ec4899; background:#ec489915; border-color:#ec489940;">Self-Validating Reports</span>
            <h3 class="wf-title">Characterization profiles</h3>
          </div>
          <p class="wf-desc">
            The <code>SwarmCharacterization</code> tool runs one algorithm on one function and dimension across several seeds (five by default). It self-validates the result before anything is written, then produces a machine-readable <code>profile.json</code>, a readable <code>profile.md</code> and a standalone LaTeX <code>profile.tex</code> per algorithm. Re-running a combination replaces only that entry, so profiles grow one function and dimension at a time.
          </p>
          <div class="wf-code-box">
            <pre><code>SwarmCharacterization \
  --algorithm cma_es \
  --function rosenbrock \
  --seeds 5 \
  --emit json,md,tex</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Watch the Swarm Run (Visualizer HUD) -->
  <section id="visualizer" class="visualizer-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-purple">HUD &bull; SwarmVisualizer.Host</div>
        <h2 class="section-title">Watch the Swarm Run</h2>
        <p class="section-subtitle">
          The visualizer turns any benchmark run into a scene you can watch live or replay later. It shows every agent, every subswarm and the landscape the swarm is reading.
        </p>
      </div>

      <!-- 3 Ways to Watch Strip -->
      <div class="visualizer-modes-grid">
        <div class="vmode-card">
          <div class="vmode-num">01</div>
          <h4 class="vmode-title">Live Execution</h4>
          <p class="vmode-desc">Pipe a run straight in, or let the host launch and attach automatically.</p>
          <pre class="vmode-code"><code>SwarmBenchmarkRunner run-stream ... | SwarmVisualizer.Host stdin
# Or let the host launch the command:
SwarmVisualizer.Host capture &lt;command&gt;</code></pre>
        </div>

        <div class="vmode-card">
          <div class="vmode-num">02</div>
          <h4 class="vmode-title">Deterministic Replay</h4>
          <p class="vmode-desc">Plays back saved per-agent, per-iteration traces with variable playback speed.</p>
          <pre class="vmode-code"><code>SwarmVisualizer.Host replay trace.jsonl</code></pre>
        </div>

        <div class="vmode-card">
          <div class="vmode-num">03</div>
          <h4 class="vmode-title">Headless JSON Report</h4>
          <p class="vmode-desc">Turns a trace into an aggregated JSON run summary without rendering a window.</p>
          <pre class="vmode-code"><code>SwarmVisualizer.Host report trace.jsonl summary.json</code></pre>
        </div>
      </div>

      <!-- What is on screen & Frame Layer Breakdown -->
      <div class="hud-details-grid">
        <div class="hud-narrative-box">
          <h3 class="hud-heading">What is on screen</h3>
          <p class="hud-text">
            The Windows desktop app draws a live scatter plot of the agents and time-series charts of the run's metrics, with run, source, iteration, progress, best fitness and agent count in view. It auto-attaches to local swarm telemetry, opens replay files, launches captured runs, and reloads saved runs from the persistence catalog. It sits on the same scene stream as the console host, so a run looks the same wherever you open it.
          </p>

          <h4 class="stages-heading">7 Lifecycle Stages of a Run</h4>
          <div class="stages-flow">
            {LIFECYCLE_STAGES.map(s => (
              <div class="stage-step">
                <span class="stage-num">{s.stage}</span>
                <div>
                  <strong class="stage-title">{s.name}:</strong>
                  <span class="stage-desc">{s.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Frame Layers Card -->
        <div class="hud-layers-card">
          <h3 class="hud-heading">What a Frame Carries</h3>
          <p class="hud-text">Each frame delivers rich spatial and telemetry layers across the search landscape:</p>

          <div class="layers-list">
            {VISUALIZER_LAYERS.map(l => (
              <div class="layer-item" style={`--l-color:${l.color};`}>
                <div class="layer-title-row">
                  <span class="l-icon">{l.icon}</span>
                  <span class="l-name">{l.layer}</span>
                </div>
                <p class="l-desc">{l.description}</p>
              </div>
            ))}
          </div>

          <div class="extensibility-box">
            <div class="ext-title">Built to be Extended</div>
            <p class="ext-desc">
              Scenes come from pluggable sources (JSONL file, stdin, launched process, stream, persisted runs) and go to pluggable plugins (console summary, JSON summary, desktop window). Add your own by implementing:
            </p>
            <pre class="ext-code"><code>public interface ISwarmSceneSource &#123;
  IAsyncEnumerable&lt;SwarmSceneFrame&gt; ReadFramesAsync(CancellationToken ct);
&#125;

public interface ISwarmScenePlugin &#123;
  Task OnFrameReceivedAsync(SwarmSceneFrame frame, CancellationToken ct);
&#125;</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete 110 Test Function Catalog -->
  <section id="functions-catalog" class="catalog-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-green">COMPLETE CATALOG (110 FUNCTIONS)</div>
        <h2 class="section-title">The 110 Registered Test Functions</h2>
        <p class="section-subtitle">
          The suite ships 110 registered test functions across nine problem families. Each reports recommended dimensions, default bounds and known optimum. Scaled variants share a name and differ by problem size so you can test high-dimensional scaling.
        </p>
      </div>

      <!-- Live Search & Filter Bar -->
      <div class="catalog-toolbar">
        <div class="catalog-search-box">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="fnSearchInput" 
            placeholder="Search 110 functions by ID, name, optimum, or notes..." 
            aria-label="Filter benchmark functions"
          />
          <button id="clearFnSearch" class="clear-search-btn" title="Clear search" style="display:none;">&times;</button>
        </div>

        <div class="catalog-counter" id="catalogCounter">
          Showing <strong>110</strong> of 110 functions
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="catalog-pills-bar">
        {BENCHMARK_CATEGORIES.map(cat => (
          <button 
            class={`cat-pill ${cat.key === 'all' ? 'active' : ''}`}
            data-cat={cat.key}
          >
            <span class="pill-dot" style={`background:${cat.color}; box-shadow:0 0 6px ${cat.color};`}></span>
            <span class="pill-name">{cat.label}</span>
            <span class="pill-num">{cat.count}</span>
          </button>
        ))}
      </div>

      <!-- Functions Table -->
      <div class="fn-table-container">
        <table class="fn-table" id="functionsTable">
          <thead>
            <tr>
              <th style="width: 130px;">Function ID</th>
              <th style="width: 220px;">Function Name</th>
              <th style="width: 140px;">Category</th>
              <th style="width: 110px; text-align:center;">Dimensions</th>
              <th style="width: 150px;">Known Optimum</th>
              <th>Formulation &amp; Characterization Notes</th>
            </tr>
          </thead>
          <tbody>
            {BENCHMARK_FUNCTIONS.map(fn => (
              <tr 
                class={`fn-row cat-row-${fn.categoryKey}`}
                data-cat={fn.categoryKey}
                data-search={`${fn.id} ${fn.name} ${fn.category} ${fn.knownOptimum} ${fn.notes || ''}`.toLowerCase()}
              >
                <td class="fn-id-cell"><code>{fn.id}</code></td>
                <td class="fn-name-cell">
                  <strong>{fn.name}</strong>
                  {fn.objectives && <span class="obj-tag">{fn.objectives} Objectives</span>}
                  {fn.noiseLevel && <span class="noise-tag">&sigma; = {fn.noiseLevel}</span>}
                </td>
                <td class="fn-cat-cell">
                  <span class={`cat-badge badge-${fn.categoryKey}`}>{fn.category}</span>
                </td>
                <td class="fn-dim-cell">{fn.dimensions}D</td>
                <td class="fn-opt-cell"><code>{fn.knownOptimum}</code></td>
                <td class="fn-notes-cell">{fn.notes || "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Bottom CTA & Cross Links -->
  <section class="bottom-cta-section">
    <div class="container">
      <div class="cta-banner">
        <h2 class="cta-title">Explore the Full Swarm Intelligence Stack</h2>
        <p class="cta-desc">
          SwarmBench pairs directly with the 34 optimizers of HyperSwarm, the deterministic prompt-to-plan pipeline of SwarmDev, and the visual node-graph canvas of AutoML App.
        </p>
        <div class="cta-links-row">
          <a href="/products/hyperswarm" class="cta-card-link">
            <span class="cl-title">HyperSwarm Suite &rarr;</span>
            <span class="cl-desc">35 optimizers, Director ensembles &amp; Level Zero GPU kernels</span>
          </a>
          <a href="/products/swarmdev" class="cta-card-link">
            <span class="cl-title">SwarmDev Pipeline &rarr;</span>
            <span class="cl-desc">Deterministic prompt classification and graph reasoning</span>
          </a>
          <a href="/products/automlapp" class="cta-card-link">
            <span class="cl-title">AutoML App &rarr;</span>
            <span class="cl-desc">Windows node-graph canvas with 185+ pipeline nodes</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('fnSearchInput') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clearFnSearch') as HTMLButtonElement | null;
    const catPills = document.querySelectorAll<HTMLButtonElement>('.catalog-pills-bar .cat-pill');
    const rows = document.querySelectorAll<HTMLTableRowElement>('.fn-row');
    const counter = document.getElementById('catalogCounter');
    const copyCmdBtns = document.querySelectorAll<HTMLButtonElement>('.copy-cmd-btn');

    let activeCat = 'all';
    let searchQuery = '';

    function filterTable() {
      let visibleCount = 0;

      rows.forEach(row => {
        const cat = row.getAttribute('data-cat') || '';
        const search = row.getAttribute('data-search') || '';

        const matchesCat = (activeCat === 'all') || (cat === activeCat);
        const matchesSearch = (!searchQuery) || (search.includes(searchQuery));

        if (matchesCat && matchesSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (counter) {
        counter.innerHTML = `Showing <strong>${visibleCount}</strong> of ${rows.length} functions`;
      }
    }

    // Category pill filtering
    catPills.forEach(pill => {
      pill.addEventListener('click', () => {
        catPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeCat = pill.getAttribute('data-cat') || 'all';
        filterTable();
      });
    });

    // Search input filtering
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        if (clearBtn) {
          clearBtn.style.display = searchQuery ? 'block' : 'none';
        }
        filterTable();
      });
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.style.display = 'none';
        filterTable();
        searchInput.focus();
      });
    }

    // Copy command buttons
    copyCmdBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-clipboard') || '';
        if (text) {
          navigator.clipboard.writeText(text);
          btn.textContent = 'Copied!';
          setTimeout(() => btn.textContent = 'Copy', 2000);
        }
      });
    });
  });
</script>

<style>
  /* Common Layout & Container */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .product-top-bar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(4, 7, 18, 0.6);
    backdrop-filter: blur(8px);
    padding: 12px 0;
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: #38bdf8;
  }
  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.2);
  }
  .breadcrumb .curr {
    color: #f8fafc;
  }

  /* Hero Section */
  .product-hero {
    padding: 60px 0 40px;
    background: radial-gradient(circle at 50% 10%, rgba(56, 189, 248, 0.08) 0%, transparent 70%);
  }

  .hero-badge-row {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: 48px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #f8fafc;
    margin: 0 0 12px 0;
  }

  .hero-tagline {
    font-size: 22px;
    font-weight: 700;
    color: #38bdf8;
    margin: 0 0 16px 0;
    letter-spacing: -0.01em;
  }

  .hero-desc {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 900px;
    margin: 0 0 32px 0;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  /* Metrics Strip */
  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .metric-card {
    background: #080d1e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-size: 30px;
    font-weight: 900;
    font-family: var(--font-mono);
    color: #38bdf8;
    line-height: 1;
    margin-bottom: 6px;
  }

  .metric-label {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 4px;
  }

  .metric-detail {
    font-size: 11.5px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* 4 Pillars */
  .pillars-section {
    padding: 30px 0 50px;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .pillar-card {
