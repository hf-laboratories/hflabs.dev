---
// src/pages/products/queryaccel.astro
import Layout from '../../layouts/Layout.astro';

const architectureComponents = [
  {
    name: "QueryAccelService",
    type: "gRPC Microservice Backend",
    lang: "C# / .NET 10",
    color: "#38bdf8",
    icon: "⚡",
    desc: "Executes aggregates and vector operations through pluggable kernels: Poplar-backed IPU hardware kernels when present, pure SIMD C# CPU kernels otherwise. Selected via environment flag with zero code modifications."
  },
  {
    name: "PostgresIpuQueryAccel",
    type: "Native PostgreSQL FDW",
    lang: "C / C++ Native Extension",
    color: "#06b6d4",
    icon: "🐘",
    desc: "Foreign Data Wrapper intercepting queries at the PostgreSQL planner stage. Pushes down aggregates and predicates, streams data via Apache Arrow, and uses cost-based estimation to decide when IPU execution yields speedups."
  },
  {
    name: "SqlIpuBridgeMicroservice",
    type: "Inference gRPC Daemon",
    lang: "C++ / Poplar SDK",
    color: "#a855f7",
    icon: "🌉",
    desc: "Exposes raw IPU tensor compute and ONNX graph execution over gRPC. Handles device init, graph compilation, batch tensor execution, and graceful CPU simulation fallbacks."
  },
  {
    name: "SqlIpuBridgeClient.SqlServerClr",
    type: "SQL Server CLR Assembly",
    lang: "C# CLR / T-SQL Bridge",
    color: "#10b981",
    icon: "🗄️",
    desc: "Managed assembly enabling Microsoft SQL Server to invoke IPU acceleration directly from T-SQL stored procedures using a single EXEC statement with retry logic and up to 100MB payload streaming."
  }
];

const ipuOperations = [
  {
    category: "Relational Aggregations",
    color: "#38bdf8",
    ops: [
      { name: "COUNT / COUNT(DISTINCT)", desc: "Parallel bit-vector counting across 1,472 IPU SRAM tiles with zero memory contention." },
      { name: "SUM / AVG", desc: "SIMD FP32/FP16 reduction trees executing with deterministic accumulator precision." },
      { name: "MIN / MAX", desc: "Branchless reduction kernels over contiguous memory-mapped columnar chunks." }
    ]
  },
  {
    category: "Dense Vector Metrics",
    color: "#10b981",
    ops: [
      { name: "Cosine Similarity", desc: "1536-dim / 768-dim embedding search evaluated across millions of vectors in sub-millisecond windows." },
      { name: "Euclidean (L2) Distance", desc: "Hardware-accelerated squared difference and sqrt accumulation on IPU IPU vector engines." },
      { name: "Dot Product / Inner Product", desc: "High-throughput matrix-vector operations with dedicated SRAM tile caching." }
    ]
  },
  {
    category: "In-Database Model Inference",
    color: "#a855f7",
    ops: [
      { name: "ONNX Graph Execution", desc: "Compiled PopART ONNX models loaded directly into tile memory for zero-copy row scoring." },
      { name: "Embedding Generation", desc: "Transformer encoder forward passes invoked directly within SQL transaction boundaries." },
      { name: "Simulation Fallback", desc: "Guaranteed CPU execution path when IPU cards are offline or busy." }
    ]
  }
];

const productionFeatures = [
  {
    title: "Split Telemetry Profiling",
    icon: "⏱️",
    desc: "Kernel execution time and IPC/Arrow serialization time are reported separately, letting DBAs pinpoint whether IPU compute or marshaling dominates latency."
  },
  {
    title: "Mid-Request Cancellation",
    icon: "🛑",
    desc: "Client query cancellations immediately propagate through gRPC tokens to stop running Poplar engine sessions, preventing tile starvation."
  },
  {
    title: "Resilient CLR Transport",
    icon: "🛡️",
    desc: "SQL Server client includes automatic retry logic with exponential backoff and supports message payloads up to 100MB for large batch queries."
  },
  {
    title: "Guaranteed Graceful Degradation",
    icon: "🔄",
    desc: "No IPU? No Poplar driver? Network failure? The query executes seamlessly on the native PostgreSQL / SQL Server CPU engine without throwing."
  }
];
---

<Layout 
  title="QueryAccel — IPU Database Acceleration for PostgreSQL & SQL Server | HF Labs"
  description="Push SQL's heaviest operations onto IPU hardware, transparently. Offload aggregates, vector math, and ONNX inference to Graphcore IPUs without rewriting queries."
>
  <!-- Breadcrumb Bar -->
  <div class="product-top-bar">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/products">Products</a>
        <span class="sep">/</span>
        <span class="curr">QueryAccel</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="product-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="badge badge-cyan">DATABASE HARDWARE ACCELERATION</span>
        <span class="badge badge-emerald">POSTGRESQL FDW &bull; SQL SERVER CLR</span>
        <span class="badge badge-purple">GRAPHCORE IPU &bull; POPLAR SDK</span>
        <span class="badge badge-amber">TRANSPARENT CPU FALLBACK</span>
      </div>

      <div class="hero-layout">
        <div class="hero-main">
          <h1 class="hero-title">QueryAccel</h1>
          <p class="hero-tagline">
            Push SQL's heaviest operations onto IPU hardware, transparently.
          </p>
          <p class="hero-intro">
            <strong>QueryAccel</strong> lets PostgreSQL and Microsoft SQL Server offload aggregates, vector operations, and inference onto Graphcore IPU hardware, without changing how you write queries. A PostgreSQL foreign data wrapper intercepts eligible operations at the planner level. SQL Server reaches the same acceleration through a CLR stored procedure. Both fall back to native CPU execution automatically when it's faster or when no IPU is present, so QueryAccel never makes a query slower than the engine's own plan would.
          </p>

          <div class="hero-actions">
            <a href="https://github.com/hf-laboratories" target="_blank" rel="noopener noreferrer" class="btn-primary">
              <span>View on GitHub</span>
              <span class="btn-arrow">&rarr;</span>
            </a>
            <a href="/docs/query-accel-ipu" class="btn-secondary">
              <span>Read the Docs</span>
            </a>
            <a href="/products/ht-graphrag#licensing" class="btn-secondary">
              <span>Contact Us</span>
            </a>
          </div>
        </div>

        <div class="hero-specs-card">
          <div class="specs-header">
            <span class="specs-title">QueryAccel System Specs</span>
            <span class="specs-pill">Production Ready</span>
          </div>
          <div class="specs-list">
            <div class="spec-row">
              <span class="spec-label">Target Databases</span>
              <span class="spec-value highlight-cyan">PostgreSQL (15–17) &bull; MS SQL Server</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Hardware Acceleration</span>
              <span class="spec-value">Graphcore Colossus MK2 GC200 IPU</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Data Serialization</span>
              <span class="spec-value highlight-green">Apache Arrow &bull; gRPC Protobuf</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Offloaded Aggregates</span>
              <span class="spec-value">COUNT, SUM, AVG, MIN, MAX</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Vector Distances</span>
              <span class="spec-value">Cosine, L2 Euclidean, Dot Product</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Max Payload Size</span>
              <span class="spec-value">100 MB Streaming Batch Chunks</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">Fallback Guarantee</span>
              <span class="spec-value highlight-green">100% Graceful CPU Execution</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Fits Together -->
  <section class="section-padding bg-darker">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-cyan">ARCHITECTURE</span>
        <h2 class="section-title">How It Fits Together</h2>
        <p class="section-subtitle">
          From query interception in PostgreSQL and SQL Server to gRPC streaming and Poplar IPU tile kernel execution.
        </p>
      </div>

      <div class="components-grid">
        {architectureComponents.map((comp) => (
          <div class="comp-card" style={`--comp-color: ${comp.color};`}>
            <div class="comp-header">
              <div class="comp-icon" style={`background:${comp.color}15; border-color:${comp.color}40;`}>
                <span>{comp.icon}</span>
              </div>
              <div>
                <span class="comp-lang" style={`color:${comp.color}; border:1px solid ${comp.color}35;`}>{comp.lang}</span>
                <h3 class="comp-name">{comp.name}</h3>
                <span class="comp-type">{comp.type}</span>
              </div>
            </div>
            <p class="comp-desc">{comp.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What Runs on the IPU -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-emerald">COMPUTE CATALOG</span>
        <h2 class="section-title">What Runs on the IPU</h2>
        <p class="section-subtitle">
          Hardware kernels mapped to thousands of in-processor SRAM tiles for massive memory bandwidth and zero cache contention.
        </p>
      </div>

      <div class="operations-grid">
        {ipuOperations.map((group) => (
          <div class="group-card" style={`--grp-color: ${group.color};`}>
            <div class="group-header" style={`border-bottom: 2px solid ${group.color};`}>
              <h3 class="group-title" style={`color:${group.color};`}>{group.category}</h3>
            </div>
            <div class="ops-list">
              {group.ops.map((op) => (
                <div class="op-item">
                  <div class="op-name-row">
                    <span class="op-dot" style={`background:${group.color};`}></span>
                    <strong class="op-name">{op.name}</strong>
                  </div>
                  <p class="op-desc">{op.desc}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Production Ready Standards -->
  <section class="section-padding bg-darker">
    <div class="container">
      <div class="section-header">
        <span class="badge badge-purple">ENTERPRISE RESILIENCE</span>
        <h2 class="section-title">Built for Production Databases, Not a Research Harness</h2>
        <p class="section-subtitle">
          Engineered with strict safety invariants, granular timing telemetry, and bulletproof fallback guarantees.
        </p>
      </div>

      <div class="production-grid">
        {productionFeatures.map((feat) => (
          <div class="prod-feat-card">
            <div class="feat-icon-box">
              <span>{feat.icon}</span>
            </div>
            <h3 class="feat-title">{feat.title}</h3>
            <p class="feat-desc">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code Example Section -->
  <section class="section-padding">
    <div class="container">
      <div class="code-showcase-grid">
        <div class="code-card">
          <div class="code-header">
            <span class="code-tag">PostgreSQL Transparent Pushdown</span>
            <span class="code-pill">C/C++ FDW</span>
          </div>
          <pre class="code-block"><code><span style="color:#7dd3fc;">-- Transparently intercepted by PostgresIpuQueryAccel FDW</span>
<span style="color:#f472b6;">SELECT</span> 
  customer_segment,
  <span style="color:#38bdf8;">COUNT</span>(*),
  <span style="color:#38bdf8;">SUM</span>(transaction_amount),
  <span style="color:#38bdf8;">AVG</span>(risk_score)
<span style="color:#f472b6;">FROM</span> ipu_orders_fdw
<span style="color:#f472b6;">WHERE</span> order_date >= <span style="color:#a5b4fc;">'2026-01-01'</span>
<span style="color:#f472b6;">GROUP BY</span> customer_segment;

<span style="color:#64748b;">-- Cost-based planner dispatches to IPU tile reduction kernels</span>
<span style="color:#64748b;">-- Fallback to native CPU engine if serialization cost exceeds speedup</span></code></pre>
        </div>

        <div class="code-card">
          <div class="code-header">
            <span class="code-tag">SQL Server CLR Bridge</span>
            <span class="code-pill">T-SQL Stored Procedure</span>
          </div>
          <pre class="code-block"><code><span style="color:#7dd3fc;">-- Invoke IPU model scoring directly from T-SQL stored proc</span>
<span style="color:#f472b6;">DECLARE</span> @ReturnCode <span style="color:#38bdf8;">int</span>;
<span style="color:#f472b6;">DECLARE</span> @Scores <span style="color:#38bdf8;">nvarchar(max)</span>;

<span style="color:#f472b6;">EXEC</span> @ReturnCode = dbo.sp_IpuRunInference
  @ModelName = <span style="color:#a5b4fc;">N'FraudDetection_v3'</span>,
  @BatchDataJson = @InputFeatures,
  @TimeoutMs = <span style="color:#a5b4fc;">250</span>,
  @OutputScores = @Scores <span style="color:#f472b6;">OUTPUT</span>;

<span style="color:#64748b;">-- Automatic retry with exponential backoff and 100MB payload support</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Why This Exists Banner -->
  <section class="why-section">
    <div class="container">
      <div class="why-card">
        <span class="badge badge-cyan">DATABASE &amp; HARDWARE CONVERGENCE</span>
        <h2 class="why-title">Why This Exists</h2>
        <p class="why-quote">
          &ldquo;Specialized accelerator hardware is usually locked behind bespoke pipelines that only machine-learning code can reach. QueryAccel puts that hardware behind the interface database engines already speak, SQL, so accelerating an aggregate or a similarity search doesn't require rewriting the application around a new API.&rdquo;
        </p>
        <div class="why-meta">
          <strong>HF Labs Systems Foundation</strong> &bull; Zero-Friction Database Acceleration
        </div>
      </div>
    </div>
  </section>

  <!-- Global CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box">
        <h2 class="cta-title">Accelerate Your SQL Workloads with Graphcore IPUs</h2>
        <p class="cta-desc">
          Drop QueryAccel into existing PostgreSQL and SQL Server instances without rewriting application queries. Explore the repository or read the manual.
        </p>
        <div class="cta-buttons">
          <a href="https://github.com/hf-laboratories" target="_blank" rel="noopener noreferrer" class="btn-primary">
            View on GitHub &rarr;
          </a>
          <a href="/docs/query-accel-ipu" class="btn-secondary">
            Read the Docs
          </a>
          <a href="/products/ht-graphrag#licensing" class="btn-secondary">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-top-bar {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid var(--border-color);
    padding: 12px 0;
    font-size: 13px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--accent-blue);
  }

  .breadcrumb .sep {
    color: var(--border-color);
  }

  .breadcrumb .curr {
    color: var(--text-primary);
  }

  /* Hero */
  .product-hero {
    padding: 60px 0 45px;
    position: relative;
  }

  .hero-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .badge-purple {
    background: rgba(129, 140, 248, 0.12);
    color: var(--accent-purple);
    border: 1px solid rgba(129, 140, 248, 0.3);
  }

  .badge-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .badge-emerald {
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent-emerald);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .badge-amber {
    background: rgba(245, 158, 11, 0.12);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .hero-layout {
      grid-template-columns: 1fr;
    }
  }

  .hero-title {
    font-size: 42px;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #f8fafc;
    margin-bottom: 14px;
  }

  .hero-tagline {
    font-size: 20px;
    font-weight: 600;
    color: var(--accent-blue);
    line-height: 1.4;
    margin-bottom: 18px;
  }

  .hero-intro {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .hero-intro strong {
    color: #f1f5f9;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Specs Card */
  .hero-specs-card {
    background: #080c18;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .specs-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .specs-title {
    font-size: 14px;
    font-weight: 700;
    color: #f1f5f9;
  }

  .specs-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .specs-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .spec-label {
    color: var(--text-secondary);
  }

  .spec-value {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: #e2e8f0;
    text-align: right;
  }

  .highlight-green {
    color: var(--accent-emerald) !important;
    font-weight: 700;
  }

  .highlight-cyan {
    color: var(--accent-blue) !important;
    font-weight: 700;
  }

  /* Section Padding */
  .section-padding {
    padding: 70px 0;
  }

  .bg-darker {
    background: #050812;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 10px;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Components Grid */
  .components-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
  }

  @media (max-width: 768px) {
    .components-grid {
      grid-template-columns: 1fr;
    }
  }

  .comp-card {
    background: #090e1c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .comp-card:hover {
    border-color: var(--comp-color);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .comp-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .comp-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 20px;
  }

  .comp-lang {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    margin-bottom: 4px;
  }

  .comp-name {
    font-size: 17px;
    font-weight: 800;
    color: #f8fafc;
  }

  .comp-type {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    display: block;
  }

  .comp-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* Operations Grid */
  .operations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .group-card {
    background: #080c18;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .group-header {
    padding-bottom: 12px;
    margin-bottom: 18px;
  }

  .group-title {
    font-size: 18px;
    font-weight: 800;
  }

  .ops-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .op-item {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-md);
    padding: 12px;
  }

  .op-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .op-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .op-name {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #f1f5f9;
  }

  .op-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  /* Production Grid */
  .production-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .prod-feat-card {
    background: #090e1c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 24px;
  }

  .feat-icon-box {
    font-size: 26px;
    margin-bottom: 12px;
  }

  .feat-title {
    font-size: 16px;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 8px;
  }

  .feat-desc {
    font-size: 12.5px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Code Showcase Grid */
  .code-showcase-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 900px) {
    .code-showcase-grid {
