---
import Layout from '../../layouts/Layout.astro';

const flow = [
  { name: 'Classify', color: '#38bdf8', desc: 'Classify the request and select a workflow family using the configured routing services.' },
  { name: 'Build context', color: '#818cf8', desc: 'Build a knowledge graph for the turn and identify candidate work items and relevant tools.' },
  { name: 'Plan actions', color: '#34d399', desc: 'Apply the action policy to the request; a blocked plan can stop before worklist execution.' },
  { name: 'Run work items', color: '#f59e0b', desc: 'Execute through the configured adapter and record outcomes. A deterministic fallback can return simulated success.' },
  { name: 'Return results', color: '#ec4899', desc: 'Construct a response graph and return the routing decision, action plan, work items, execution result, and final state.' }
];

const components = [
  { icon: '🧭', title: 'Turn engine', color: '#38bdf8', desc: 'Classifies requests, selects workflow families, builds graph context, applies an action policy, executes a worklist, and assembles a response. Deterministic components do not make external tools or models deterministic.' },
  { icon: '🔌', title: 'Host & protocol surfaces', color: '#818cf8', desc: 'The Host exposes discovery, health, MCP, A2A, and inquiry routes. Client-facing MCP tools include scoped changes, documentation grounding, and configured repository analysis.' },
  { icon: '🗂️', title: 'Director & routing', color: '#34d399', desc: 'The Director decomposes goals into dependency-aware work, routes tasks to configured targets, and records run events. Its default A2A route currently has a Host compatibility gap described below.' },
  { icon: '🔎', title: 'Repository analysis', color: '#f59e0b', desc: 'Roslyn-backed analysis, repository evidence, code-fix utilities, and documentation-grounding workflows support inspection and review of a selected codebase.' },
  { icon: '📝', title: 'Scoped changes', color: '#ec4899', desc: 'Sessions collect focused files, rules, snapshots, and proposals. Export prepares a reviewable result; complete can apply a proposal through changeset checks and configured validation.' },
  { icon: '🧪', title: 'Scientific inquiry', color: '#10b981', desc: 'Inquiry components plan claims and hypotheses, acquire configured evidence, run bounded experiments, reconcile observations, and report decisions. Quality depends on the sources, execution, and evaluation used.' },
  { icon: '🕸️', title: 'Optional graph layers', color: '#a78bfa', desc: 'Opt-in kGNN message passing and coherent wavescan add candidate nodes to a cutout. They are separately registered and do not replace the default resolver or establish retrieval quality.' },
  { icon: '🤝', title: 'Model & GraphRAG integration', color: '#06b6d4', desc: 'Optional model escalation and GraphRAG evidence integrations depend on providers, configuration, and reachable services. Unavailable evidence is not a completed verification.' },
  { icon: '📋', title: 'Events & diagnostics', color: '#f472b6', desc: 'Typed outcomes, execution traces, and Director events help inspect work. The available record and persistence depend on the component and deployment configuration.' }
];
---

<Layout title="SwarmDev • Coding and Research Orchestration | HF Labs" description="Explore SwarmDev's turn engine, Host, Director, scoped-change workflows and inquiry components in active development.">
  <div class="product-top-bar">
    <div class="container"><div class="breadcrumb"><a href="/">Overview</a><span class="sep">/</span><a href="/products">Products</a><span class="sep">/</span><span class="curr">SwarmDev</span></div></div>
  </div>

  <section class="product-hero">
    <div class="container">
      <div class="hero-badge-row"><span class="badge badge-cyan">Coding &amp; Research</span><span class="badge badge-emerald">Inspectable Workflows</span><span class="badge badge-purple">IPUServices</span><span class="badge badge-amber">Private · In Development</span></div>
      <h1 class="hero-title">SwarmDev</h1>
      <p class="hero-lead">A control plane for inspectable coding and research workflows.</p>
      <p class="hero-subhead">SwarmDev brings together a turn engine, protocol host, goal director, repository analysis, scoped changes, and scientific inquiry. Its components are under active development and have different levels of integration and validation.</p>
      <div class="hero-actions">
        <a href="#how-it-works" class="btn-primary" style="padding:12px 24px; font-size:14px;">Explore the workflow</a>
        <a href="#capabilities" class="btn-secondary" style="padding:12px 24px; font-size:14px;">Major components</a>
        <a href="#status" class="btn-secondary" style="padding:12px 24px; font-size:14px;">Status and boundaries</a>
        <a href="/docs/swarmdev-pipeline" class="btn-secondary" style="padding:12px 24px; font-size:14px;">Read the guide</a>
      </div>
    </div>
  </section>

  <section class="pipeline-flow-banner" id="how-it-works">
    <div class="container"><div class="flow-container">
      <div class="flow-header"><span class="flow-eyebrow">A TYPICAL TURN</span><span class="flow-status">Conceptual overview · configuration dependent</span></div>
      <div class="flow-track">{flow.map((stage) => <div class="flow-node" style={`--node-col: ${stage.color};`}><span class="node-title">{stage.name}</span></div>)}</div>
    </div></div>
  </section>

  <section class="intro-section">
    <div class="container"><div class="intro-card"><div class="intro-glow"></div><div class="intro-content">
      <div class="intro-tag"><span class="badge badge-amber">FROM REQUEST TO RESULT</span></div>
      <h2 class="intro-heading">A structured path through a task</h2>
      <p class="intro-text">The turn orchestrator carries the request through classification, graph context, action planning, worklist execution, and response construction. It returns a structured result so an operator can distinguish the plan from the execution outcome.</p>
      <p class="intro-text">Real activity depends on the configured tool adapter. The Host's default deterministic fallback can return a simulated success for unsupported work items; a successful fallback result is not proof that a build, test, or edit ran.</p>
    </div></div></div>
  </section>

  <section class="stages-section">
    <div class="container">
      <div class="section-header"><span class="badge badge-cyan">TURN ORCHESTRATION</span><h2 class="section-title">How a turn is assembled</h2><p class="section-subtitle">This illustrates the main turn path. Other entry points, including scoped changes and inquiry, use their own workflows.</p></div>
      <div class="stages-grid">{flow.map((stage) => <article class="stage-card" style={`--stage-accent: ${stage.color};`}><h3 class="stage-name">{stage.name}</h3><p class="stage-desc">{stage.desc}</p></article>)}</div>
    </div>
  </section>

  <section id="capabilities" class="capabilities-section">
    <div class="container">
      <div class="section-header"><span class="badge badge-purple">SYSTEM ARCHITECTURE</span><h2 class="section-title">Major components</h2><p class="section-subtitle">The product combines several services and libraries; registration or source presence alone does not establish end-to-end readiness.</p></div>
      <div class="capabilities-grid">{components.map((cap) => <article class="cap-card" style={`--cap-accent: ${cap.color};`}><div class="cap-header"><div class="cap-icon-box" style={`background: ${cap.color}15; border-color: ${cap.color}40;`}><span class="cap-icon">{cap.icon}</span></div><h3 class="cap-title">{cap.title}</h3></div><p class="cap-desc">{cap.desc}</p></article>)}</div>
    </div>
  </section>

  <section id="status" class="status-section">
    <div class="container"><div class="status-card">
      <div class="status-badge-row"><span class="badge badge-amber">DEVELOPMENT STATUS</span><span class="status-indicator-pill">Private · In Development</span></div>
      <h2 class="status-title">Integration and operating boundaries</h2>
      <p class="status-statement">SwarmDev is under active development. Production QA and deployment validation remain open; individual tests, available routes, and source components are not a release acceptance.</p>
      <div class="status-details-grid">
        <div class="status-box"><h4>Host and Director compatibility</h4><p>The default Director target sends A2A <code>message/send</code>, while the current Host A2A dispatcher accepts <code>tasks/get</code> only. The default route therefore needs integration work and verification.</p></div>
        <div class="status-box"><h4>Scoped changes and review</h4><p>Export leaves target files unchanged; completion can apply changes through the configured gate. Checks and rollback are workflow mechanisms, not a general operating-system sandbox or a guarantee of human approval.</p></div>
        <div class="status-box"><h4>Deployment configuration</h4><p>Providers, authentication, tool adapters, validation, and isolation must be configured and tested for the intended environment. The Director's unattended policy is disabled by default; other goal requests follow a separate path.</p></div>
      </div>
      <p class="status-statement">The inquiry and GraphRAG integrations require their own evidence of retrieval quality and successful end-to-end operation. Source-level capabilities and synthetic tests do not establish real-world answer quality.</p>
    </div></div>
  </section>

  <section class="bottom-cta-section"><div class="container"><div class="bottom-cta-box">
    <h2>Explore the surrounding ecosystem</h2><p>Read the component guide or explore the related GraphRAG and AutoMLApp projects.</p>
    <div class="cta-btns"><a href="/docs/swarmdev-pipeline" class="btn-primary" style="padding:12px 24px;">SwarmDev guide</a><a href="/products/ht-graphrag" class="btn-secondary" style="padding:12px 24px;">Hypertensor GraphRAG</a><a href="/products/automlapp" class="btn-secondary" style="padding:12px 24px;">AutoMLApp</a></div>
  </div></div></section>
</Layout>

<style>
  .product-top-bar {
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid var(--border-color);
    padding: 12px 0;
    font-size: 13px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
  }

  .breadcrumb a:hover {
    color: var(--accent-blue);
  }

  .breadcrumb .sep {
    color: var(--border-color);
  }

  .breadcrumb .curr {
    color: var(--text-primary);
  }

  /* Hero */
  .product-hero {
    padding: 70px 0 45px;
    position: relative;
  }

  .hero-badge-row {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .badge-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .badge-emerald {
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent-emerald);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .badge-amber {
    background: rgba(245, 158, 11, 0.12);
    color: var(--accent-amber);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .badge-purple {
    background: rgba(129, 140, 248, 0.12);
    color: var(--accent-purple);
    border: 1px solid rgba(129, 140, 248, 0.3);
  }

  .hero-title {
    font-size: 46px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #f8fafc;
    margin-bottom: 14px;
    line-height: 1.1;
  }

  .hero-lead {
    font-size: 20px;
    font-weight: 600;
    color: #e2e8f0;
    line-height: 1.45;
    margin-bottom: 12px;
    max-width: 840px;
  }

  .hero-subhead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 800px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Pipeline Flow Visual */
  .pipeline-flow-banner {
    padding: 10px 0 50px;
  }

  .flow-container {
    background: #060911;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
  }

  .flow-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 12px;
  }

  .flow-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    color: var(--accent-blue);
    letter-spacing: 0.06em;
  }

  .flow-status {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .flow-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow-x: auto;
    padding: 8px 0;
    gap: 8px;
  }

  .flow-node-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .flow-node {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid var(--border-color);
    border-top: 2px solid var(--node-col, #38bdf8);
    border-radius: var(--radius-md);
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
  }

  .flow-node:hover {
    border-color: var(--node-col);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  }

  .node-idx {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--node-col);
    font-weight: 800;
  }

  .node-icon {
    font-size: 16px;
  }

  .node-title {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: #f1f5f9;
  }

  .flow-connector {
    color: var(--text-muted);
    font-size: 16px;
    font-weight: 700;
  }

  /* Intro Section */
  .intro-section {
    padding: 20px 0 60px;
  }

  .intro-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 40px;
    position: relative;
    overflow: hidden;
  }

  .intro-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .intro-content {
    position: relative;
    z-index: 1;
  }

  .intro-tag {
    margin-bottom: 16px;
  }

  .intro-heading {
    font-size: 26px;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 16px;
  }

  .intro-text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 16px;
    max-width: 900px;
  }

  .intro-text strong {
    color: #f1f5f9;
  }

  .intro-callout-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 28px;
  }

  @media (max-width: 850px) {
    .intro-callout-grid {
      grid-template-columns: 1fr;
    }
  }

  .callout-pill {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .callout-icon {
    font-size: 22px;
    flex-shrink: 0;
  }

  .callout-pill strong {
    font-size: 13.5px;
    color: #f1f5f9;
    display: block;
    margin-bottom: 4px;
  }

  .callout-pill p {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Stages Grid */
  .stages-section {
    padding: 60px 0 70px;
    background: #060911;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 48px;
  }

  .section-title {
    font-size: 32px;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 10px;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .stages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 1000px) {
    .stages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .stages-grid {
      grid-template-columns: 1fr;
    }
  }

  .stage-card {
    background: #0a0f1d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.25s ease;
    position: relative;
  }

  .stage-card:hover {
    border-color: var(--stage-accent);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.6);
  }

  .stage-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .stage-num-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .stage-icon {
    font-size: 20px;
  }

  .stage-name {
    font-size: 20px;
    font-weight: 800;
    color: #f8fafc;
  }

  .stage-tagline {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--stage-accent);
    font-weight: 600;
    margin-top: -4px;
    margin-bottom: 4px;
  }

  .stage-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    flex-grow: 1;
  }

  .stage-footer {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .artifact-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .artifact-code {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #bae6fd;
    background: rgba(0, 0, 0, 0.4);
    padding: 4px 8px;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: inline-block;
  }

  /* Capabilities */
  .capabilities-section {
    padding: 70px 0;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  @media (max-width: 1000px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
    }
  }

  .cap-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: all 0.25s ease;
  }

  .cap-card:hover {
    border-color: var(--cap-accent);
    transform: translateY(-2px);
  }

  .cap-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cap-icon-box {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .cap-title {
    font-size: 16px;
    font-weight: 700;
    color: #f1f5f9;
  }

  .cap-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Status Section */
  .status-section {
    padding: 20px 0 70px;
  }

  .status-card {
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.9) 0%, rgba(7, 10, 19, 0.95) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 40px;
  }

  .status-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .status-indicator-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-emerald);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 3px 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .status-title {
    font-size: 26px;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 14px;
  }

  .status-statement {
    font-size: 16px;
    color: #e2e8f0;
    line-height: 1.6;
    margin-bottom: 28px;
    max-width: 820px;
  }

  .status-statement strong {
    color: #38bdf8;
  }

  .status-details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 32px;
  }

  @media (max-width: 850px) {
    .status-details-grid {
      grid-template-columns: 1fr;
    }
  }

  .status-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 18px;
  }

  .status-box h4 {
    font-size: 13.5px;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 6px;
  }

  .status-box p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .status-box code {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 1px 4px;
    border-radius: 3px;
  }

  /* Code Block */
  .code-preview-block {
    background: #050811;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .code-header {
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .code-title {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: #94a3b8;
  }

  .code-lang {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--accent-blue);
  }

  .code-content {
    padding: 16px 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    color: #e2e8f0;
    overflow-x: auto;
  }

